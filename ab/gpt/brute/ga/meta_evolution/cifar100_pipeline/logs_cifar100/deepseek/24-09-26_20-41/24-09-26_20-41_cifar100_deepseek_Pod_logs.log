def combine_genes(self, gene_name, parent1_value, parent2_value, crossover_point, gene_index, total_genes):
    # Strategy to maintain genetic diversity
    if gene_index < crossover_point:
        # Apply a more sophisticated inversion mutation on parent1's value
        if random.random() < 0.1:
            inverted_value = parent1_value[::-1]
            return inverted_value
        else:
            return parent1_value
    else:
        # Apply a more sophisticated inversion mutation on parent2's value
        if random.random() < 0.1:
            inverted_value = parent2_value[::-1]
            return inverted_value
        else:
            return parent2_value

    # Additional strategy to introduce novelty
    if random.random() < 0.05:
        # Choose a random valid value from the search space for the current gene
        possible_values = self.search_space[gene_name]
        return random.choice(possible_values)

    # Combine parent values with a higher probability
    if random.random() < 0.7:
        return parent1_value
    else:
        return parent2_value
