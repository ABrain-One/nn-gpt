        elif key == 'optimizer_type':
            # Force exploration of optimizer types
            if random.random() < 0.5:
                value = random.choice(['SGD', 'AdamW', 'RMSprop'])
            else:
                value = random.choice(['SGD', 'AdamW', 'RMSprop'])
        else:
            value = random.choice(values)
        chromosome[key] = value
    return chromosome
