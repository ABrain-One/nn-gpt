    def combine_genes(self, gene_name, parent1_value, parent2_value, crossover_point, gene_index, total_genes):
        if gene_index < crossover_point:
            return parent1_value
        else:
            return parent2_value

        # Introduce additional diversity by choosing a value at random between parents
        if random.random() < 0.2:
            return random.choice([parent1_value, parent2_value])

        # Alternatively, introduce more complex crossover strategies like arithmetic mean
        elif gene_name == 'lr' or gene_name == 'momentum':
            return (parent1_value + parent2_value) / 2

        # For other parameters, choose a random value from either parent
        else:
            return random.choice([parent1_value, parent2_value])
