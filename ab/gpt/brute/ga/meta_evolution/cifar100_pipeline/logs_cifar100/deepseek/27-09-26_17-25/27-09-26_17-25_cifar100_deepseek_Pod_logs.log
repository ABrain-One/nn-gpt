def mutate_gene(self, gene_name, current_value, possible_values):
    if possible_values:
        choices = list(set(possible_values) - set([current_value]))
        if choices:
            mutation_probability = self.mutation_rate * 2  # Increase mutation probability
            if random.random() < mutation_probability:
                if gene_name == 'n_columns' or gene_name == 'base_channels' or gene_name == 'n_blocks':
                    return random.choice(range(min(possible_values), max(possible_values) + 1))
                elif gene_name == 'dropout_prob' or gene_name == 'fc_dropout' or gene_name == 'lr' or gene_name == 'momentum':
                    return round(random.uniform(min(possible_values), max(possible_values)), 4)
                elif gene_name == 'kernel_size' or gene_name == 'optimizer_type' or gene_name == 'activation' or gene_name == 'pooling_type' or gene_name == 'conv_type' or gene_name == 'norm_type':
                    return random.choice(list(set(possible_values) - set([current_value])))
    return current_value
