```python
def combine_genes(self, gene_name, parent1_value, parent2_value, crossover_point, gene_index, total_genes):
    if gene_index < crossover_point:
        return parent1_value
    else:
        if parent1_value == parent2_value:
            return parent1_value
        elif gene_name in ['activation', 'conv_type', 'norm_type']:
            choices = [parent1_value, parent2_value]
            if gene_name == 'activation':
                weights = [0.7, 0.3]
            elif gene_name == 'conv_type':
                weights = [0.6, 0.4]
            elif gene_name == 'norm_type':
                weights = [0.5, 0.5]
            choice = random.choices(choices, weights=weights, k=1)[0]
        else:
            choice = random.choices([parent1_value, parent2_value], weights=[0.8, 0.2], k=1)[0]
        return choice
