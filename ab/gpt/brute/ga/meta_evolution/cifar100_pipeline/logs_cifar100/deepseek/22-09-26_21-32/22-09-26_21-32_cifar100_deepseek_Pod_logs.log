    def _create_random_chromosome(self):
        chromosome = {}
        for key, values in self.search_space.items():
            if key == "activation":
                # Ensure different activation functions are used in different columns/blocks
                if key in ["conv_type", "norm_type"]:
                    unique_values = set()
                    while len(unique_values) < len(values):
                        unique_values.add(random.choice(values))
                    chromosome[key] = list(unique_values)
                else:
                    chromosome[key] = random.choice(values)
            elif key == "kernel_size" or key == "pooling_type":
                # Ensure different kernel sizes and pooling types are used in different blocks
                unique_values = set()
                while len(unique_values) < len(values):
                    unique_values.add(random.choice(values))
                chromosome[key] = list(unique_values)
            else:
                chromosome[key] = random.choice(values)
        return chromosome
