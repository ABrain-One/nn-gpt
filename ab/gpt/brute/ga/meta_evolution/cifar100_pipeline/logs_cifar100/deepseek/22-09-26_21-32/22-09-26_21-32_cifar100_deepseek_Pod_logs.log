    def combine_genes(self, gene_name, parent1_value, parent2_value, crossover_point, gene_index, total_genes):
        if gene_index < crossover_point:
            return parent1_value
        else:
            # Introduce variability by choosing between parents with higher probability
            if parent1_value == parent2_value:
                return parent1_value
            elif parent1_value in ['ReLU', 'GELU', 'LeakyReLU', 'SiLU']:
                if parent2_value in ['ReLU', 'GELU', 'LeakyReLU', 'SiLU']:
                    choice = random.choices([parent1_value, parent2_value], weights=[0.9, 0.1], k=1)[0]
                else:
                    choice = parent1_value
            else:
                if parent2_value in ['ReLU', 'GELU', 'LeakyReLU', 'SiLU']:
                    choice = parent2_value
                else:
                    choice = random.choices([parent1_value, parent2_value], weights=[0.8, 0.2], k=1)[0]
            return choice
