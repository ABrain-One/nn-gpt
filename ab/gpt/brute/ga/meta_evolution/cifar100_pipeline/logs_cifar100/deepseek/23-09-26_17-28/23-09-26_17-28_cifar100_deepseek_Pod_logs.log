    def combine_genes(self, gene_name, parent1_value, parent2_value, crossover_point, gene_index, total_genes):
        if gene_index < crossover_point:
            return parent1_value
        else:
            # Apply a mutation strategy to break local minima
            mutation_probability = self.mutation_rate * 2
            if random.random() < mutation_probability:
                return parent2_value
            else:
                return parent1_value

        # Additional strategy to maintain genetic diversity
        diversity_probability = self.mutation_rate * 0.5
        if random.random() < diversity_probability:
            possible_values = [v for v in self.search_space[gene_name] if v != parent1_value and v != parent2_value]
            if possible_values:
                return random.choice(possible_values)
        return parent1_value
