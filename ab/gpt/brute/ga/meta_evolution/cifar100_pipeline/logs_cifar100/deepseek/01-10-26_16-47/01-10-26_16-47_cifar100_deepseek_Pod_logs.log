    def mutate_gene(self, gene_name, current_value, possible_values):
        mutation_probability = self.mutation_rate * 3  # Increase mutation probability significantly
        if random.random() < mutation_probability:
            return random.choice(possible_values)
        
        # Introduce large jumps in architecture parameters
        if gene_name == 'n_columns':
            return random.choice([2, 3, 4, 5, 6])
        elif gene_name == 'base_channels':
            return random.choice([16, 32, 64, 128, 256])
        elif gene_name == 'n_blocks':
            return random.choice([2, 3, 4, 5, 6])
        
        # Introduce large changes in dropout probabilities
        elif gene_name == 'dropout_prob' or gene_name == 'fc_dropout':
            return random.choice([0.05, 0.1, 0.15, 0.2, 0.25, 0.3, 0.4, 0.5, 0.6, 0.7, 0.8, 0.9])
        
