    def combine_genes(self, gene_name, parent1_value, parent2_value, crossover_point, gene_index, total_genes):
        if gene_index < crossover_point:
            return parent1_value
        else:
            return parent2_value
        
        # Novel strategy to introduce more diversity
        if random.random() < 0.2:  # Introduce a small chance of choosing a value from the opposite parent
            if gene_index < crossover_point:
                return parent2_value
            else:
                return parent1_value
        
        # Novel strategy to increase exploration
        if random.random() < 0.1:  # Introduce a small chance of choosing a completely random value
            possible_values = [v for v in self.search_space[gene_name]]
            return random.choice(possible_values)
        
        # Novel strategy to ensure no premature convergence
        if random.random() < 0.1:  # Introduce a small chance of mutating a gene after crossover
            return self.mutate_gene(gene_name, parent1_value if gene_index < crossover_point else parent2_value, self.search_space[gene_name])
        
        return parent1_value if gene_index < crossover_point else parent2_value
