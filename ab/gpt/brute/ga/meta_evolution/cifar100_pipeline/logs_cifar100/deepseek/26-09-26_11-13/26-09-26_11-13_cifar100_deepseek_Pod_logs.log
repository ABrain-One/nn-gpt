def _create_random_chromosome(self):
    chromosome = {}
    for key, values in self.search_space.items():
        if key == "base_channels":
            # Force exploration of higher channel depths
            base_channels_choices = [values[-1]] + values[:-1]
        elif key == "kernel_size":
            # Force exploration of larger kernels
            kernel_size_choices = [values[-1]] + values[:-1]
        elif key == "momentum":
            # Force exploration of lower momentum values
            momentum_choices = [values[0]] + values[1:-1]
        elif key == "dropout_prob" or key == "fc_dropout":
            # Force exploration of higher dropout rates
            dropout_choices = [values[-1]] + values[:-1]
        else:
            # Standard random choice
            choices = values
        
        chromosome[key] = random.choice(choices)
    
    return chromosome
