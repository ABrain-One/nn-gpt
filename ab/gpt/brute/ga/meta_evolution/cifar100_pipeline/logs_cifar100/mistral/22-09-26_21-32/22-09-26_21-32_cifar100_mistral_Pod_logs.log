def mutate_gene(self, gene_name, current_value, possible_values):
    if possible_values:
        choices = list(set(possible_values) - set([current_value]))
        if choices:
            mutation_probability = self.mutation_rate * 3  # Increase mutation probability significantly
            if random.random() < mutation_probability:
                new_value = random.choice(choices)
                if isinstance(new_value, int) and isinstance(current_value, int):
                    # For integer values, introduce larger steps
                    step = max(1, abs(new_value - current_value) // 2)
                    while new_value == current_value:
                        if random.random() < 0.5:
                            new_value += step
                        else:
                            new_value -= step
                        new_value = max(min(new_value, max(possible_values)), min(possible_values))
                return new_value
    return current_value
