    def combine_genes(self, gene_name, parent1_value, parent2_value, crossover_point, gene_index, total_genes):
        if gene_index < crossover_point:
            return parent1_value
        else:
            return parent2_value

        # Additional strategies to maintain genetic diversity and avoid premature convergence
        if gene_name == 'architecture':
            # Introduce random mutations or modifications to the architecture
            mutation_probability = self.mutation_rate * 2
            if random.random() < mutation_probability:
                return self._mutate(parent1_value)
            else:
                return parent2_value
        elif gene_name == 'hyperparameters':
            # Combine hyperparameters in a way that avoids local minima
            alpha = random.uniform(0.5, 1.5)
            return alpha * parent1_value + (1 - alpha) * parent2_value
        elif gene_name == 'layers':
            # Introduce shuffling or swapping of layers
            if random.random() < 0.5:
                return parent1_value
            else:
                return parent2_value
        elif gene_name == 'activations':
            # Introduce random activation function swaps
            if random.random() < self.mutation_rate:
                return random.choice(list(set(self.search_space['activation']) - set([parent1_value])))
            else:
                return parent2_value
        elif gene_name == 'optimizer':
            # Introduce random optimizer swaps
            if random.random() < self.mutation_rate:
                return random.choice(list(set(self.search_space['optimizer_type']) - set([parent1_value])))
            else:
                return parent2_value
