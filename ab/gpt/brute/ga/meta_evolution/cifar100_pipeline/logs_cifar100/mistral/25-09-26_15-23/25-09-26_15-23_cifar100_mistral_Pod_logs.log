        elif key == 'n_columns' or key == 'n_blocks':
            chromosome[key] = random.choice([2, 3])
        elif key == 'base_channels':
            chromosome[key] = random.choice([16, 32, 64])
        elif key == 'dropout_prob' or key == 'fc_dropout':
            chromosome[key] = random.choice([0.05, 0.1, 0.15, 0.2, 0.25, 0.3, 0.4, 0.5])
