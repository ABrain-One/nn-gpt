    def combine_genes(self, gene_name, parent1_value, parent2_value, crossover_point, gene_index, total_genes):
        if gene_index < crossover_point:
            return parent1_value
        else:
            return parent2_value

        # Strategy to maintain genetic diversity and avoid premature convergence
        if gene_name == "activation":
            possible_activations = ["ReLU", "GELU", "LeakyReLU", "SiLU"]
            if parent1_value == parent2_value:
                return random.choice(possible_activations)
            else:
                return parent1_value if random.random() < 0.5 else parent2_value

        if gene_name == "conv_type":
            possible_conv_types = ["Standard", "Depthwise"]
            if parent1_value == parent2_value:
                return random.choice(possible_conv_types)
            else:
                return parent1_value if random.random() < 0.5 else parent2_value

        if gene_name == "pooling_type":
            possible_pooling_types = ["Max", "Avg"]
            if parent1_value == parent2_value:
                return random.choice(possible_pooling_types)
            else:
                return parent1_value if random.random() < 0.5 else parent2_value

        if gene_name == "norm_type":
            possible_norm_types = ["BatchNorm", "InstanceNorm"]
            if parent1_value == parent2_value:
                return random.choice(possible_norm_types)
            else:
                return parent1_value if random.random() < 0.5 else parent2_value

        if gene_name == "optimizer_type":
            possible_optimizer_types = ["SGD", "AdamW", "RMSprop"]
            if parent1_value == parent2_value:
                return random.choice(possible_optimizer_types)
            else:
                return parent1_value if random.random() < 0.5 else parent2_value

        # Randomly choose between parents with some probability to ensure exploration
        if random.random() < 0.5:
            return parent1_value
        else:
            return parent2_value
