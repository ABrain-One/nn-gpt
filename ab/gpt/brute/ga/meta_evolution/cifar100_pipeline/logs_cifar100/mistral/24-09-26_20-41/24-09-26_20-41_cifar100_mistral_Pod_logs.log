def combine_genes(self, gene_name, parent1_value, parent2_value, crossover_point, gene_index, total_genes):
    # Introduce a custom crossover strategy to maintain genetic diversity
    if gene_index < crossover_point:
        # Simple crossover
        child_value = parent1_value
    else:
        child_value = parent2_value
    
    # Add noise to introduce diversity
    if random.random() < 0.1:  # Probability of introducing noise
        if isinstance(child_value, int):
            child_value += random.randint(-2, 2)  # Small integer adjustment
        elif isinstance(child_value, float):
            child_value += random.gauss(0, 0.1)  # Gaussian noise
    
    # Clamp values within valid range
    if isinstance(child_value, int):
        child_value = max(min(child_value, max(self.search_space[gene_name])), min(self.search_space[gene_name]))
    elif isinstance(child_value, float):
        child_value = max(min(child_value, max(self.search_space[gene_name])), min(self.search_space[gene_name]))
    
    return child_value
