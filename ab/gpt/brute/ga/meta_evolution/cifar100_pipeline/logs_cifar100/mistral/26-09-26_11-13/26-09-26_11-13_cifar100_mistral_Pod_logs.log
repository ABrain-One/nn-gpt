    def select_competitor(self, competitors):
        k = 3
        competitors = random.sample(self.population, min(k, len(self.population)))
        # Use tournament selection with a reasonable size to balance elitism and exploration
        selected = []
        while len(selected) < k:
            candidate = random.choice(competitors)
            if not selected or candidate['fitness'] > selected[-1]['fitness']:
                selected.append(candidate)
        return max(selected, key=lambda x: x['fitness'])
