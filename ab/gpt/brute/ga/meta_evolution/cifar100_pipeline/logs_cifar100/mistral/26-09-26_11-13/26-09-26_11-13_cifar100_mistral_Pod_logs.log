def mutate_gene(self, gene_name, current_value, possible_values):
    if possible_values:
        choices = list(set(possible_values) - set([current_value]))
        if choices:
            mutation_probability = self.mutation_rate * 2  # Increase mutation probability
            if random.random() < mutation_probability:
                # Aggressively explore the search space
                if isinstance(current_value, int) or isinstance(current_value, float):
                    alpha = random.uniform(0.5, 1.5)
                    new_value = current_value + alpha * (random.choice(choices) - current_value)
                    # Ensure the new value remains within the bounds of possible values
                    new_value = max(min(new_value, max(possible_values)), min(possible_values))
                    return new_value
                elif isinstance(current_value, str):
                    new_value = random.choice(choices)
                    # Introduce a mix-up of different types of operations
                    if gene_name == 'conv_type' and new_value != current_value:
                        if current_value == 'Standard':
                            return 'Depthwise'
                        else:
                            return 'Standard'
                    return new_value
                elif isinstance(current_value, list):
                    # Randomly add or remove elements
                    if random.random() < 0.5:
                        new_value = current_value + [random.choice(choices)]
                    else:
                        if current_value:
                            new_value = current_value[:random.randint(0, len(current_value)-1)]
                        else:
                            new_value = current_value
                    return new_value
    return current_value
