def combine_genes(self, gene_name, parent1_value, parent2_value, crossover_point, gene_index, total_genes):
    if gene_index < crossover_point:
        return parent1_value
    else:
        # Introduce more variance by allowing both parents' values with different probabilities
        if random.random() < 0.4:
            return parent1_value
        elif random.random() < 0.6:
            return parent2_value
        else:
            # Occasionally swap between parents' values to force exploration
            if gene_name in ['conv_type', 'pooling_type', 'norm_type']:
                if random.random() < 0.2:
                    return parent1_value
                else:
                    return parent2_value
            else:
                return random.choice([parent1_value, parent2_value])
