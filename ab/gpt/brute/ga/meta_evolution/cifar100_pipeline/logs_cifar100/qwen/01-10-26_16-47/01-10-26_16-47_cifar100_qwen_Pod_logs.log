def combine_genes(self, gene_name, parent1_value, parent2_value, crossover_point, gene_index, total_genes):
    # Use one-point crossover with high probability
    if random.random() < 0.9:
        crossover_point = random.randint(1, total_genes - 1)
        if gene_index <= crossover_point:
            return parent1_value
        else:
            return parent2_value
    else:
        # If no crossover occurs, use a combination of both parents with a twist
        combined_value = (parent1_value + parent2_value) / 2
        if combined_value in self.search_space[gene_name]:
            return combined_value
        else:
            # Choose between parent1 and parent2 randomly but favor the parent closer to the midpoint
            midpoint = (parent1_value + parent2_value) / 2
            if abs(parent1_value - midpoint) < abs(parent2_value - midpoint):
                return parent1_value
            else:
                return parent2_value
