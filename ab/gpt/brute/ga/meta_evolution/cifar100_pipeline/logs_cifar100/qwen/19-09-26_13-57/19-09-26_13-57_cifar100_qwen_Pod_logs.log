def combine_genes(self, gene_name, parent1_value, parent2_value, crossover_point, gene_index, total_genes):
    if gene_index < crossover_point:
        return parent1_value
    else:
        return parent2_value

    # Strategy to maintain genetic diversity
    if random.random() < 0.5:
        return parent1_value
    else:
        return parent2_value

    # Aggressive exploration strategy
    if random.random() < 0.1:
        possible_values = list(self.search_space[gene_name])
        possible_values.remove(parent1_value)
        possible_values.remove(parent2_value)
        if possible_values:
            return random.choice(possible_values)
        else:
            return parent1_value

    # Avoid premature convergence
    if random.random() < 0.2:
        return random.choice(list(self.search_space[gene_name]))

    return parent1_value
