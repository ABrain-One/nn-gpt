def combine_genes(self, gene_name, parent1_value, parent2_value, crossover_point, gene_index, total_genes):
    if gene_index < crossover_point:
        return parent1_value
    else:
        # Randomly choose from both parents to maintain diversity
        choice = random.choice([parent1_value, parent2_value])
        
        # Occasionally introduce a random value to avoid premature convergence
        mutation_probability = 0.1
        if random.random() < mutation_probability:
            possible_values = list(self.search_space[gene_name])
            possible_values.remove(choice)
            choice = random.choice(possible_values)
            
        return choice
