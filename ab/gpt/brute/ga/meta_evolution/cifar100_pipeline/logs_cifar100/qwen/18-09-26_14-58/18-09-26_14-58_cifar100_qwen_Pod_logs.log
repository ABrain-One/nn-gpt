    def combine_genes(self, gene_name, parent1_value, parent2_value, crossover_point, gene_index, total_genes):
        # Use a blend of both parents' values with a random weight to avoid premature convergence
        alpha = random.uniform(0.1, 0.9)
        beta = 1 - alpha
        
        if isinstance(parent1_value, int) or isinstance(parent1_value, float):
            return alpha * parent1_value + beta * parent2_value
        
        elif isinstance(parent1_value, str):
            if parent1_value == parent2_value:
                return parent1_value
            else:
                # Randomly choose between the two string values
                return random.choice([parent1_value, parent2_value])
        
        elif isinstance(parent1_value, bool):
            # Use bitwise OR to ensure diversity in boolean values
            return parent1_value | parent2_value
        
        else:
            raise ValueError(f"Unsupported data type for gene: {gene_name}")
```

This implementation introduces a blending mechanism for numerical values and a simple choice strategy for string values, while maintaining the original logic for other types. This approach helps in exploring the search space more aggressively and avoids premature convergence.
