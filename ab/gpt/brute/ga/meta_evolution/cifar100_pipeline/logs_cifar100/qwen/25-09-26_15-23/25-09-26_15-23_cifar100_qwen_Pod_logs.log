    def combine_genes(self, gene_name, parent1_value, parent2_value, crossover_point, gene_index, total_genes):
        # Force gene values to be different from parents with probability
        if random.random() < 0.25:
            choices = list(set(self.search_space[gene_name]) - set([parent1_value, parent2_value]))
            if choices:
                return random.choice(choices)

        # Aggressive exploration using random sampling
        if random.random() < 0.5:
            return random.choice(list(self.search_space[gene_name]))

        # Regular crossover
        if gene_index < crossover_point:
            return parent1_value
        else:
            return parent2_value
