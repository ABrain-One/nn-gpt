def _create_random_chromosome(self):
    chromosome = {}
    for key, values in self.search_space.items():
        if isinstance(values[0], int) or isinstance(values[0], float):
            # Sample a random value within a wider range
            min_val, max_val = min(values), max(values)
            spread = max_val - min_val
            scaled_min = min_val - spread * 0.5
            scaled_max = max_val + spread * 0.5
            chromosome[key] = random.uniform(scaled_min, scaled_max)
        else:
            chromosome[key] = random.choice(values)
    return chromosome
