    def _create_random_chromosome(self):
        chromosome = {}
        for key, values in self.search_space.items():
            if key == 'n_columns':
                chromosome[key] = random.choice([2, 3, 4])
            elif key == 'base_channels':
                chromosome[key] = random.choice([16, 32, 64])
            elif key == 'n_blocks':
                chromosome[key] = random.choice([2, 3, 4])
            elif key == 'dropout_prob':
                chromosome[key] = random.choice([0.05, 0.1, 0.15, 0.2, 0.25, 0.3, 0.4, 0.5])
            elif key == 'fc_dropout':
                chromosome[key] = random.choice([0.05, 0.1, 0.15, 0.2, 0.25, 0.3, 0.4, 0.5])
            elif key == 'lr':
                chromosome[key] = random.choice([0.01, 0.008, 0.006, 0.005, 0.004, 0.003, 0.002, 0.001])
            elif key == 'momentum':
                chromosome[key] = random.choice([0.75, 0.8, 0.85, 0.88, 0.9, 0.92, 0.95, 0.98])
            elif key == 'activation':
                chromosome[key] = random.choice(['ReLU', 'GELU', 'LeakyReLU', 'SiLU'])
            elif key == 'kernel_size':
                chromosome[key] = random.choice([1, 3, 5, 7])
            elif key == 'pooling_type':
                chromosome[key] = random.choice(['Max', 'Avg'])
            elif key == 'conv_type':
                chromosome[key] = random.choice(['Standard', 'Depthwise'])
            elif key == 'norm_type':
                chromosome[key] = random.choice(['BatchNorm', 'InstanceNorm'])
            elif key == 'optimizer_type':
                chromosome[key] = random.choice(['SGD', 'AdamW', 'RMSprop'])
        # Aggressive exploration
        for key in ['n_columns', 'base_channels', 'n_blocks']:
            if random.random() < 0.3:
                chromosome[key] += random.choice([-1, 1])
                chromosome[key] = max(2, min(chromosome[key], 4))
        for key in ['dropout_prob', 'fc_dropout']:
            if random.random() < 0.3:
                chromosome[key] += random.choice([-0.05, 0.05])
                chromosome[key] = max(0.05, min(chromosome[key], 0.5))
        for key in ['lr', 'momentum']:
            if random.random() < 0.3:
                chromosome[key] *= random.choice([0.9, 1.1])
                chromosome[key] = max(0.001, min(chromosome[key], 0.98))
        return chromosome
