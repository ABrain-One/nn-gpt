def combine_genes(self, gene_name, parent1_value, parent2_value, crossover_points, gene_index, total_genes):
    # Determine whether to use parent1's value, parent2's value, or a random choice
    if gene_index < crossover_points[0] or gene_index > crossover_points[1]:
        choice = random.choice([parent1_value, parent2_value])
    else:
        choice = random.choice([parent1_value, parent2_value])

    # Introduce randomness to increase diversity
    if random.random() < 0.1:
        if gene_name == 'n_columns' or gene_name == 'base_channels':
            choice += random.choice([-1, 1])
            choice = max(2, min(choice, 4))
        elif gene_name == 'n_blocks':
            choice += random.choice([-1, 1])
            choice = max(2, min(choice, 4))
        elif gene_name == 'dropout_prob':
            choice += random.choice([-0.05, 0.05])
            choice = max(0.05, min(choice, 0.5))
        elif gene_name == 'fc_dropout':
            choice += random.choice([-0.05, 0.05])
            choice = max(0.05, min(choice, 0.5))
        elif gene_name == 'lr':
            choice *= random.choice([0.9, 1.1])
            choice = max(0.001, min(choice, 0.98))
        elif gene_name == 'momentum':
            choice *= random.choice([0.9, 1.1])
            choice = max(0.75, min(choice, 0.98))

    return choice
