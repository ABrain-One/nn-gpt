def mutate_gene(self, gene_name, current_value, possible_values):
    mutation_probability = self.mutation_rate * 2  # Increase mutation probability
    if random.random() < mutation_probability:
        # Force exploration of new architectures
        if gene_name == 'n_columns' or gene_name == 'base_channels':
            choices = list(range(2, 5))  # Explore different number of columns and base channels
        elif gene_name == 'n_blocks':
            choices = list(range(2, 5))  # Explore different number of blocks
        elif gene_name == 'dropout_prob':
            choices = [0.05, 0.1, 0.15, 0.2, 0.25, 0.3, 0.4, 0.5]  # Explore different dropout probabilities
        elif gene_name == 'fc_dropout':
            choices = [0.05, 0.1, 0.15, 0.2, 0.25, 0.3, 0.4, 0.5]  # Explore different fully connected dropout probabilities
        elif gene_name == 'lr':
            choices = [0.01, 0.008, 0.006, 0.005, 0.004, 0.003, 0.002, 0.001]  # Explore different learning rates
        elif gene_name == 'momentum':
            choices = [0.75, 0.8, 0.85, 0.88, 0.9, 0.92, 0.95, 0.98]  # Explore different momentum values
        elif gene_name == 'activation':
            choices = ['ReLU', 'GELU', 'LeakyReLU', 'SiLU']  # Explore different activation functions
        elif gene_name == 'kernel_size':
            choices = [1, 3, 5, 7]  # Explore different kernel sizes
        elif gene_name == 'pooling_type':
            choices = ['Max', 'Avg']  # Explore different pooling types
        elif gene_name == 'conv_type':
            choices = ['Standard', 'Depthwise']  # Explore different convolution types
        elif gene_name == 'norm_type':
            choices = ['BatchNorm', 'InstanceNorm']  # Explore different normalization types
        elif gene_name == 'optimizer_type':
            choices = ['SGD', 'AdamW', 'RMSprop']  # Explore different optimizer types
        else:
            choices = possible_values

        return random.choice(choices)
    return current_value
