def combine_genes(self, gene_name, parent1_value, parent2_value, crossover_point, gene_index, total_genes):
    if gene_index < crossover_point:
        alpha = 0.5 + random.uniform(-0.2, 0.2)  # Adjust alpha to encourage diversity
        if random.random() < 0.5:
            return parent1_value * (1 + alpha * (parent2_value - parent1_value))
        else:
            return parent2_value * (1 + alpha * (parent1_value - parent2_value))
    else:
        beta = 0.5 + random.uniform(-0.2, 0.2)  # Adjust beta to encourage diversity
        if random.random() < 0.5:
            return parent1_value * (1 - beta * (parent1_value - parent2_value))
        else:
            return parent2_value * (1 - beta * (parent2_value - parent1_value))

child_chromo = {}
for gene in self.search_space.keys():
    if gene in ['n_columns', 'base_channels', 'n_blocks']:
        child_chromo[gene] = int(round(self.combine_genes(gene, parent1_chromo[gene], parent2_chromo[gene], crossover_point, self.search_space[gene].index(parent1_chromo[gene]), len(self.search_space[gene]))))
    elif gene in ['dropout_prob', 'fc_dropout', 'lr', 'momentum']:
        child_chromo[gene] = self.combine_genes(gene, parent1_chromo[gene], parent2_chromo[gene], crossover_point, self.search_space[gene].index(parent1_chromo[gene]), len(self.search_space[gene]))
    elif gene in ['activation', 'kernel_size', 'pooling_type', 'conv_type', 'norm_type', 'optimizer_type']:
        child_chromo[gene] = random.choice([parent1_chromo[gene], parent2_chromo[gene]])
    else:
        raise ValueError(f"Unknown gene {gene}")

return self._sanitize_chromosome(child_chromo)
