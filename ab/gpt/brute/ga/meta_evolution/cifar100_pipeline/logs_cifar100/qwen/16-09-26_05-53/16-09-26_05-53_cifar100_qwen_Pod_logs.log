    def select_competitor(self, competitors):
        k = 3
        competitors = random.sample(self.population, min(k, len(self.population)))
        # Tournament selection with a fixed number of competitors
        winner = max(competitors, key=lambda x: x['fitness'] if x['fitness'] is not None else -1)
        # Elitism: always keep at least one best individual
        if winner['fitness'] > -1:
            return winner
        else:
            # Exploration: randomly choose an individual if no good fitness found
            return random.choice(self.population)
