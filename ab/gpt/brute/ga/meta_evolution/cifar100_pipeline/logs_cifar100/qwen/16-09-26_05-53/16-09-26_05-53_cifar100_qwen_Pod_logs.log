def combine_genes(self, gene_name, parent1_value, parent2_value, crossover_point, gene_index, total_genes):
    beta = 0.5 + random.uniform(-0.2, 0.2)  # Adjust beta to encourage diversity
    u = random.uniform(0, 1)
    if u < 0.5:
        delta = abs(parent1_value - self.search_space_min(gene_name)) ** (1 / (beta + 1))
        value = parent1_value - delta
    else:
        delta = abs(parent2_value - self.search_space_max(gene_name)) ** (1 / (beta + 1))
        value = parent2_value + delta
    
    # Apply sigmoid to ensure the value stays within the valid range
    valid_range = self.search_space_max(gene_name) - self.search_space_min(gene_name)
    value = self.search_space_min(gene_name) + sigmoid(value) * valid_range
    
    # Sanitize the value to fit within the search space
    sanitized_value = self._sanitize_value(gene_name, value)
    
    return sanitized_value
```
