    def combine_genes(self, gene_name, parent1_value, parent2_value, crossover_point, gene_index, total_genes):
        beta = 0.5 + random.uniform(-0.2, 0.2)  # Adjust beta to encourage diversity
        if random.random() < 0.5:
            delta = abs(parent1_value - parent2_value) ** (1 / (beta + 1))
            value = parent1_value + delta
        else:
            delta = abs(parent1_value - parent2_value) ** (1 / (beta + 1))
            value = parent2_value - delta
        
        # Apply bounds checking and mutation to ensure the value remains valid
        possible_values = self.search_space[gene_name]
        if isinstance(possible_values[0], int) or isinstance(possible_values[0], float):
            value = self._coerce_gene_value(gene_name, value)
        
        # Introduce randomness to explore the search space
        exploration_probability = self.mutation_rate * 3
        if random.random() < exploration_probability:
            choices = list(set(possible_values) - {parent1_value, parent2_value})
            if choices:
                value = random.choice(choices)
        
        return value
