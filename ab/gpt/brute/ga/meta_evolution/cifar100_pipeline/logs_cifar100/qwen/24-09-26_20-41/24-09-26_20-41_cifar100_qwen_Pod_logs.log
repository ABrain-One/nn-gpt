    def _create_random_chromosome(self):
        chromosome = {}
        for key, values in self.search_space.items():
            if key == 'base_channels':
                # Randomly choose between base_channels options
                base_channels = random.choice(values)
                # Increase the number of channels significantly to encourage exploration
                chromosome[key] = base_channels * random.randint(1, 5)
            elif key == 'n_blocks':
                # Randomly choose between n_blocks options
                n_blocks = random.choice(values)
                # Increase the number of blocks exponentially to encourage exploration
                chromosome[key] = 2 ** random.randint(1, n_blocks)
            elif key == 'dropout_prob':
                # Randomly choose between dropout_prob options
                dropout_prob = random.choice(values)
                # Reduce dropout probability slightly to encourage more exploration
                chromosome[key] = dropout_prob * (1 - random.uniform(0, 0.1))
            elif key == 'fc_dropout':
                # Randomly choose between fc_dropout options
                fc_dropout = random.choice(values)
                # Reduce fully connected dropout probability slightly to encourage more exploration
                chromosome[key] = fc_dropout * (1 - random.uniform(0, 0.1))
            elif key == 'lr':
                # Randomly choose between lr options
                lr = random.choice(values)
                # Decrease learning rate significantly to encourage exploration
                chromosome[key] = lr / random.uniform(1, 5)
            elif key == 'momentum':
                # Randomly choose between momentum options
                momentum = random.choice(values)
                # Increase momentum to encourage exploration
                chromosome[key] += random.uniform(0, 0.1)
            elif key == 'activation':
                # Randomly choose between activation options
                chromosome[key] = random.choice(values)
                # Swap activations to encourage diversity
                if chromosome[key] == 'ReLU':
                    chromosome[key] = 'GELU'
                elif chromosome[key] == 'GELU':
                    chromosome[key] = 'ReLU'
            elif key == 'kernel_size':
                # Randomly choose between kernel_size options
                kernel_size = random.choice(values)
                # Increase kernel size to encourage exploration
                chromosome[key] += random.randint(0, 2)
            elif key == 'pooling_type':
                # Randomly choose between pooling_type options
                chromosome[key] = random.choice(values)
                # Swap pooling types to encourage diversity
                if chromosome[key] == 'Max':
                    chromosome[key] = 'Avg'
                elif chromosome[key] == 'Avg':
                    chromosome[key] = 'Max'
            elif key == 'conv_type':
                # Randomly choose between conv_type options
                chromosome[key] = random.choice(values)
                # Swap convolution types to encourage diversity
                if chromosome[key] == 'Standard':
                    chromosome[key] = 'Depthwise'
                elif chromosome[key] == 'Depthwise':
                    chromosome[key] = 'Standard'
            elif key == 'norm_type':
                # Randomly choose between norm_type options
                chromosome[key] = random.choice(values)
                # Swap normalization types to encourage diversity
                if chromosome[key] == 'BatchNorm':
                    chromosome[key] = 'InstanceNorm'
                elif chromosome[key] == 'InstanceNorm':
                    chromosome[key] = 'BatchNorm'
            elif key == 'optimizer_type':
                # Randomly choose between optimizer_type options
                chromosome[key] = random.choice(values)
                # Swap optimizer types to encourage diversity
                if chromosome[key] == 'SGD':
                    chromosome[key] = 'AdamW'
                elif chromosome[key] == 'AdamW':
                    chromosome[key] = 'RMSprop'
                elif chromosome[key] == 'RMSprop':
