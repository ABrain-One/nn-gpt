def mutate_gene(self, gene_name, current_value, possible_values):
    mutation_probability = self.mutation_rate * 3  # Increase mutation probability further
    if random.random() < mutation_probability:
        if isinstance(current_value, str):
            choices = list(set(possible_values) - set([current_value]))
            if choices:
                return random.choice(choices)
        elif isinstance(current_value, int):
            if current_value > 1:
                if random.random() < 0.5:
                    return current_value // 2
                else:
                    return current_value * 2
            else:
                return random.choice([x for x in possible_values if x != current_value])
        elif isinstance(current_value, float):
            factor = random.uniform(0.5, 2.0)
            return current_value * factor
        elif isinstance(current_value, bool):
            return not current_value
    return current_value
