def combine_genes(self, gene_name, parent1_value, parent2_value, crossover_point, gene_index, total_genes):
    if gene_index < crossover_point:
        # Perform traditional crossover
        return parent1_value
    else:
        # Perform alternative crossover strategy
        if gene_name == 'base_channels':
            # Interpolate between base channels of parents
            return int((parent1_value + parent2_value) / 2)
        elif gene_name == 'n_blocks':
            # Select the maximum number of blocks from either parent
            return max(parent1_value, parent2_value)
        elif gene_name == 'dropout_prob':
            # Average dropout probabilities
            return (parent1_value + parent2_value) / 2
        elif gene_name == 'fc_dropout':
            # Average fully connected dropout probabilities
            return (parent1_value + parent2_value) / 2
        elif gene_name == 'lr':
            # Geometric mean of learning rates
            return (parent1_value * parent2_value) ** 0.5
        elif gene_name == 'momentum':
            # Average momentum values
            return (parent1_value + parent2_value) / 2
        elif gene_name == 'activation':
            # Choose randomly between activations of both parents
            return random.choice([parent1_value, parent2_value])
        elif gene_name == 'kernel_size':
            # Select the larger kernel size
            return max(parent1_value, parent2_value)
        elif gene_name == 'pooling_type':
            # Randomly choose pooling type
            return random.choice([parent1_value, parent2_value])
        elif gene_name == 'conv_type':
            # Randomly choose convolution type
            return random.choice([parent1_value, parent2_value])
        elif gene_name == 'norm_type':
            # Randomly choose normalization type
            return random.choice([parent1_value, parent2_value])
        elif gene_name == 'optimizer_type':
            # Randomly choose optimizer type
            return random.choice([parent1_value, parent2_value])

        # Additional strategies to maintain genetic diversity and avoid premature convergence
        if gene_name == 'base_channels':
            return parent1_value * (1 + random.uniform(-0.2, 0.2))
        elif gene_name == 'n_blocks':
            return parent1_value + random.randint(-1, 1)
        elif gene_name == 'dropout_prob':
            return parent1_value + random.uniform(-0.05, 0.05)
        elif gene_name == 'fc_dropout':
            return parent1_value + random.uniform(-0.05, 0.05)
        elif gene_name == 'lr':
            return parent1_value * (1 + random.uniform(-0.1, 0.1))
        elif gene_name == 'momentum':
            return parent1_value + random.uniform(-0.02, 0.02)
        elif gene_name == 'kernel_size':
            return parent1_value + random.randint(-1, 1)
        elif gene_name == 'activation':
            return random.choice(['ReLU', 'GELU', 'LeakyReLU', 'SiLU'])
        elif gene_name == 'pooling_type':
            return random.choice(['Max', 'Avg'])
        elif gene_name == 'conv_type':
            return random.choice(['Standard', 'Depthwise'])
        elif gene_name == 'norm_type':
            return random.choice(['BatchNorm', 'InstanceNorm'])
        elif gene_name == 'optimizer_type':
            return random.choice(['SGD', 'AdamW', 'RMSprop'])

        return parent2_value
