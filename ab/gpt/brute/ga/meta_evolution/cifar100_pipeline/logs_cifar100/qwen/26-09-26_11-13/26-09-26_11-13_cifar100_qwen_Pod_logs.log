```python
def select_competitor(self, competitors):
    k = 3
    competitors = random.sample(self.population, min(k, len(self.population)))
    # Tournament selection with a bit of elitism
    selected_competitor = max(competitors, key=lambda x: x['fitness'] if x['fitness'] is not None else -1)
    
    # Check if the selected competitor has a fitness greater than the average fitness
    avg_fitness = sum(x['fitness'] for x in competitors if x['fitness'] is not None) / len(competitors)
    if selected_competitor['fitness'] > avg_fitness and random.random() < 0.2:
        return selected_competitor
    
    # If not, randomly select another competitor
    return random.choice(competitors)
```
