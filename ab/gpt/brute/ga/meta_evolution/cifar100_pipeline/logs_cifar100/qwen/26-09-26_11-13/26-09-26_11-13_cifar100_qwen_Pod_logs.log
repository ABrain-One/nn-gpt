    def combine_genes(self, gene_name, parent1_value, parent2_value, crossover_point, gene_index, total_genes):
        if gene_index < crossover_point:
            return parent1_value
        else:
            return parent2_value

        # Additional strategies to maintain genetic diversity and avoid premature convergence
        if gene_name == "base_channels":
            if parent1_value == 16:
                return parent2_value + 16
            elif parent1_value == 32:
                return parent2_value // 2
            elif parent1_value == 64:
                return parent2_value - 32
        elif gene_name == "kernel_size":
            if parent1_value == 1:
                return parent2_value + 2
            elif parent1_value == 3:
                return parent2_value // 2
            elif parent1_value == 5:
                return parent2_value - 2
            elif parent1_value == 7:
                return parent2_value + 2
        elif gene_name == "dropout_prob":
            if parent1_value == 0.05:
                return parent2_value + 0.1
            elif parent1_value == 0.1:
                return parent2_value / 2
            elif parent1_value == 0.15:
                return parent2_value - 0.05
            elif parent1_value == 0.2:
                return parent2_value + 0.1
            elif parent1_value == 0.25:
                return parent2_value / 2
            elif parent1_value == 0.3:
                return parent2_value - 0.05
            elif parent1_value == 0.4:
                return parent2_value + 0.1
            elif parent1_value == 0.5:
                return parent2_value / 2
        elif gene_name == "lr":
            if parent1_value == 0.01:
                return parent2_value + 0.001
            elif parent1_value == 0.008:
                return parent2_value / 2
            elif parent1_value == 0.006:
                return parent2_value - 0.002
            elif parent1_value == 0.005:
                return parent2_value + 0.001
            elif parent1_value == 0.004:
                return parent2_value / 2
            elif parent1_value == 0.003:
                return parent2_value - 0.001
            elif parent1_value == 0.002:
                return parent2_value + 0.001
            elif parent1_value == 0.001:
                return parent2_value / 2
        elif gene_name == "momentum":
            if parent1_value == 0.75:
                return parent2_value + 0.05
            elif parent1_value == 0.8:
                return parent2_value / 2
            elif parent1_value == 0.85:
                return parent2_value - 0.05
            elif parent1_value == 0.88:
                return parent2_value + 0.03
            elif parent1_value == 0.9:
                return parent2_value / 2
            elif parent1_value == 0.92:
                return parent2_value - 0.05
            elif parent1_value == 0.95:
                return parent2_value + 0.03
            elif parent1_value == 0.98:
                return parent2_value / 2
        elif gene_name == "activation":
            if parent1_value == "ReLU":
                return parent2_value.replace("ReLU", "GELU")
            elif parent1_value == "GELU":
                return parent2_value.replace("GELU", "LeakyReLU")
            elif parent1_value == "LeakyReLU":
                return parent2_value.replace("LeakyReLU", "SiLU")
            elif parent1_value == "SiLU":
                return parent2_value.replace("SiLU", "ReLU")
        elif gene_name == "pooling_type":
            if parent1_value == "Max":
                return parent2_value.replace("Max", "Avg")
            elif parent1_value == "Avg":
                return parent2_value.replace("Avg", "Max")
        elif gene_name == "conv_type":
            if parent1_value == "Standard":
                return parent2_value.replace("Standard", "Depthwise")
            elif parent1_value == "Depthwise":
                return parent2_value.replace("Depthwise", "Standard")
        elif gene_name == "norm_type":
            if parent1_value == "BatchNorm":
                return parent2_value.replace("BatchNorm", "InstanceNorm")
            elif parent1_value == "InstanceNorm":
                return parent2_value.replace("InstanceNorm", "BatchNorm")
        elif gene_name == "optimizer_type":
            if parent1_value == "SGD":
                return parent2_value.replace("SGD", "AdamW")
            elif parent1_value == "AdamW":
                return parent2_value.replace("AdamW", "RMSprop")
