def combine_genes(self, gene_name, parent1_value, parent2_value, crossover_point, gene_index, total_genes):
    # Introduce uniform crossover strategy with higher probability
    if random.random() < 0.7:
        if gene_index < crossover_point:
            return parent1_value
        else:
            return parent2_value
    else:
        # Introduce a different combination strategy
        if isinstance(parent1_value, int):
            # Crossover between two integers
            min_val = min(parent1_value, parent2_value)
            max_val = max(parent1_value, parent2_value)
            return random.randint(min_val, max_val)
        elif isinstance(parent1_value, float):
            # Blend between two floats
            alpha = random.uniform(0.2, 0.8)
            return parent1_value * alpha + parent2_value * (1 - alpha)
        elif isinstance(parent1_value, str):
            # Randomly choose from both values
            if random.random() < 0.5:
                return parent1_value
            else:
                return parent2_value
        elif isinstance(parent1_value, list):
            # Uniform crossover for lists
            combined_list = []
            for i in range(len(parent1_value)):
                if random.random() < 0.5:
                    combined_list.append(parent1_value[i])
                else:
                    combined_list.append(parent2_value[i])
            return combined_list
        else:
            # Default to simple crossover
            if gene_index < crossover_point:
                return parent1_value
            else:
                return parent2_value
