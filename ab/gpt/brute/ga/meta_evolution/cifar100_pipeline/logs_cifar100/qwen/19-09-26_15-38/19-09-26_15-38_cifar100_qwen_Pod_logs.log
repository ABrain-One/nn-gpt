    def combine_genes(self, gene_name, parent1_value, parent2_value, crossover_point, gene_index, total_genes):
        if gene_index < crossover_point:
            return parent1_value
        else:
            return parent2_value

        # Additional strategy to introduce novelty and diversity
        if gene_name == 'activation' or gene_name == 'conv_type':
            if random.random() < 0.1:
                return random.choice(list(set(self.search_space[gene_name]) - set([parent1_value, parent2_value])))
        
        if gene_name == 'dropout_prob' or gene_name == 'fc_dropout':
            if random.random() < 0.1:
                step = random.uniform(-0.05, 0.05)
                new_value = parent1_value + step
                if new_value < 0.05:
                    new_value = 0.05
                elif new_value > 0.5:
                    new_value = 0.5
                return new_value
        
        if gene_name == 'kernel_size':
            if random.random() < 0.1:
                choices = [k for k in self.search_space[gene_name] if k != parent1_value and k != parent2_value]
                if choices:
                    return random.choice(choices)
        
        if gene_name == 'n_columns' or gene_name == 'n_blocks' or gene_name == 'base_channels':
            if random.random() < 0.1:
                choices = [b for b in self.search_space[gene_name] if b != parent1_value and b != parent2_value]
                if choices:
                    return random.choice(choices)
        
        if gene_name == 'optimizer_type' or gene_name == 'norm_type' or gene_name == 'pooling_type':
            if random.random() < 0.1:
                choices = [o for o in self.search_space[gene_name] if o != parent1_value and o != parent2_value]
                if choices:
                    return random.choice(choices)
        
        return random.choice([parent1_value, parent2_value])
