    def combine_genes(self, gene_name, parent1_value, parent2_value, crossover_point, gene_index, total_genes):
        if gene_index < crossover_point:
            return parent1_value
        else:
            return parent2_value

        # Additional strategies to maintain genetic diversity and avoid premature convergence
        if gene_index < crossover_point:
            if gene_name in ["base_channels", "lr"]:
                # Add slight variation around parent1_value
                variation = random.uniform(-0.1, 0.1) * parent1_value
                return max(0, int(parent1_value + variation))
            elif gene_name in ["dropout_prob", "fc_dropout"]:
                # Invert dropout probability with low probability
                if random.random() < 0.1:
                    return 1 - parent1_value
                else:
                    return parent1_value
            elif gene_name == "activation":
                # Cycle through activation functions
                activations = ["ReLU", "GELU", "LeakyReLU", "SiLU"]
                current_index = activations.index(current_value)
                next_index = (current_index + 1) % len(activations)
                return activations[next_index]
            elif gene_name == "kernel_size":
                # Cycle through kernel sizes
                kernels = [1, 3, 5, 7]
                current_index = kernels.index(current_value)
                next_index = (current_index + 1) % len(kernels)
                return kernels[next_index]
            elif gene_name == "pooling_type":
                # Toggle between Max and Avg pooling
                return "Avg" if current_value == "Max" else "Max"
            elif gene_name == "conv_type":
                # Toggle between Standard and Depthwise convolutions
                return "Depthwise" if current_value == "Standard" else "Standard"
            elif gene_name == "norm_type":
                # Toggle between BatchNorm and InstanceNorm
                return "InstanceNorm" if current_value == "BatchNorm" else "BatchNorm"
            elif gene_name == "optimizer_type":
                # Cycle through optimizers
                optimizers = ["SGD", "AdamW", "RMSprop"]
                current_index = optimizers.index(current_value)
                next_index = (current_index + 1) % len(optimizers)
                return optimizers[next_index]

        return parent1_value
