    def combine_genes(self, gene_name, parent1_value, parent2_value, crossover_point, gene_index, total_genes):
        if gene_index < crossover_point:
            return parent1_value
        else:
            return parent2_value

        # Additional strategies to maintain genetic diversity and avoid premature convergence
        if gene_index < crossover_point:
            if gene_name in ["base_channels", "lr"]:
                # Add slight variation around parent1_value
                variation = random.uniform(-0.1, 0.1) * parent1_value
                return max(0, int(parent1_value + variation))
            elif gene_name in ["dropout_prob", "fc_dropout"]:
                # Invert dropout probability with low probability
                if random.random() < 0.1:
                    return 1 - parent2_value
            elif gene_name in ["activation"]:
                # Cycle through activation functions
                index = self.search_space["activation"].index(parent2_value)
                return self.search_space["activation"][(index + 1) % len(self.search_space["activation"])]
            elif gene_name in ["kernel_size"]:
                # Cycle through kernel sizes
                index = self.search_space["kernel_size"].index(parent2_value)
                return self.search_space["kernel_size"][(index + 1) % len(self.search_space["kernel_size"])]
            elif gene_name in ["pooling_type"]:
                # Cycle through pooling types
                index = self.search_space["pooling_type"].index(parent2_value)
                return self.search_space["pooling_type"][(index + 1) % len(self.search_space["pooling_type"])]
            elif gene_name in ["conv_type"]:
                # Cycle through convolution types
                index = self.search_space["conv_type"].index(parent2_value)
                return self.search_space["conv_type"][(index + 1) % len(self.search_space["conv_type"])]
            elif gene_name in ["norm_type"]:
                # Cycle through normalization types
                index = self.search_space["norm_type"].index(parent2_value)
                return self.search_space["norm_type"][(index + 1) % len(self.search_space["norm_type"])]
            elif gene_name in ["optimizer_type"]:
                # Cycle through optimizer types
                index = self.search_space["optimizer_type"].index(parent2_value)
                return self.search_space["optimizer_type"][(index + 1) % len(self.search_space["optimizer_type"])]

        return parent2_value
