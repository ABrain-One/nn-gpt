    def _create_random_chromosome(self):
        chromosome = {}
        for key, values in self.search_space.items():
            if isinstance(values[0], str):
                # For categorical variables, sample multiple values and choose one at random
                selected_values = random.sample(values, random.randint(1, len(values)))
                chromosome[key] = random.choice(selected_values)
            else:
                # For numerical variables, sample two values and choose one at random
                value_range = (min(values), max(values))
                selected_values = [random.uniform(*value_range) for _ in range(random.randint(1, len(values)))]
                chromosome[key] = random.choice(selected_values)
        return chromosome
