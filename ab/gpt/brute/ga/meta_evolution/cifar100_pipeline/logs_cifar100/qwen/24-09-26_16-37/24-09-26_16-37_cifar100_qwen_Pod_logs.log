    def mutate_gene(self, gene_name, current_value, possible_values):
        if possible_values:
            choices = list(set(possible_values) - set([current_value]))
            if choices:
                mutation_probability = self.mutation_rate * 3  # Increase mutation probability further
                if random.random() < mutation_probability:
                    if gene_name in ['base_channels', 'lr']:
                        return random.choice([x for x in possible_values if abs(x - current_value) > 10])
                    elif gene_name in ['dropout_prob', 'fc_dropout']:
                        return random.choice([x for x in possible_values if abs(x - current_value) > 0.1])
                    elif gene_name == 'momentum':
                        return random.choice([x for x in possible_values if abs(x**0.5 - current_value**0.5) > 0.05])
                    else:
                        return random.choice(choices)
        return current_value
