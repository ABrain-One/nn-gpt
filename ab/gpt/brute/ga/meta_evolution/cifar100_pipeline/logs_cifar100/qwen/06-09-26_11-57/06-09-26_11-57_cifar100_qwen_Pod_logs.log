def mutate_gene(self, gene_name, current_value, possible_values):
    mutation_strength = random.uniform(0.1, 2.0)  # Vary mutation strength
    mutation_probability = self.mutation_rate * mutation_strength
    if random.random() < mutation_probability:
        if isinstance(current_value, int) or isinstance(current_value, float):
            sign = random.choice([-1, 1])
            step = round(mutation_strength * abs(current_value))  # Step size varies with mutation strength
            proposed_value = current_value + sign * step
            if isinstance(current_value, int):
                proposed_value = max(min(proposed_value, max(possible_values)), min(possible_values))
            else:
                proposed_value = max(min(proposed_value, max(possible_values)), min(possible_values))
            return proposed_value
        elif isinstance(current_value, str):
            possible_values_set = set(possible_values)
            if len(possible_values_set) > 1:
                proposed_value = random.choice(list(possible_values_set - {current_value}))
                return proposed_value
    return current_value
