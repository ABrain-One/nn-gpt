def combine_genes(self, gene_name, parent1_value, parent2_value, crossover_point, gene_index, total_genes):
    child_chromo = {}

    if gene_name in ['n_columns', 'base_channels', 'n_blocks']:
        # Integer values should be combined using arithmetic crossover
        alpha = random.uniform(0.1, 0.9)
        beta = 1 - alpha
        child_value = max(int(alpha * parent1_value + beta * parent2_value), 2)
    elif gene_name in ['dropout_prob', 'fc_dropout', 'lr', 'momentum']:
        # Continuous values should be combined using arithmetic crossover
        alpha = random.uniform(0.1, 0.9)
        beta = 1 - alpha
        child_value = max(min(alpha * parent1_value + beta * parent2_value, 1), 0)
    elif gene_name == 'activation':
        # Cyclic crossover to avoid premature convergence
        options = list(self.search_space[gene_name])
        idx1 = options.index(parent1_value)
