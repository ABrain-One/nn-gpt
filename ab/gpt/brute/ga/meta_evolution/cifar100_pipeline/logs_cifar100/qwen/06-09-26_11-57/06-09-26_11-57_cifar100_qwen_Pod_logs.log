    def combine_genes(self, gene_name, parent1_value, parent2_value, crossover_point, gene_index, total_genes):
        if gene_index < crossover_point:
            # Simple arithmetic crossover for numeric parameters
            if isinstance(parent1_value, (int, float)):
                child_value = parent1_value + (parent2_value - parent1_value) * random.uniform(0.3, 0.7)
            elif isinstance(parent1_value, str):
                # Cyclically choose from available values
                options = list(self.search_space[gene_name])
                index = options.index(parent1_value)
                next_index = (index + 1) % len(options)
                child_value = options[next_index]
            else:
                raise ValueError(f"Unsupported type for gene {gene_name}: {type(parent1_value)}")
        else:
            # More complex crossover for non-numeric parameters
            if isinstance(parent1_value, str):
                options = list(self.search_space[gene_name])
                if parent1_value == parent2_value:
                    # Introduce slight variation if parents are the same
                    options.remove(parent1_value)
                    child_value = random.choice(options)
                else:
                    child_value = parent2_value
            else:
                raise ValueError(f"Unsupported type for gene {gene_name}: {type(parent1_value)}")
        
        # Apply bounds checks if applicable
        if gene_name in ['base_channels', 'n_columns', 'n_blocks']:
            child_value = max(min(child_value, max(self.search_space[gene_name])), min(self.search_space[gene_name]))
        
        return self._sanitize_chromosome({gene_name: child_value})
