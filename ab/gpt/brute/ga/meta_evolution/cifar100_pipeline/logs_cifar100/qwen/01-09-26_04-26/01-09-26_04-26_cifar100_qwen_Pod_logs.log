def combine_genes(self, gene_name, parent1_value, parent2_value, crossover_point, gene_index, total_genes):
    # One-point crossover
    if gene_index < crossover_point:
        return parent1_value
    else:
        return parent2_value

    # Two-point crossover
    point1 = random.randint(1, total_genes // 2)
    point2 = random.randint(point1 + 1, total_genes - 1)
    if gene_index < point1:
        return parent1_value
    elif point1 <= gene_index < point2:
        return parent2_value
    else:
        return parent1_value

    # Uniform crossover
    if random.random() < 0.5:
        return parent1_value
    else:
        return parent2_value
