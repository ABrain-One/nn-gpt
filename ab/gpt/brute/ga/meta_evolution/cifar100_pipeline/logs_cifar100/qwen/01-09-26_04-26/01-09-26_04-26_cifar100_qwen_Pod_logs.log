def combine_genes(self, gene_name, parent1_value, parent2_value, crossover_point, gene_index, total_genes):
    # Apply uniform crossover with a low probability
    if random.random() < 0.2:
        return parent1_value if random.random() < 0.5 else parent2_value
    
    # Apply one-point crossover
    if random.random() < 0.5:
        if gene_index < crossover_point:
            return parent1_value
        else:
            return parent2_value
    
    # Apply two-point crossover
    if random.random() < 0.3:
        point1 = random.randint(1, len(genes) // 2)
        point2 = random.randint(point1 + 1, len(genes) - 1)
        if gene_index < point1:
            return parent1_value
        elif point1 <= gene_index < point2:
            return parent2_value
        else:
            return parent1_value
    
    # Apply arithmetic crossover
    alpha = random.uniform(0.2, 0.8)
    if random.random() < 0.1:
        return alpha * parent1_value + (1 - alpha) * parent2_value
    
    # If none of the above, default to single-point crossover
    if gene_index < crossover_point:
        return parent1_value
    else:
        return parent2_value
