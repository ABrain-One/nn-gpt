### mutate_gene ###
    def mutate_gene(self, gene_name, current_value, possible_values):
        if possible_values:
            choices = list(set(possible_values) - set([current_value]))
            if choices:
                mutation_probability = self.mutation_rate * 3  # Further increase mutation probability
                if random.random() < mutation_probability:
                    if isinstance(current_value, int):
                        # Randomly choose between changing the value by ±2 or picking a completely different one
                        if random.random() < 0.5:
                            delta = random.choice([-2, 2])
                            if (current_value + delta) in choices:
                                return current_value + delta
                            else:
                                return random.choice(choices)
                        else:
                            return random.choice(choices)
                    else:
                        # For non-int values, randomly choose between changing the value or picking a completely different one
                        if random.random() < 0.5:
                            return random.choice(choices)
                        else:
                            return random.choice(choices)
        return current_value
