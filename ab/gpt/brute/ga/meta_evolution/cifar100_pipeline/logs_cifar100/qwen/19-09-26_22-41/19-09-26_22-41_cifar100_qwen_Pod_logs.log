def combine_genes(self, gene_name, parent1_value, parent2_value, crossover_point, gene_index, total_genes):
    # Strategy 1: Randomly choose between parents at each gene position
    if random.random() < 0.5:
        return parent1_value
    else:
        return parent2_value

    # Strategy 2: Use arithmetic mean to blend numeric values
    if isinstance(parent1_value, (int, float)):
        return (parent1_value + parent2_value) / 2

    # Strategy 3: Cycle through the search space options
    if isinstance(parent1_value, str):
        options = list(self.search_space[gene_name])
        index1 = options.index(parent1_value)
        index2 = options.index(parent2_value)
        combined_index = (index1 + index2) % len(options)
        return options[combined_index]
