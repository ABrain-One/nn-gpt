    def combine_genes(self, gene_name, parent1_value, parent2_value, crossover_point, gene_index, total_genes):
        # Hybrid Crossover: Uniform, Arithmetic, and Blend
        alpha = random.uniform(0.0, 1.0)
        beta = random.uniform(0.0, 1.0)
        
        # Adaptive Combination with Mutation
        adaptive_value = (1 - alpha) * parent1_value + alpha * parent2_value
        if isinstance(parent1_value, int):
            adaptive_value = round(adaptive_value)
        
        blend_value = (1 - beta) * parent1_value + beta * parent2_value
        if isinstance(parent1_value, int):
            blend_value = round(blend_value)
        
        # Uniform Crossover
        uniform_value = parent1_value if random.random() < 0.5 else parent2_value
        
        # Select the best value based on their performance
        candidates = [parent1_value, parent2_value, adaptive_value, blend_value, uniform_value]
        best_value = max(candidates, key=fitness_function)
        
        # Mutate the best value with a higher probability
        mutation_probability = self.mutation_rate * 2
        if random.random() < mutation_probability:
            possible_values = [v for v in self.search_space[gene_name] if v != best_value]
            if possible_values:
                new_value = random.choice(possible_values)
                while new_value == best_value:
                    new_value = random.choice(possible_values)
                return new_value
        
        return best_value
