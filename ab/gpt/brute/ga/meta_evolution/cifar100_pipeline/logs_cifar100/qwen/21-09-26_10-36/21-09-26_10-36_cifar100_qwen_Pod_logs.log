    def combine_genes(self, gene_name, parent1_value, parent2_value, crossover_point, gene_index, total_genes):
        # Single Point Crossover
        if random.random() < 0.5:
            if gene_index <= crossover_point:
                return parent1_value
            else:
                return parent2_value
        
        # Multi-Point Crossover
        points = sorted(random.sample(range(1, total_genes), random.randint(1, total_genes - 1)))
        child_value = []
        for i, value in enumerate(parent1_value):
            if i in points:
                child_value.append(parent2_value[i])
            else:
                child_value.append(value)
        
        # Adaptive Combination with Mutation
        alpha = random.uniform(0.0, 1.0)
        adaptive_value = (1 - alpha) * parent1_value + alpha * parent2_value
        if isinstance(parent1_value, int):
            adaptive_value = round(adaptive_value)
        
        mutation_probability = self.mutation_rate * 2
        if random.random() < mutation_probability:
            choices = list(set(self.search_space[gene_name]) - set([child_value[0]]))
            if choices:
                child_value[0] = random.choice(choices)
        
        return child_value
