def combine_genes(self, gene_name, parent1_value, parent2_value, crossover_point, gene_index, total_genes):
    # Introduce a single gene swap with another random gene
    if gene_index < crossover_point:
        child_value = parent1_value
    else:
        child_value = parent2_value

    # Apply a mutation on the selected gene to increase exploration
    mutation_probability = self.mutation_rate * 3
    if random.random() < mutation_probability:
        other_genes = [g for g in self.search_space.keys() if g != gene_name]
        chosen_gene = random.choice(other_genes)
        child_value = self.mutate_gene(chosen_gene, child_value, self.search_space[chosen_gene])

    # Sanitize the chromosome before returning
    return self._sanitize_chromosome({gene_name: child_value})
