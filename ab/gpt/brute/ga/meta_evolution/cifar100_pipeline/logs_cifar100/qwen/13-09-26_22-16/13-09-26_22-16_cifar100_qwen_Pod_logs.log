def combine_genes(self, gene_name, parent1_value, parent2_value, crossover_point, gene_index, total_genes):
    if gene_index < crossover_point:
        child_value = parent1_value
    else:
        child_value = parent2_value

    # Introduce a gene from a random competitor to increase diversity
    if random.random() < 0.8:
        competitor = self.select_competitor(self.population)
        competitor_value = competitor['chromo'][gene_name]
        if competitor_value != child_value:
            child_value = competitor_value

    # Apply a mutation to further explore the search space
    mutation_probability = self.mutation_rate * 5
    if random.random() < mutation_probability:
        possible_values = [v for v in self.search_space[gene_name] if v != child_value]
        if possible_values:
            child_value = random.choice(possible_values)

    # Add a shake move to further escape local minima
    shake_probability = self.mutation_rate * 3
    if random.random() < shake_probability:
        shake_factor = random.uniform(0.9, 1.1)
        if isinstance(child_value, float):
            child_value *= shake_factor
            child_value = max(0, min(child_value, max(self.search_space[gene_name])))

    child_chromo = {**parent1_chromo, **parent2_chromo}
    child_chromo[gene_name] = child_value

    return self._sanitize_chromosome(child_chromo)
