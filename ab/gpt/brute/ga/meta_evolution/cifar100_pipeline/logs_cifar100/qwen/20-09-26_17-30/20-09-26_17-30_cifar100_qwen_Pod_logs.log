    def mutate_gene(self, gene_name, current_value, possible_values):
        if possible_values:
            choices = list(set(possible_values) - set([current_value]))
            if choices:
                mutation_probability = self.mutation_rate * 4  # Increase mutation probability significantly
                if random.random() < mutation_probability:
                    # Randomly choose a different type of mutation
                    mutation_types = ['value', 'structure']
                    mutation_type = random.choice(mutation_types)
                    
                    if mutation_type == 'value':
                        # Mutate the value
                        return random.choice(choices)
                    elif mutation_type == 'structure':
                        # Mutate the structure
                        if gene_name == 'n_columns':
                            n_cols = random.choice([2, 3, 4])
                            return n_cols
                        elif gene_name == 'base_channels':
                            channels = random.choice([16, 32, 64])
                            return channels
                        elif gene_name == 'n_blocks':
                            blocks = random.choice([2, 3, 4])
                            return blocks
                        elif gene_name == 'dropout_prob':
                            dropout = random.choice([0.05, 0.1, 0.15, 0.2, 0.25, 0.3, 0.4, 0.5])
                            return dropout
                        elif gene_name == 'fc_dropout':
                            fc_dropout = random.choice([0.05, 0.1, 0.15, 0.2, 0.25, 0.3, 0.4, 0.5])
                            return fc_dropout
                        elif gene_name == 'lr':
                            lr = random.choice([0.01, 0.008, 0.006, 0.005, 0.004, 0.003, 0.002, 0.001])
                            return lr
                        elif gene_name == 'momentum':
                            momentum = random.choice([0.75, 0.8, 0.85, 0.88, 0.9, 0.92, 0.95, 0.98])
                            return momentum
                        elif gene_name == 'activation':
                            act = random.choice(['ReLU', 'GELU', 'LeakyReLU', 'SiLU'])
                            return act
                        elif gene_name == 'kernel_size':
                            kernel = random.choice([1, 3, 5, 7])
                            return kernel
                        elif gene_name == 'pooling_type':
                            pooling = random.choice(['Max', 'Avg'])
                            return pooling
                        elif gene_name == 'conv_type':
                            conv = random.choice(['Standard', 'Depthwise'])
                            return conv
                        elif gene_name == 'norm_type':
                            norm = random.choice(['BatchNorm', 'InstanceNorm'])
                            return norm
                        elif gene_name == 'optimizer_type':
                            optimizer = random.choice(['SGD', 'AdamW', 'RMSprop'])
                            return optimizer
        return current_value
