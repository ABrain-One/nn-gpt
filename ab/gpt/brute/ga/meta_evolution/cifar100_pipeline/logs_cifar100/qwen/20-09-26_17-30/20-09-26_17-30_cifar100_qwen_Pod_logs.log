    def select_competitor(self, competitors):
        k = 3
        competitors = random.sample(self.population, min(k, len(self.population)))
        # Use tournament selection to balance elitism and exploration
        selected = []
        for _ in range(k):
            competitors = sorted(competitors, key=lambda x: x['fitness'], reverse=True)
            best = competitors[0]
            worst = competitors[-1]
            if random.random() < 0.7:
                selected.append(best)
            else:
                selected.append(worst)
        return random.choice(selected)
