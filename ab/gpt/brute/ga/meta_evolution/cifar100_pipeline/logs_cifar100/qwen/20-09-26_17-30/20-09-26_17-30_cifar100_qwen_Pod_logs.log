def combine_genes(self, gene_name, parent1_value, parent2_value, crossover_point, gene_index, total_genes):
    if gene_index < crossover_point:
        return parent1_value
    else:
        # Introduce variability by combining elements from both parents
        if isinstance(parent1_value, int) or isinstance(parent1_value, float):
            return random.choice([parent1_value, parent2_value])
        elif isinstance(parent1_value, str):
            options = set([parent1_value, parent2_value])
            if len(options) > 1:
                return random.choice(list(options))
            else:
                return parent1_value
        elif isinstance(parent1_value, list):
            combined = list(set(parent1_value + parent2_value))
            if len(combined) > 1:
                return random.choice(combined)
            else:
                return parent1_value
        elif isinstance(parent1_value, tuple):
            combined = list(set(parent1_value + parent2_value))
            if len(combined) > 1:
                return random.choice(combined)
            else:
                return parent1_value
        else:
            return parent1_value
