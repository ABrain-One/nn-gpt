    def combine_genes(self, gene_name, parent1_value, parent2_value, crossover_point, gene_index, total_genes):
        if gene_index < crossover_point:
            # Uniform Crossover
            if random.random() > 0.5:
                return parent1_value
            else:
                return parent2_value
        else:
            # Multi-point Crossover
            points = random.sample(range(1, len(self.search_space)), 2)
            points.sort()
            start, mid, end = points[0], points[1], len(self.search_space)
            
            if gene_name == 'activation' or gene_name == 'kernel_size' or gene_name == 'pooling_type' or gene_name == 'conv_type' or gene_name == 'norm_type' or gene_name == 'optimizer_type':
                # Discrete parameters with weighted selection
                options = [parent1_value, parent2_value]
                weights = [0.7, 0.3]
                return random.choices(options, weights=weights)[0]
            else:
                # Numeric parameters with weighted averaging
                alpha = random.uniform(0.2, 0.8)
                beta = 1 - alpha
                return alpha * parent1_value + beta * parent2_value
        
        # Add Gaussian noise to numeric parameters to encourage exploration
        if isinstance(parent1_value, (int, float)):
            return parent1_value + random.gauss(0, 1) * 0.1

        return random.choice([parent1_value, parent2_value])
