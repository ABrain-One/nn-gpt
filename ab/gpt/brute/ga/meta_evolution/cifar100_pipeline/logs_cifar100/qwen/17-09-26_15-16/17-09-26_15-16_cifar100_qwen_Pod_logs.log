def combine_genes(self, gene_name, parent1_value, parent2_value, crossover_point, gene_index, total_genes):
    if gene_index < crossover_point:
        # Uniform Crossover
        if random.random() > 0.5:
            return parent1_value
        else:
            return parent2_value
    else:
        # Single-point Crossover
        if gene_name == 'n_columns' or gene_name == 'base_channels' or gene_name == 'n_blocks':
            # Numeric parameters with specific rules
            if gene_name == 'n_columns':
                return random.choice([parent1_value, parent2_value])
            elif gene_name == 'base_channels':
                return int((parent1_value + parent2_value) / 2)
            elif gene_name == 'n_blocks':
                return random.choice([parent1_value, parent2_value])
        elif gene_name == 'dropout_prob' or gene_name == 'fc_dropout' or gene_name == 'lr' or gene_name == 'momentum':
            # Floating-point parameters with specific ranges
            if gene_name == 'dropout_prob':
                return random.uniform(min(parent1_value, parent2_value), max(parent1_value, parent2_value))
            elif gene_name == 'fc_dropout':
                return random.uniform(min(parent1_value, parent2_value), max(parent1_value, parent2_value))
            elif gene_name == 'lr':
                return random.uniform(min(parent1_value, parent2_value), max(parent1_value, parent2_value))
            elif gene_name == 'momentum':
                return random.uniform(min(parent1_value, parent2_value), max(parent1_value, parent2_value))
        else:
            # Categorical parameters with uniform selection
            return random.choice([parent1_value, parent2_value])

        # Mutation
        mutation_probability = self.mutation_rate * 2
        if random.random() < mutation_probability:
            if gene_name == 'n_columns':
                return random.choice([parent1_value, parent2_value - 1, parent2_value + 1])
            elif gene_name == 'base_channels':
                return int((parent1_value + parent2_value) / 2)
            elif gene_name == 'n_blocks':
                return random.choice([parent1_value, parent2_value - 1, parent2_value + 1])
            elif gene_name == 'dropout_prob':
                return round(random.uniform(0.01, 0.99), 2)
            elif gene_name == 'fc_dropout':
                return round(random.uniform(0.01, 0.99), 2)
            elif gene_name == 'lr':
                return round(random.uniform(0.0001, 0.1), 4)
            elif gene_name == 'momentum':
                return round(random.uniform(0.01, 0.99), 2)
            elif gene_name == 'activation':
                possible_values = ['ReLU', 'GELU', 'LeakyReLU', 'SiLU']
                return random.choice([parent1_value, parent2_value] + possible_values)
            elif gene_name == 'kernel_size':
                possible_values = [1, 3, 5, 7]
                return random.choice([parent1_value, parent2_value] + possible_values)
            elif gene_name == 'pooling_type':
                possible_values = ['Max', 'Avg']
                return random.choice([parent1_value, parent2_value] + possible_values)
            elif gene_name == 'conv_type':
                possible_values = ['Standard', 'Depthwise']
                return random.choice([parent1_value, parent2_value] + possible_values)
            elif gene_name == 'norm_type':
                possible_values = ['BatchNorm', 'InstanceNorm']
                return random.choice([parent1_value, parent2_value] + possible_values)
            elif gene_name == 'optimizer_type':
                possible_values = ['SGD', 'AdamW', 'RMSprop']
                return random.choice([parent1_value, parent2_value] + possible_values)
