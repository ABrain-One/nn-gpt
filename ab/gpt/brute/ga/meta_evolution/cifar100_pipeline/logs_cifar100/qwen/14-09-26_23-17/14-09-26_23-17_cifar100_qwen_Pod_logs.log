        selected = max(competitors, key=lambda x: x['fitness'] if x['fitness'] is not None else -1)
        # Introduce some randomness to balance exploration and exploitation
        if random.random() < 0.1:  # Adjust the probability as needed
            selected = random.choice(competitors)
        return selected
```
