    if random.random() < 0.1:
        choices = list(set(self.search_space[gene_name]) - set([parent1_value, parent2_value]))
        if choices:
            child_value = random.choice(choices)

    # Force exploration of the search space
    if random.random() < 0.2:
        child_value = random.choice(self.search_space[gene_name])

    # Add noise to numerical parameters
    if gene_name in ["base_channels", "lr", "momentum"]:
        step_size = self.search_space[gene_name][1] - self.search_space[gene_name][0]
        child_value += (random.random() - 0.5) * step_size * 0.1

