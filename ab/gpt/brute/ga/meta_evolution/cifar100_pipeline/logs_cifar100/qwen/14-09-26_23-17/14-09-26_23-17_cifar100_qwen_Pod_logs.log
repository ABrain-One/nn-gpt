    if gene_name == "base_channels" and child_value % 2 != 0:
        child_value -= 1

    if gene_name == "kernel_size" and child_value in [1, 3]:
        child_value = 5

    child_chromo = {gene_name: child_value}
    return self._sanitize_chromosome(child_chromo)
