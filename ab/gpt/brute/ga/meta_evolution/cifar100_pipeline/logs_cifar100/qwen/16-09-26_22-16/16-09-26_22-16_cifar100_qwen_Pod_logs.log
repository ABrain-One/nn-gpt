    def combine_genes(self, gene_name, parent1_value, parent2_value, crossover_point, gene_index, total_genes):
        def invert_activation(act):
            if act == 'ReLU': return 'LeakyReLU'
            elif act == 'LeakyReLU': return 'ReLU'
            elif act == 'GELU': return 'SiLU'
            elif act == 'SiLU': return 'GELU'
            return act

        def invert_conv(conv):
            if conv == 'Standard': return 'Depthwise'
            elif conv == 'Depthwise': return 'Standard'
            return conv

        def combine_with_opposite(gene, parent1, parent2):
            if gene == 'activation':
                return random.choice([parent1, parent2])
            elif gene == 'conv_type':
                return random.choice([invert_conv(parent1), invert_conv(parent2)])
            else:
                return random.choice([parent1, parent2])

        if gene_name == 'activation':
            parent1_activations = ['ReLU', 'GELU']
            parent2_activations = ['LeakyReLU', 'SiLU']
            combined_value = random.choice(parent1_activations + parent2_activations)
            if random.random() < 0.1:
                combined_value = invert_activation(combined_value)
        elif gene_name == 'conv_type':
            parent1_convs = ['Standard', 'Depthwise']
            parent2_convs = ['Depthwise', 'Standard']
            combined_value = random.choice(parent1_convs + parent2_convs)
            if random.random() < 0.1:
                combined_value = invert_conv(combined_value)
        else:
            combined_value = combine_with_opposite(gene_name, parent1_value, parent2_value)

        if gene_index < crossover_point:
            combined_value = parent1_value
        else:
            combined_value = parent2_value

        return combined_value
