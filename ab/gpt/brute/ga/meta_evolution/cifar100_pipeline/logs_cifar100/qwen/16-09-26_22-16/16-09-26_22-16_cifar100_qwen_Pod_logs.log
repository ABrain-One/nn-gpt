def combine_genes(self, gene_name, parent1_value, parent2_value, crossover_point, gene_index, total_genes):
    if gene_name == 'activation':
        parent1_activations = ['ReLU', 'GELU', 'LeakyReLU', 'SiLU']
        parent2_activations = ['ReLU', 'GELU', 'LeakyReLU', 'SiLU']
        combined_value = random.choice(parent1_activations + parent2_activations)
        # Invert activation with higher probability for diversity
        if random.random() < 0.5:
            combined_value = invert_activation(combined_value)
    elif gene_name == 'conv_type':
        parent1_convs = ['Standard', 'Depthwise', 'Grouped']
        parent2_convs = ['Depthwise', 'Standard', 'Grouped']
        combined_value = random.choice(parent1_convs + parent2_convs)
        # Invert convolution type with higher probability for diversity
        if random.random() < 0.5:
            combined_value = invert_conv(combined_value)
    elif gene_name == 'pooling_type':
        parent1_poolings = ['Max', 'Avg']
        parent2_poolings = ['Max', 'Avg']
        combined_value = random.choice(parent1_poolings + parent2_poolings)
        # Randomly choose pooling type with higher probability for diversity
        if random.random() < 0.5:
            combined_value = random.choice(pooling_types)
    elif gene_index < crossover_point:
        combined_value = parent1_value
    else:
        combined_value = parent2_value

    # Introduce additional diversity by randomly swapping some parameters
    if random.random() < 0.1:
        swap_genes = random.sample(list(self.search_space.keys()), 2)
        swap_val_1 = self.combine_genes(swap_genes[0], parent1_value, parent2_value, crossover_point, gene_index, total_genes)
        swap_val_2 = self.combine_genes(swap_genes[1], parent1_value, parent2_value, crossover_point, gene_index, total_genes)
        combined_value = self.combine_genes(swap_genes[0], swap_val_1, swap_val_2, crossover_point, gene_index, total_genes)

    return combined_value
