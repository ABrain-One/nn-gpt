    def combine_genes(self, gene_name, parent1_value, parent2_value, crossover_point, gene_index, total_genes):
        if gene_name == 'activation':
            parent1_activations = ['ReLU', 'GELU', 'LeakyReLU', 'SiLU']
            parent2_activations = ['ReLU', 'GELU', 'LeakyReLU', 'SiLU']
            combined_value = random.choice(parent1_activations + parent2_activations)
            # Randomly choose from both parents' sets with equal probability
            if random.random() < 0.5:
                combined_value = parent1_value
            else:
                combined_value = parent2_value
        
        elif gene_name == 'conv_type':
            parent1_convs = ['Standard', 'Depthwise', 'Grouped']
            parent2_convs = ['Depthwise', 'Standard', 'Grouped']
            combined_value = random.choice(parent1_convs + parent2_convs)
            # Randomly choose from both parents' sets with equal probability
            if random.random() < 0.5:
                combined_value = parent1_value
            else:
                combined_value = parent2_value
        
        else:
            if gene_index < crossover_point:
                combined_value = parent1_value
            else:
                combined_value = parent2_value
        
        # Introduce diversity by sometimes choosing the opposite type
        if random.random() < 0.1:
            if gene_name == 'activation':
                if combined_value == 'ReLU':
                    combined_value = 'LeakyReLU'
                elif combined_value == 'GELU':
                    combined_value = 'SiLU'
                elif combined_value == 'LeakyReLU':
                    combined_value = 'ReLU'
                elif combined_value == 'SiLU':
                    combined_value = 'GELU'
            elif gene_name == 'conv_type':
                if combined_value == 'Standard':
                    combined_value = 'Depthwise'
                elif combined_value == 'Depthwise':
                    combined_value = 'Standard'
            elif gene_name == 'norm_type':
                if combined_value == 'BatchNorm':
                    combined_value = 'InstanceNorm'
                elif combined_value == 'InstanceNorm':
                    combined_value = 'BatchNorm'
            elif gene_name == 'optimizer_type':
                if combined_value == 'SGD':
                    combined_value = 'AdamW'
                elif combined_value == 'AdamW':
                    combined_value = 'SGD'
                elif combined_value == 'RMSprop':
                    combined_value = 'Adam'
                elif combined_value == 'Adam':
                    combined_value = 'RMSprop'
        
        return combined_value
