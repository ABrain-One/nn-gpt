    def combine_genes(self, gene_name, parent1_value, parent2_value, crossover_point, gene_index, total_genes):
        if gene_name == 'activation':
            parent1_activations = ['ReLU', 'GELU', 'LeakyReLU', 'SiLU']
            parent2_activations = ['ReLU', 'GELU', 'LeakyReLU', 'SiLU']
            combined_value = random.choice(parent1_activations + parent2_activations)
        
        elif gene_name == 'conv_type':
            parent1_convs = ['Standard', 'Depthwise', 'Grouped']
            parent2_convs = ['Depthwise', 'Standard', 'Grouped']
            combined_value = random.choice(parent1_convs + parent2_convs)
        
        else:
            combined_value = random.choice([parent1_value, parent2_value])
        
        # Introduce diversity by sometimes choosing the opposite type
        if random.random() < 0.2:
            if gene_name == 'activation':
                inverted_activations = {'ReLU': 'LeakyReLU', 'LeakyReLU': 'ReLU', 'GELU': 'SiLU', 'SiLU': 'GELU'}
                combined_value = inverted_activations.get(combined_value, combined_value)
            
            elif gene_name == 'conv_type':
                inverted_convs = {'Standard': 'Depthwise', 'Depthwise': 'Standard', 'Grouped': 'Depthwise'}
                combined_value = inverted_convs.get(combined_value, combined_value)
        
        # Apply dropout to some parts of the architecture to avoid overfitting
        if random.random() < 0.1:
            if gene_name == 'dropout_prob':
                combined_value = self._mutate_gene('dropout_prob', combined_value, list(self.search_space['dropout_prob']))
        
        # Explore different kernel sizes to increase complexity
        if random.random() < 0.1:
            if gene_name == 'kernel_size':
                combined_value = random.choice([1, 3, 5, 7])
        
        return combined_value
