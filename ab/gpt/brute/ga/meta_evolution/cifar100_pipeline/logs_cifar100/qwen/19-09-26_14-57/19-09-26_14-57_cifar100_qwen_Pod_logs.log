                # Choose between two different activation functions
                return random.choice(['ReLU', 'SiLU'])
            elif gene_name == 'optimizer_type':
                # Explore different optimization algorithms
                return random.choice(['AdamW', 'RMSprop'])
            elif gene_name == 'conv_type':
                # Try both standard and depthwise convolution
                return random.choice(['Standard', 'Depthwise'])
            elif gene_name == 'pooling_type':
                # Use both max and average pooling randomly
                return random.choice(['Max', 'Avg'])
            elif gene_name == 'dropout_prob' or gene_name == 'fc_dropout':
                # Increase dropout probability to encourage regularization
                return random.choice([0.3, 0.4, 0.5])
            elif gene_name == 'lr':
                # Reduce learning rate for better convergence
                return random.choice([0.005, 0.004, 0.003])
            elif gene_name == 'momentum':
                # Adjust momentum to balance exploration and exploitation
                return random.choice([0.9, 0.92, 0.95])
            elif gene_name == 'base_channels' or gene_name == 'n_columns' or gene_name == 'n_blocks':
                # Increase the complexity of the network
                return random.choice([32, 64, 128])
            elif gene_name == 'kernel_size':
                # Use larger kernel sizes to capture more information
                return random.choice([3, 5, 7])
            else:
                # Default to standard behavior
                return parent2_value
