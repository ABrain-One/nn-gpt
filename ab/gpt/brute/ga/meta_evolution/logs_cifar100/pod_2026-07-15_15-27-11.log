            idx2 = options.index(parent2_value)
            mid_idx = (idx1 + idx2) // 2
            return options[mid_idx % len(options)]
        else:
            if parent1_value in self.search_space[gene_name]:
                return parent1_value
            elif parent2_value in self.search_space[gene_name]:
                return parent2_value
            else:
                return random.choice(list(self.search_space[gene_name]))
