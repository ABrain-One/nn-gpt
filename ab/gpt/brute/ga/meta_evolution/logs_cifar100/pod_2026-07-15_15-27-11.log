    def combine_genes(self, gene_name, parent1_value, parent2_value, crossover_point, gene_index, total_genes):
        if gene_name == 'activation':
            activations = ['ReLU', 'GELU', 'LeakyReLU', 'SiLU']
            idx1 = activations.index(parent1_value)
            idx2 = activations.index(parent2_value)
            mid_idx = (idx1 + idx2) // 2
            return activations[mid_idx % len(activations)]
        elif gene_name == 'kernel_size':
            kernels = [1, 3, 5, 7]
            idx1 = kernels.index(parent1_value)
            idx2 = kernels.index(parent2_value)
            mid_idx = (idx1 + idx2) // 2
            return kernels[mid_idx % len(kernels)]
        elif gene_name == 'pooling_type' or gene_name == 'conv_type' or gene_name == 'norm_type' or gene_name == 'optimizer_type':
            options = list(self.search_space[gene_name])
