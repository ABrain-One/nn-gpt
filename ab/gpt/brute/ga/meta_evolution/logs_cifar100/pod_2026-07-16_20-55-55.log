            elif isinstance(current_value, float):
                mutation_range = 0.1
            else:
                mutation_range = 1

            mutation_step = random.uniform(-mutation_range, mutation_range)
            if isinstance(current_value, int):
                new_value = max(min(int(current_value + mutation_step), max(possible_values)), min(possible_values))
