            n_blocks = random.choice([2, 3, 4])
            chromosome[key] = n_blocks
            chromosome["base_channels"] = random.choice([16, 32, 64]) if n_blocks <= 2 else random.choice([32, 64, 128])
        elif key == "dropout_prob":
            chromosome[key] = random.choice([0.1, 0.15, 0.2, 0.25, 0.3, 0.4, 0.5])
        elif key == "fc_dropout":
            chromosome[key] = random.choice([0.05, 0.1, 0.15, 0.2, 0.25, 0.3, 0.4, 0.5])
        elif key == "lr":
