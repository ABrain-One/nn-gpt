def mutate_gene(self, gene_name, current_value, possible_values):
    mutated_value = current_value
    if random.random() < self.mutation_rate:
        if isinstance(current_value, int) or isinstance(current_value, float):
            sign = 1 if random.random() < 0.5 else -1
            step = random.uniform(0.1 * current_value, 0.5 * current_value)
            mutated_value += sign * step
        elif isinstance(current_value, str):
            index = possible_values.index(current_value)
            mutation_probability = 1 / len(possible_values)
            for i in range(len(possible_values)):
                if random.random() < mutation_probability:
                    mutated_value = possible_values[(index + i + 1) % len(possible_values)]
        else:
            mutated_value = random.choice(possible_values)
    
    return self._sanitize_chromosome({gene_name: mutated_value})[gene_name]
