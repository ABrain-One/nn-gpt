def mutate_gene(self, gene_name, current_value, possible_values):
    if possible_values:
        mutation_probability = self.mutation_rate * (1 + random.gauss(0, 0.5))
        if random.random() < mutation_probability:
            # Increase mutation strength to promote exploration
            mutation_strength = random.uniform(1.0, 2.0)
            candidates = [v for v in possible_values if v != current_value]
            # Use the current value as a reference point for mutation
            closest_candidate = min(candidates, key=lambda x: abs(x - current_value))
            mutated_value = current_value + (closest_candidate - current_value) * mutation_strength
            # Ensure the mutated value is within the possible values
            mutated_value = max(min(mutated_value, max(possible_values)), min(possible_values))
            return mutated_value
    return current_value
