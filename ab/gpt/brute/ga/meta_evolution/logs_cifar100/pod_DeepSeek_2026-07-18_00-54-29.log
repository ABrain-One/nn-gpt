def mutate_gene(self, gene_name, current_value, possible_values):
    if random.random() < self.mutation_rate:
        if possible_values:
            mutated_value = random.choice(possible_values)
        else:
            mutated_value = current_value

        mutated_chromo = self._sanitize_chromosome({gene_name: mutated_value})
        return mutated_chromo[gene_name]
    return current_value
