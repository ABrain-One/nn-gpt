    def invert_gene(self, gene_name, current_value):
        valid_values = self.search_space[gene_name]
        if not valid_values:
            return current_value
        
        # Find the index of the current value
        idx = valid_values.index(current_value)
        
        # Invert the value to another feasible value
        next_idx = (idx + 1) % len(valid_values)
        return valid_values[next_idx]

    def blend_genes(self, gene_name, parent1_value, parent2_value):
        valid_values = self.search_space[gene_name]
        if not valid_values:
            return parent1_value
        
        # Find indices of parent values
        p1_idx = valid_values.index(parent1_value)
        p2_idx = valid_values.index(parent2_value)
        
        # Blend the indices
        blended_idx = (p1_idx + p2_idx) // 2
        
        # Ensure the blended index is within bounds
        blended_idx = blended_idx % len(valid_values)
        
        return valid_values[blended_idx]

    def track_history(self, history, gene_name, parent1_value, parent2_value, combined_value):
        history[(gene_name, parent1_value, parent2_value)] = combined_value
        return history

    def combine_genes(self, gene_name, parent1_value, parent2_value, crossover_point, gene_index, total_genes, history=None):
        if history is None:
            history = {}

        if gene_index < crossover_point:
            combined_value = parent1_value
        else:
            combined_value = parent2_value

        # Check if the gene combination is already in history
        if (gene_name, parent1_value, parent2_value) in history:
            return history[(gene_name, parent1_value, parent2_value)]

        # Apply inversion and blending with some probability
        if random.random() < 0.5:
            combined_value = self.invert_gene(gene_name, combined_value)
        if random.random() < 0.5:
            combined_value = self.blend_genes(gene_name, parent1_value, parent2_value)

        # Track the history
        history = self.track_history(history, gene_name, parent1_value, parent2_value, combined_value)

        return combined_value
```
