                elif gene_name == "base_channels":
                    mutated_chromo[gene] = random.choice([max(16, current_value // 2), current_value * 2])
                elif gene_name == "n_blocks":
                    mutated_chromo[gene] = random.choice([max(1, current_value - 1), current_value + 1])
                elif gene_name == "dropout_prob":
                    mutated_chromo[gene] = random.choice([max(0.0, current_value - 0.1), min(1.0, current_value + 0.1)])
                elif gene_name == "fc_dropout":
                    mutated_chromo[gene] = random.choice([max(0.0, current_value - 0.1), min(1.0, current_value + 0.1)])
                elif gene_name == "lr":
