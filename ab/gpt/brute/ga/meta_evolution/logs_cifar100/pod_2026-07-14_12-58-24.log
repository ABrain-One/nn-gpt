    def combine_genes(self, gene_name, parent1_value, parent2_value, crossover_point, gene_index, total_genes):
        # Get the fitness scores of the parents
        parent1_fitness = parent1_value.get('fitness', 0)
        parent2_fitness = parent2_value.get('fitness', 0)

        # Calculate weights based on fitness scores
        total_fitness = parent1_fitness + parent2_fitness
        if total_fitness <= 0:
            weight1 = 0.5
            weight2 = 0.5
        else:
            weight1 = parent1_fitness / total_fitness
            weight2 = parent2_fitness / total_fitness

        # Combine genes using weighted average
        combined_value = (parent1_value[gene_name] * weight1 + parent2_value[gene_name] * weight2)

        # Snap to nearest valid value in the search space
        valid_values = self.search_space[gene_name]
        if not valid_values:
            return combined_value
        if combined_value in valid_values:
