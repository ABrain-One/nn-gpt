        elif gene_name in ["dropout_prob", "fc_dropout", "lr", "momentum"]:
            # Arithmetic Crossover
            alpha = random.random()
            return alpha * parent1_value + (1 - alpha) * parent2_value
        elif gene_name in ["kernel_size"]:
            # Arithmetic Crossover with rounding
            alpha = random.random()
            return round(alpha * parent1_value + (1 - alpha) * parent2_value)
        elif gene_name in ["activation", "pooling_type", "conv_type", "norm_type", "optimizer_type"]:
            # One-point Crossover
            if random.random() < 0.5:
                return parent1_value
            else:
