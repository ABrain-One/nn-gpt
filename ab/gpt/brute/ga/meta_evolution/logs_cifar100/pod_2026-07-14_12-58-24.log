    def mutate_gene(self, gene_name, current_value, possible_values):
        if gene_name in ["n_columns", "n_blocks", "base_channels"]:
            # Flip bits
            if random.random() < 0.5:
                return random.choice([x for x in possible_values if x != current_value])
        elif gene_name in ["dropout_prob", "fc_dropout", "lr", "momentum"]:
            # Change sign
            return -current_value
        elif gene_name in ["kernel_size"]:
            # Swap elements in list
            if isinstance(current_value, list):
                if len(current_value) > 1:
                    idx1, idx2 = random.sample(range(len(current_value)), 2)
                    current_value[idx1], current_value[idx2] = current_value[idx2], current_value[idx1]
                    return current_value
        elif gene_name in ["activation", "pooling_type", "conv_type", "norm_type", "optimizer_type"]:
            # Random choice
            return random.choice(possible_values)
        return current_value

    def select_competitor(self, competitors):
        if len(competitors) < 2:
            return random.choice(competitors)
        
        # Tournament Selection with multiple rounds
        while len(competitors) > 1:
            new_competitors = []
            for i in range(0, len(competitors), 2):
                if i + 1 < len(competitors):
                    competitor1 = competitors[i]
                    competitor2 = competitors[i + 1]
                    winner = competitor1 if competitor1['fitness'] > competitor2['fitness'] else competitor2
                    new_competitors.append(winner)
            competitors = new_competitors
        
        return competitors[0]
