        exemplar = valid_values[0]
        if isinstance(exemplar, (int, float, np.integer, np.floating)) and isinstance(combined_value, (int, float, np.integer, np.floating)):
            return min(valid_values, key=lambda candidate: abs(float(candidate) - float(combined_value)))
        return random.choice(valid_values)
