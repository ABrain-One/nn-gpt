    def combine_genes(self, gene_name, parent1_value, parent2_value, crossover_point, gene_index, total_genes):
        # Use a weighted average of the parent genes based on their fitness
        weight1 = parent1_value['fitness'] if parent1_value['fitness'] is not None else 0
        weight2 = parent2_value['fitness'] if parent2_value['fitness'] is not None else 0
        total_weight = weight1 + weight2
        
