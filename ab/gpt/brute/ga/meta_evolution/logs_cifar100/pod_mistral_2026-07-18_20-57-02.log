def combine_genes(self, gene_name, parent1_chromo, parent2_chromo, crossover_point, gene_index, total_genes):
    child_chromo = {}
    for i, gene in enumerate(self.search_space.keys()):
        if i < crossover_point:
            child_chromo[gene] = parent1_chromo[gene]
        else:
            child_chromo[gene] = parent2_chromo.get(gene, parent1_chromo.get(gene))
    
    # Strategies to maintain genetic diversity and avoid premature convergence
    for gene in self.search_space.keys():
        if np.random.rand() < self.mutation_rate or (gene in ["n_blocks", "base_channels"] and np.random.rand() < 0.5):
            if gene in child_chromo:
                possible_values = list(self.search_space[gene])
                child_chromo[gene] = self.mutate_gene(gene, child_chromo[gene], possible_values)

    return self._sanitize_chromosome(child_chromo)
