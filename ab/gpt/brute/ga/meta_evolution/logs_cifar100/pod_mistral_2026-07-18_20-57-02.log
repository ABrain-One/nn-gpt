### mutate_gene ###
def mutate_gene(self, gene_name, current_value, possible_values):
    if random.random() < self.mutation_rate and possible_values:
        return random.choice(possible_values)
    if len(possible_values) > 1 and random.random() < 0.5:
        return random.choice(possible_values)
    return current_value

    # Optionally, add a custom mutation strategy for specific genes. For example, for dropout_prob, you can randomly decrease or increase the value.
    if gene_name == 'dropout_prob':
        if random.random() < self.mutation_rate:
            decrease = random.random() < 0.5
            if decrease:
                return max(current_value - 0.05, self._coerce_gene_value(gene_name, current_value-0.05))
            else:
                return min(current_value + 0.05, self._coerce_gene_value(gene_name, current_value+0.05))

    return self._sanitize_chromosome(current_value if not gene_name else {gene_name: current_value})
