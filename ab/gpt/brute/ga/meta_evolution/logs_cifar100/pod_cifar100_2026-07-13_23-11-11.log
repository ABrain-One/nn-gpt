    def combine_genes(self, gene_name, parent1_value, parent2_value, crossover_point, gene_index, total_genes):
        # Randomly choose between parents
        if random.random() < 0.5:
            base_value = parent1_value
        else:
            base_value = parent2_value
        
        # Apply mutation
        if random.random() < 0.05:
            possible_values = self.search_space[gene_name]
            if isinstance(base_value, (int, float)):
                # Small increment/decrement
                base_value += random.choice([-0.05, 0.05])
                base_value = min(max(base_value, possible_values[0]), possible_values[-1])
            elif isinstance(base_value, str):
                # Value swap or inversion
                if gene_name == 'activation' or gene_name == 'pooling_type':
                    alternatives = [v for v in self.search_space[gene_name] if v != base_value]
                    base_value = random.choice([base_value, random.choice(alternatives)])
                elif gene_name == 'dropout_prob':
                    # Invert the dropout probability
                    base_value = 1.0 - base_value
            elif isinstance(base_value, bool):
                # Invert the boolean value
                base_value = not base_value
        
        return base_value
