    def combine_genes(self, gene_name, parent1_value, parent2_value, crossover_point, gene_index, total_genes):
        # Define the possible values for each gene
        possible_values = self.search_space[gene_name]

        # Determine the midpoint of the crossover point
        mid_point = (crossover_point + gene_index) / total_genes

        # Randomly decide whether to take the value from parent1 or parent2
        if random.random() < mid_point:
            combined_value = parent1_value
        else:
            combined_value = parent2_value

        # Introduce a small probability of inverting the gene value
        if random.random() < 0.1:
            # Find the opposite value within the possible range
            opposite_value = self._find_opposite_value(combined_value, possible_values)
            if opposite_value is not None:
                combined_value = opposite_value

        return combined_value

    def _find_opposite_value(self, value, possible_values):
        """Find the opposite value within the possible range."""
        if isinstance(value, (int, float)):
            # Calculate the opposite value
            opposite_value = -value
            # Check if the opposite value is within the possible range
            if opposite_value in possible_values:
                return opposite_value
        elif isinstance(value, str):
            # Find the opposite string value (assuming two-way mapping)
            opposite_mapping = {
                "ReLU": "LeakyReLU",
                "LeakyReLU": "ReLU",
                "GELU": "SiLU",
                "SiLU": "GELU",
                "Max": "Avg",
                "Avg": "Max",
                "Standard": "Depthwise",
                "Depthwise": "Standard",
                "BatchNorm": "InstanceNorm",
                "InstanceNorm": "BatchNorm",
                "SGD": "AdamW",
                "AdamW": "SGD",
                "RMSprop": "RMSprop"  # RMSprop is symmetric, so no opposite
            }
            if value in opposite_mapping:
                return opposite_mapping[value]
        return None
