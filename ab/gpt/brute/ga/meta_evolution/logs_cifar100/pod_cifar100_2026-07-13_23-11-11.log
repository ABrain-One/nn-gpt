    def mutate_gene(self, gene_name, current_value, possible_values):
        if possible_values:
            # Ensure mutations respect constraints
            if gene_name == "dropout_prob":
                return min(max(current_value + 0.05, 0.1), 0.5)
            elif gene_name == "activation":
                alternatives = [v for v in self.search_space[gene_name] if v != current_value]
                return random.choice(alternatives) if alternatives else current_value
            elif gene_name == "lr":
                alternatives = [v for v in self.search_space[gene_name] if v < current_value]
                return random.choice(alternatives) if alternatives else current_value
            elif gene_name == "pooling_type":
                alternatives = [v for v in self.search_space[gene_name] if v != current_value]
                return random.choice(alternatives) if alternatives else current_value
        return random.choice(possible_values)

