```python
    def combine_genes(self, gene_name, parent1_value, parent2_value, crossover_point, gene_index, total_genes):
        # Hybridization strategy: Combine genes from both parents while introducing randomness
        if random.random() < 0.5:
            base_value = parent1_value
        else:
            base_value = parent2_value
        
        # Introduce randomness to maintain diversity
        if gene_name == "dropout_prob":
            # Invert dropout probability to explore different trade-offs
            inverted_value = 1 - base_value
            # Blend between original and inverted value
            combined_value = (base_value + inverted_value) / 2
            # Snap to closest valid value
            possible_values = [0.1, 0.15, 0.2, 0.25, 0.3, 0.4, 0.5]
            return min(possible_values, key=lambda x: abs(x - combined_value))
        
        elif gene_name == "activation":
            # Cycle through activations to explore different non-linearities
            activations = ["ReLU", "GELU", "LeakyReLU", "SiLU"]
            index = activations.index(base_value)
            combined_value = activations[(index + 1) % len(activations)]
            return combined_value
        
        elif gene_name == "lr":
            # Exponentially decrease learning rate to fine-tune
            decay_rate = 0.95
            combined_value = base_value * decay_rate
            return min(self.search_space["lr"], key=lambda x: abs(x - combined_value))
        
        elif gene_name == "pooling_type":
            # Alternate pooling types to explore spatial relationships
            poolings = ["Max", "Avg"]
            index = poolings.index(base_value)
            combined_value = poolings[(index + 1) % len(poolings)]
            return combined_value
        
        # Default behavior: randomly choose between parents
        else:
            return random.choice([parent1_value, parent2_value])
