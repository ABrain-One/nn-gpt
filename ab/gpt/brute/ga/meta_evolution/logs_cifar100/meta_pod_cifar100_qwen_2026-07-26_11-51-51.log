    def mutate_gene(self, gene_name, current_value, possible_values):
        if possible_values:
            # Increase mutation rate for critical parameters
            if gene_name in ["n_columns", "base_channels", "n_blocks", "optimizer_type"]:
                mutation_rate = self.mutation_rate * 3
            else:
                mutation_rate = self.mutation_rate

            if random.random() < mutation_rate:
                # Select a new value randomly but ensure it's different from the current value
                new_value = random.choice([v for v in possible_values if v != current_value])
                return new_value
        return current_value
