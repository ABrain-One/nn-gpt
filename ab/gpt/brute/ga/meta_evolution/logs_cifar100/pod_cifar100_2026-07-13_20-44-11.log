    def mutate_gene(self, gene_name, current_value, possible_values):
        # Define the probability of applying each mutation strategy
        inversion_rate = 0.1
        momentum_rate = 0.2
        stochastic_depth_rate = 0.1
        
        # Apply inversion mutation
        if random.random() < inversion_rate:
            inverted_value = current_value * (-1) + possible_values[-1] + possible_values[0]
            if inverted_value in possible_values:
                return inverted_value
        
        # Apply momentum tracking mutation
        if random.random() < momentum_rate:
            if hasattr(self, 'best_genes') and gene_name in self.best_genes:
                momentum_value = self.best_genes[gene_name] * 0.9 + current_value * 0.1
                if momentum_value in possible_values:
                    return momentum_value
        
        # Apply active stochastic depth mutation
        if random.random() < stochastic_depth_rate and gene_name == 'dropout_prob':
            if current_value < 0.25:
                new_value = current_value + 0.05
                if new_value in possible_values:
                    return new_value
        
        # If no mutation is applied, return a random choice from possible values
        return random.choice(possible_values)
```
