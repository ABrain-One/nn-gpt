        # Random sampling from the archive and population
        archive_competitor = random.choice(list(self.archive.values()))
        population_competitor = random.choice(self.population)
        
        # Hybrid selection
        if random.random() < 0.5:
            return tournament_winner
        else:
            return max([archive_competitor, population_competitor], key=lambda x: x['fitness'] if x['fitness'] is not None else -1)
