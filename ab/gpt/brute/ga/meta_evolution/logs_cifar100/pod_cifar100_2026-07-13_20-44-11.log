    def select_competitor(self, competitors):
        if not competitors:
            return None
        
        # Calculate the total fitness and number of competitors
        total_fitness = sum(max(comp['fitness'], 0) for comp in competitors)
        if total_fitness <= 0:
            return random.choice(competitors)
        
        # Sample a competitor based on fitness
        rand_val = random.random() * total_fitness
        cumulative_fitness = 0
        for competitor in competitors:
            cumulative_fitness += max(competitor['fitness'], 0)
            if rand_val <= cumulative_fitness:
                return competitor
        
        # If no competitor was selected, return a random one
        return random.choice(competitors)
