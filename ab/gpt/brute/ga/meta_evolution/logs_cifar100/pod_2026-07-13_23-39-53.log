    def mutate_gene(self, gene_name, current_value, possible_values):
        if not possible_values:
            return current_value
        
        # Favor mutation towards previously found good configurations
        weighted_possible_values = []
        if gene_name == "dropout_prob":
            if current_value <= 0.3:
                weighted_possible_values.extend([0.3, 0.4, 0.5, 0.6, 0.7])
            else:
                weighted_possible_values.extend([0.1, 0.15, 0.2, 0.25])
        elif gene_name == "lr":
            if current_value <= 0.004:
                weighted_possible_values.extend([0.004, 0.005, 0.006, 0.007, 0.008])
            else:
                weighted_possible_values.extend([0.001, 0.002, 0.003])
        elif gene_name == "momentum":
            if current_value <= 0.85:
                weighted_possible_values.extend([0.85, 0.88, 0.9, 0.92, 0.95])
            else:
                weighted_possible_values.extend([0.75, 0.8, 0.83])
        
        if weighted_possible_values:
            return random.choice(weighted_possible_values)
        
        return random.choice(possible_values)
