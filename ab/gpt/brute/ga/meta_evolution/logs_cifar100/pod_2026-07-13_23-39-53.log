    def select_competitor(self, competitors):
        exploration_rate = 0.1  # Adjust this value to control exploration-exploitation trade-off
        archive_centroid = np.mean([np.array(list(individual.values())) for individual in self.archive.values()], axis=0)
        
        selected_competitor = None
        best_score = float('-inf')
        
        for competitor in competitors:
            competitor_vec = np.array(list(competitor.values()))
            distance_to_centroid = np.linalg.norm(competitor_vec - archive_centroid)
            adjusted_fitness = competitor['fitness'] / (distance_to_centroid ** 2 + 1)  # Adjusted fitness
            
            if adjusted_fitness > best_score:
                best_score = adjusted_fitness
                selected_competitor = competitor
        
        # With exploration_rate probability, select a random competitor
        if random.random() < exploration_rate:
            selected_competitor = random.choice(competitors)
        
        return selected_competitor
