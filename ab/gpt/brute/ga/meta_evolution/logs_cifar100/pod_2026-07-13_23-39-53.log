    def combine_genes(self, gene_name, parent1_value, parent2_value, crossover_point, gene_index, total_genes):
        if gene_index < crossover_point:
            return parent1_value
        
        # Define thresholds for inversion
        if random.random() < 0.2:  # Invert gene with 20% probability
            if gene_name == "dropout_prob":
                if parent1_value <= 0.3:
                    return parent2_value
            elif gene_name == "lr":
                if parent1_value <= 0.004:
                    return parent2_value
            elif gene_name == "momentum":
                if parent1_value <= 0.85:
                    return parent2_value
            elif gene_name in ["activation", "pooling_type", "conv_type"]:
                return random.choice([parent1_value, parent2_value])
        
        # Momentum-based updates for continuous genes
        if gene_name in ["dropout_prob", "lr", "momentum"]:
            alpha = 0.8  # Momentum coefficient
            new_value = alpha * (parent2_value - parent1_value) + parent1_value
            return new_value
        
        # Hybridization for categorical genes
        elif gene_name in ["activation", "pooling_type", "conv_type"]:
            return random.choice([parent1_value, parent2_value])
        
        return parent2_value
