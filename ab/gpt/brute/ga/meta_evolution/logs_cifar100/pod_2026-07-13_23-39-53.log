            elif gene_name == "pooling_type":
                # Bias towards Max pooling but allow others to be explored
                if random.random() < 0.6:
                    chromosome[gene_name] = "Max"
                else:
                    chromosome[gene_name] = "Avg"
            else:
                chromosome[gene_name] = random.choice(values)
        return chromosome
