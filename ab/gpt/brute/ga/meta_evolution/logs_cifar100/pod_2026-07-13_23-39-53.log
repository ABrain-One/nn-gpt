    def select_competitor(self, competitors):
        # Number of competitors to sample for tournament
        k = 5
        sampled_competitors = random.sample(self.population, min(k, len(self.population)))
        
        # Sort competitors by fitness in descending order
        sorted_competitors = sorted(sampled_competitors, key=lambda x: x['fitness'], reverse=True)
        
        # Select the top half of the sampled competitors
        selected_competitors = sorted_competitors[:len(sorted_competitors) // 2]
        
        # Add randomly selected competitors from the archive to maintain diversity
        archive_size = min(len(self.archive), 2)
        archive_competitors = random.sample(list(self.archive.values()), archive_size)
        selected_competitors += archive_competitors
        
        # Select one winner using a tournament scheme
        winner = random.choice(selected_competitors)
        
        return winner
