            return parent1_value
        
        # Define thresholds for inversion
        if gene_name == "dropout_prob":
            if abs(parent1_value - 0.1) < 0.05:
                return 0.5 - parent2_value
            elif parent1_value <= 0.3:
                return parent2_value
        elif gene_name == "lr":
            if parent1_value <= 0.004:
                return parent2_value
            elif abs(parent1_value - 0.002) < 0.001:
                return 0.005 - parent2_value
        elif gene_name == "momentum":
            if parent1_value <= 0.85:
                return parent2_value
            elif abs(parent1_value - 0.88) < 0.02:
                return 0.9 - parent2_value
        elif gene_name in ["activation", "pooling_type", "conv_type"]:
            choices = [parent1_value, parent2_value]
            if parent1_value == "ReLU":
                choices.append("GELU")
                choices.append("LeakyReLU")
                choices.append("SiLU")
            elif parent1_value == "GELU":
                choices.append("ReLU")
                choices.append("LeakyReLU")
                choices.append("SiLU")
            elif parent1_value == "LeakyReLU":
                choices.append("ReLU")
                choices.append("GELU")
                choices.append("SiLU")
            elif parent1_value == "SiLU":
                choices.append("ReLU")
                choices.append("GELU")
                choices.append("LeakyReLU")
            return random.choice(choices)
        
        return parent2_value
