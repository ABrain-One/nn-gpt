        pop_samples = random.sample(population, num_pop_samples)
        
        return archive_samples + pop_samples

    def select_competitor(self, competitors):
        # Sample candidates from the archive and the population
        candidates = self._sample_candidates(self.archive, self.population)
        
        # Combine the original competitors with the sampled candidates
        all_competitors = competitors + candidates
        
        # Select the competitor with the highest fitness score
        return max(all_competitors, key=lambda x: x['fitness'] if x['fitness'] is not None else -1)
