    def mutate_gene(self, gene_name, current_value, possible_values):
        if possible_values:
            # Invert dropout probability for diversity
            if gene_name == "dropout_prob":
                inverted_value = 1.0 - current_value
                if inverted_value in possible_values:
                    return inverted_value
                return random.choice([value for value in possible_values if value != current_value])

            # Select a learning rate that is close but not identical to the current one
            if gene_name == "lr":
                closest_lr = min(possible_values, key=lambda x: abs(x - current_value))
                if closest_lr != current_value:
                    return closest_lr
                return random.choice([value for value in possible_values if value != current_value])

            # Choose an optimizer that complements the current one
            if gene_name == "optimizer_type":
                if current_value == "SGD":
                    complementary_optimizers = ["AdamW", "RMSprop"]
                elif current_value == "AdamW":
                    complementary_optimizers = ["SGD", "RMSprop"]
                elif current_value == "RMSprop":
                    complementary_optimizers = ["SGD", "AdamW"]
                else:
                    complementary_optimizers = ["SGD", "AdamW", "RMSprop"]

                return random.choice(complementary_optimizers)

            return random.choice(possible_values)
        return current_value
