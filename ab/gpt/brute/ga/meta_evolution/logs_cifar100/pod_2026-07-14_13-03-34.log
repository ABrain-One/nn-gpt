    def combine_genes(self, gene_name, parent1_value, parent2_value, crossover_point, gene_index, total_genes):
        if gene_index < crossover_point:
            return parent1_value
        else:
            return parent2_value
        
        # Additional logic for combining genes
        if gene_name == "dropout_prob":
            # Blend the dropout probabilities with a small margin
            combined_value = (parent1_value + parent2_value) / 2
            # Ensure the combined value is within the valid range
            combined_value = max(min(combined_value, 0.5), 0.05)
            return combined_value
        elif gene_name in ["lr", "momentum"]:
            # Perturb the learning rate and momentum slightly
            combined_value = (parent1_value + parent2_value) / 2
            # Ensure the combined value is within the valid range
            combined_value = max(min(combined_value, 0.02), 0.001)
            return combined_value
        else:
            # Inherit randomly from either parent
            return random.choice([parent1_value, parent2_value])
