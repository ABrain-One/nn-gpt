    def mutate_gene(self, gene_name, current_value, possible_values):
        if possible_values:
            # Invert dropout probability for diversity
            if gene_name == "dropout_prob":
                inverted_value = 1.0 - current_value
                if inverted_value in possible_values:
                    return inverted_value
                return random.choice([value for value in possible_values if value != current_value])
            
            # Mutate learning rate to a more distant but plausible value
            if gene_name == "lr":
                lr_options = [0.01, 0.008, 0.006, 0.005, 0.004, 0.003, 0.002, 0.001]
                current_idx = lr_options.index(current_value)
                new_idx = (current_idx + random.choice([-2, -1, 1, 2])) % len(lr_options)
                return lr_options[new_idx]
            
            # Shuffle layers for architecture diversity
            if gene_name == "n_blocks":
                blocks = list(range(2, 5))
                blocks.remove(current_value)
                return random.choice(blocks)
            
            # Choose a completely different optimizer
            if gene_name == "optimizer_type":
                current_optimizer = current_value
                remaining_opts = [opt for opt in ["SGD", "AdamW", "RMSprop"] if opt != current_optimizer]
                return random.choice(remaining_opts)
        
            return random.choice(possible_values)
        return current_value
