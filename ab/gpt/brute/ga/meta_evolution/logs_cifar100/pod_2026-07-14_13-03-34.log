    def select_competitor(self, competitors):
        # Calculate the fitness-based selection
        fitness_based_choice = max(competitors, key=lambda x: x['fitness'] if x['fitness'] is not None else -1)

        # Calculate the novelty-based selection
        archive_rankings = {chromo: idx for idx, chromo in enumerate(self.archive.keys())}
        novelty_scores = [(chromo, len(self.archive) - archive_rankings.get(chromo, len(self.archive))) for chromo in competitors]
        novelty_based_choice = max(novelty_scores, key=lambda x: x[1])[0]

        # Bias towards higher dropout probabilities
        dropout_probs = [chromo['dropout_prob'] for chromo in competitors]
        max_dropout = max(dropout_probs)
        min_dropout = min(dropout_probs)
        adjusted_dropout_probs = [(prob - min_dropout) / (max_dropout - min_dropout) for prob in dropout_probs]
        dropout_weights = np.array(adjusted_dropout_probs) / sum(adjusted_dropout_probs)

        # Combine fitness and novelty scores with weighted dropout probability
        combined_scores = [(chromo, 0.7 * chromo['fitness'] + 0.2 * archive_rankings[chromo] + 0.1 * dropout_weights[idx]) 
                           for idx, chromo in enumerate(competitors)]

        # Select the best competitor based on the combined score
        selected_chromo = max(combined_scores, key=lambda x: x[1])[0]

        return selected_chromo
