    def mutate_gene(self, gene_name, current_value, possible_values):
        if gene_name == "dropout_prob":
            # Increase dropout slightly with a small chance of decreasing it
            if random.random() < 0.5:
                new_val = current_value * 1.1
                if new_val > 0.5:
                    new_val = 0.5
            else:
                new_val = current_value * 0.9
                if new_val < 0.05:
                    new_val = 0.05
            return new_val
        elif gene_name in ["lr", "momentum"]:
            # Mutate towards known high-performing values
            if gene_name == "lr":
                possible_high_performers = [0.001, 0.003, 0.005, 0.01]
            else:
                possible_high_performers = [0.85, 0.88, 0.9, 0.92]
            if random.random() < 0.7:
                new_val = random.choice(possible_high_performers)
            else:
                new_val = random.choice(possible_values)
            return new_val
        else:
            # Mutate towards known high-performing values with a small chance of complete randomness
            if random.random() < 0.7:
                high_performer = next((v for v in possible_values if v in ("relu", "gelu", "batchnorm")), None)
                if high_performer:
                    return high_performer
            return random.choice(possible_values)
