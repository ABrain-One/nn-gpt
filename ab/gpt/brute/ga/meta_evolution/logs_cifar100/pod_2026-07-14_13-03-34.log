    def combine_genes(self, gene_name, parent1_value, parent2_value, crossover_point, gene_index, total_genes):
        # Define a momentum factor to track historical values
        momentum_factor = 0.9
        history_key = f"{gene_name}_history"

        # Initialize history if it doesn't exist
        if history_key not in self.history:
            self.history[history_key] = []

        # Update history with the current gene values
        self.history[history_key].append(parent1_value)
        self.history[history_key].append(parent2_value)

        # Calculate the weighted average of the last few values in history
        history_length = min(len(self.history[history_key]), 10)  # Limit history length to avoid large memory usage
        avg_value = sum(self.history[history_key][-history_length:]) / history_length

        # Introduce inversion with a low probability
        if random.random() < 0.1:
            inverted_value = parent1_value if parent1_value != parent2_value else parent2_value
            combined_value = (inverted_value + avg_value) / 2
        else:
            combined_value = (parent1_value + parent2_value) / 2

        # Apply momentum to the combined value
        combined_value = combined_value * momentum_factor + avg_value * (1 - momentum_factor)

        # Ensure the combined value is within the valid range
        valid_values = self.search_space[gene_name]
        if not valid_values:
            return combined_value
        if combined_value in valid_values:
            return combined_value
        exemplar = valid_values[0]
        if isinstance(exemplar, (int, float, np.integer, np.floating)) and isinstance(combined_value, (int, float, np.integer, np.floating)):
            return min(valid_values, key=lambda candidate: abs(float(candidate) - float(combined_value)))
        return random.choice(valid_values)
