    def _create_random_chromosome(self):
        sota_params = {
            "n_columns": 2,
            "base_channels": 64,
            "n_blocks": 4,
            "dropout_prob": 0.1,
            "fc_dropout": 0.2,
            "lr": 0.001,
            "momentum": 0.98,
            "activation": "GELU",
            "kernel_size": 3,
            "pooling_type": "Max",
            "conv_type": "Standard",
            "norm_type": "BatchNorm",
            "optimizer_type": "AdamW"
        }

        # Create a chromosome with a strong bias towards SOTA params
        chromosome = {}
        for gene_name, values in self.search_space.items():
            if gene_name in sota_params:
                chromosome[gene_name] = random.choice([sota_params[gene_name]] + values)
            else:
                chromosome[gene_name] = random.choice(values)

        return chromosome
