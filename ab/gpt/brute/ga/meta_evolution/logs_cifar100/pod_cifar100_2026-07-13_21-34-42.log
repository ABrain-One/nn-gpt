            else:
                # Combine with a slight preference towards larger dropout rates for better robustness
                return max(parent1_value, parent2_value)
        
        elif gene_name in ["lr", "momentum"]:
            # Introduce mutations for lr and momentum with lower probability
            if random.random() < 0.1:
                return random.choice([parent1_value, parent2_value])
            else:
                # Average the values to find a middle ground
                return (parent1_value + parent2_value) / 2
        
        elif gene_name in ["kernel_size", "n_blocks"]:
            # Introduce mutations for kernel_size and n_blocks with lower probability
            if random.random() < 0.1:
                return random.choice([parent1_value, parent2_value])
            else:
                # Hybridize the values
                return int((parent1_value + parent2_value) / 2)
        
        else:
            # Randomly choose between parent values
            return random.choice([parent1_value, parent2_value])
