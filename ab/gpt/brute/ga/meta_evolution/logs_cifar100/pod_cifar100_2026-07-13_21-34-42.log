    def _create_random_chromosome(self):
        chromosome = {}
        for gene_name, possible_values in self.search_space.items():
            # Prioritize values that have shown promise in past generations
            if gene_name == "dropout_prob":
                prioritized_values = [0.1, 0.15, 0.2, 0.25, 0.3, 0.4, 0.5]
            elif gene_name == "base_channels":
                prioritized_values = [16, 32, 64]
            elif gene_name == "n_blocks":
                prioritized_values = [2, 3, 4]
            elif gene_name == "activation":
                prioritized_values = ["ReLU", "GELU"]
            elif gene_name == "kernel_size":
                prioritized_values = [1, 3, 5, 7]
            elif gene_name == "optimizer_type":
                prioritized_values = ["SGD", "AdamW"]
            else:
                prioritized_values = possible_values
            
            # Sample from prioritized values with a small probability of choosing any value
            if random.random() < 0.1:
                chromosome[gene_name] = random.choice(possible_values)
            else:
                chromosome[gene_name] = random.choice(prioritized_values)
        
        return chromosome
