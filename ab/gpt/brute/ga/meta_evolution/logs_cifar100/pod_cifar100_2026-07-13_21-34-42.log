    def select_competitor(self, competitors):
        # Calculate weights for fitness and novelty
        archive_size = len(self.archive)
        if archive_size < 10:
            fitness_weight = 0.8
            novelty_weight = 0.2
        elif archive_size < 20:
            fitness_weight = 0.6
            novelty_weight = 0.4
        else:
            fitness_weight = 0.4
            novelty_weight = 0.6
    
        # Initialize the best competitor and its score
        best_competitor_from_archive = max(self.archive.values(), key=lambda x: x['fitness'] if x['fitness'] is not None else -1)
        best_competitor_from_population = max(competitors, key=lambda x: x['fitness'] if x['fitness'] is not None else -1)
    
        # Calculate scores for both competitors
        competitor_scores = []
        for competitor in competitors:
            fitness_score = competitor['fitness']
            novelty_score = 1 / (archive_size + 1)  # Approximate novelty based on archive size
    
            # Combine scores using the calculated weights
            combined_score = (fitness_weight * fitness_score) + (novelty_weight * novelty_score)
            competitor_scores.append((combined_score, competitor))
    
        # Select the competitor with the highest combined score
        selected_competitor = max(competitor_scores)[1]
    
        # Compare with the best competitor from the archive
        if selected_competitor['fitness'] > best_competitor_from_archive['fitness']:
            return selected_competitor
        else:
            return best_competitor_from_archive

