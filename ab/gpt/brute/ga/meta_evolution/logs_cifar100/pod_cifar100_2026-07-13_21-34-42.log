```python
    def combine_genes(self, gene_name, parent1_value, parent2_value, crossover_point, gene_index, total_genes):
        if gene_index < crossover_point:
            return parent1_value
        
        if gene_name in ["dropout_prob", "fc_dropout"]:
            # Invert dropout probabilities to explore opposite regularization strategies
            if random.random() < 0.5:
                return parent1_value
            else:
                # Combine with a slight preference towards larger dropout rates for better robustness
                return max(parent1_value, parent2_value)
        
        elif gene_name in ["lr", "momentum"]:
            # Randomly choose between parent learning rates or momentums
            if random.random() < 0.5:
                return parent1_value
            else:
                return parent2_value
        
        elif gene_name in ["kernel_size", "n_blocks"]:
            # Hybridize kernel sizes or number of blocks
            combined_value = parent1_value + parent2_value
            # Ensure the combined value is within the valid range
            if combined_value in self.search_space[gene_name]:
                return combined_value
            else:
                # Choose the closest valid value
                return min(self.search_space[gene_name], key=lambda x: abs(x - combined_value))
        
        else:
            # Randomly choose between parent values
            if random.random() < 0.5:
                return parent1_value
            else:
                return parent2_value
