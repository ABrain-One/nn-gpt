    def mutate_gene(self, gene_name, current_value, possible_values):
        if possible_values:
            if gene_name in ['dropout_prob', 'fc_dropout']:
                # Invert the probability with a small chance
                if random.random() < 0.1:
                    return 1 - current_value
                else:
                    return random.choice(possible_values)
            elif gene_name == 'lr':
                # Adjust the learning rate by multiplying it with a factor slightly less than 1
                factor = 0.95
                new_lr = current_value * factor
                if new_lr in possible_values:
                    return new_lr
                else:
                    return min(possible_values, key=lambda x: abs(x - new_lr))
            else:
                # Select a random value from the possible choices
                return random.choice(possible_values)
        return current_value
