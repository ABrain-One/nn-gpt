def mutate_gene(self, gene_name, current_value, possible_values):
    if not possible_values:
        return current_value
    
    # Prefer mutations that are closer to the current value
    sorted_possible_values = sorted(possible_values, key=lambda x: abs(x - current_value))
    
    # Randomly select one of the closest possible values
    new_value = random.choice(sorted_possible_values[:min(3, len(sorted_possible_values))])
    
    return new_value
