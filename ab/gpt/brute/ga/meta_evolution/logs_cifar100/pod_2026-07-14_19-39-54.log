def mutate_gene(self, gene_name, current_value, possible_values):
    if possible_values:
        # Choose a mutation strategy based on the type of gene
        if isinstance(current_value, int):
            # Integer mutations can be biased towards nearby values
            mutation_range = 5
            new_value = current_value + random.randint(-mutation_range, mutation_range)
            return max(min(new_value, possible_values[-1]), possible_values[0])
        elif isinstance(current_value, float):
            # Float mutations can also be biased towards nearby values
            mutation_range = 0.1
            new_value = current_value + random.uniform(-mutation_range, mutation_range)
            return max(min(new_value, possible_values[-1]), possible_values[0])
        elif isinstance(current_value, str):
            # String mutations can shuffle possible values
            possible_values_list = list(possible_values)
            random.shuffle(possible_values_list)
            return possible_values_list[random.randint(0, len(possible_values_list) - 1)]
    return current_value
