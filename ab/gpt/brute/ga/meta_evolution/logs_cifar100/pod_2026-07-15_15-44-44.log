def mutate_gene(self, gene_name, current_value, possible_values):
    if possible_values:
        if gene_name == 'dropout_prob' or gene_name == 'fc_dropout':
            return random.uniform(max(0.0, current_value - 0.1), min(1.0, current_value + 0.1))
        elif gene_name == 'lr':
            return random.uniform(max(0.0001, current_value * 0.5), min(1.0, current_value * 2.0))
        elif gene_name == 'momentum':
            return random.uniform(max(0.0, current_value - 0.1), min(1.0, current_value + 0.1))
        else:
            return random.choice([current_value, random.choice(possible_values)])
    return current_value
