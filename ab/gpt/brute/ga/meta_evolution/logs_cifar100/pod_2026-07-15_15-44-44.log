def mutate_gene(self, gene_name, current_value, possible_values):
    if possible_values:
        # Determine the type of current value to handle different mutations appropriately
        if isinstance(current_value, bool):
            return not current_value
        elif isinstance(current_value, int) or isinstance(current_value, float):
            mutation_range = (current_value * 0.9, current_value * 1.1)
            return max(mutation_range[0], min(mutation_range[1], random.gauss(current_value, current_value * 0.1)))
        elif isinstance(current_value, str):
            possible_values.remove(current_value)
            return random.choice(possible_values)
    return current_value
