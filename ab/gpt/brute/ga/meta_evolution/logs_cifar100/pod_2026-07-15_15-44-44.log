def mutate_gene(self, gene_name, current_value, possible_values):
    if not possible_values:
        return current_value
    
    if isinstance(current_value, int) or isinstance(current_value, float):
        if len(possible_values) == 1:
            return current_value
        
        mutation_range = max(possible_values) - min(possible_values)
        new_value = current_value + (mutation_range * (random.random() - 0.5))
        new_value = max(min(new_value, max(possible_values)), min(possible_values))
        return round(new_value, 4)
    
    if isinstance(current_value, str):
        possible_values = list(set(possible_values))  # Remove duplicates
        if len(possible_values) == 1:
            return current_value
        
        return random.choice(possible_values)
    
    return random.choice(possible_values)
```
