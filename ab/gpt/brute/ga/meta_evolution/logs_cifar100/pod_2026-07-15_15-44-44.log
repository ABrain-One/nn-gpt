def select_competitor(self, competitors):
    # Add more sophisticated selection criteria here
    # For example, consider diversity in the population
    fitness_scores = [x['fitness'] for x in competitors if x['fitness'] is not None]
    if len(fitness_scores) == 0:
        return max(competitors, key=lambda x: x['fitness'] if x['fitness'] is not None else -1)
    
    avg_fitness = sum(fitness_scores) / len(fitness_scores)
    selected = []
    for competitor in competitors:
        if competitor['fitness'] is not None:
            if competitor['fitness'] > avg_fitness:
                selected.append(competitor)
        else:
            selected.append(competitor)
    
    if len(selected) > 0:
        return max(selected, key=lambda x: x['fitness'] if x['fitness'] is not None else -1)
    else:
        return max(competitors, key=lambda x: x['fitness'] if x['fitness'] is not None else -1)
