    def combine_genes(self, gene_name, parent1_value, parent2_value, crossover_point, gene_index, total_genes):
        possible_values = self.search_space[gene_name]

        if gene_name == "dropout_prob":
            # Interpolate between parent probabilities
            new_value = (parent1_value + parent2_value) / 2
            # Snap to nearest valid value
            return min(possible_values, key=lambda x: abs(x - new_value))

        elif gene_name == "lr":
            # Average learning rates but snap to nearest valid value
            new_value = (parent1_value + parent2_value) / 2
            return min(possible_values, key=lambda x: abs(x - new_value))

        elif gene_name == "momentum":
            # Interpolate momentum values
            new_value = (parent1_value + parent2_value) / 2
            return min(possible_values, key=lambda x: abs(x - new_value))

        elif gene_name == "activation":
            # Choose the most common activation type among parents
            parent1_activation = parent1_value
            parent2_activation = parent2_value
            if parent1_activation == parent2_activation:
                return parent1_activation
            else:
                return random.choice([parent1_activation, parent2_activation])

        elif gene_name == "kernel_size":
            # Select the kernel size that maximizes the difference between parents
            parent1_kernel = parent1_value
            parent2_kernel = parent2_value
            if parent1_kernel == parent2_kernel:
                return random.choice([parent1_kernel, parent2_kernel])
            else:
                return max(parent1_kernel, parent2_kernel)

        elif gene_name == "pooling_type":
            # Choose the most common pooling type among parents
            parent1_pooling = parent1_value
            parent2_pooling = parent2_value
            if parent1_pooling == parent2_pooling:
                return parent1_pooling
            else:
                return random.choice([parent1_pooling, parent2_pooling])

        elif gene_name == "conv_type":
            # Choose the most common convolution type among parents
            parent1_conv = parent1_value
            parent2_conv = parent2_value
            if parent1_conv == parent2_conv:
                return parent1_conv
            else:
                return random.choice([parent1_conv, parent2_conv])

        elif gene_name == "norm_type":
            # Choose the most common normalization type among parents
            parent1_norm = parent1_value
            parent2_norm = parent2_value
            if parent1_norm == parent2_norm:
                return parent1_norm
            else:
                return random.choice([parent1_norm, parent2_norm])

        elif gene_name == "optimizer_type":
            # Choose the most common optimizer type among parents
            parent1_optim = parent1_value
            parent2_optim = parent2_value
            if parent1_optim == parent2_optim:
                return parent1_optim
            else:
                return random.choice([parent1_optim, parent2_optim])

        else:
            # Default to simple one-point crossover for other genes
            if gene_index < crossover_point:
                return parent1_value
            return parent2_value
