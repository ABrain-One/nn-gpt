        if mutation_strategy == 'inversion':
            # Invert a subset of genes
            inverted_indices = random.sample(range(len(possible_values)), random.randint(1, len(possible_values)//2))
            inverted_values = [possible_values[i] for i in inverted_indices]
            inverted_values.reverse()

            # Create a new list with inverted values
            new_possible_values = []
            j = 0
            for i in range(len(possible_values)):
                if i in inverted_indices:
                    new_possible_values.append(inverted_values[j])
                    j += 1
                else:
                    new_possible_values.append(possible_values[i])

            # Select a new value from the modified list
            return random.choice(new_possible_values)

        elif mutation_strategy == 'random':
            # Randomly select a new value
            return random.choice(possible_values)
