    def mutate_gene(self, gene_name, current_value, possible_values):
        if possible_values:
            # Invert the sign of the value if it's numerical
            if isinstance(current_value, (int, float)):
                inverted_value = -current_value
                if inverted_value in possible_values:
                    return inverted_value
            
            # Momentum tracking
            if hasattr(self, f"last_mutation_{gene_name}"):
                last_mutated_value = getattr(self, f"last_mutation_{gene_name}")
                momentum = 0.5  # Adjust momentum factor as needed
                new_value = current_value + momentum * (last_mutated_value - current_value)
                new_value = round(new_value, 2)  # Round to maintain consistency
                if new_value in possible_values:
                    return new_value
            
            # Hybridize with another randomly selected gene
            competitor = random.choice(list(self.population.values()))
            competitor_value = competitor[gene_name]
            hybrid_value = (current_value + competitor_value) / 2
            if hybrid_value in possible_values:
                return hybrid_value
        
        # Fall back to random choice if no valid mutations are found
        return random.choice(possible_values)
