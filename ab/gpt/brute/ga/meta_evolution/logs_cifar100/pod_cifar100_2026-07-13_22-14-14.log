    def _create_random_chromosome(self):
        chromosome = {}
        for gene_name, possible_values in self.search_space.items():
            if gene_name == 'activation' and 'LeakyReLU' in possible_values:
                # Bias towards LeakyReLU if it's in the search space
                top_values = ['LeakyReLU', 'ReLU', 'GELU', 'SiLU']
                chromosome[gene_name] = random.choices(top_values, weights=[0.3, 0.2, 0.2, 0.3])[0]
            elif gene_name == 'lr' and 0.001 in possible_values:
                # Bias towards lr=0.001 if it's in the search space
                top_values = [0.001, 0.005, 0.01, 0.008]
                chromosome[gene_name] = random.choices(top_values, weights=[0.3, 0.2, 0.2, 0.3])[0]
            else:
                chromosome[gene_name] = random.choice(possible_values)

        # Ensure diversity by sampling from both archive and population
        archive_samples = random.sample(list(self.archive.values()), min(len(self.archive), 5))
        population_samples = random.sample(self.population, min(len(self.population), 5))

        for gene_name in self.search_space:
            if chromosome[gene_name] in [sample[gene_name] for sample in archive_samples]:
                continue
            if chromosome[gene_name] in [sample[gene_name] for sample in population_samples]:
                continue

            # If the value is still present in archive or population samples, mutate it slightly
            if random.random() < 0.1:
                chromosome[gene_name] = self.mutate_gene(gene_name, chromosome[gene_name], possible_values)

        return chromosome
