    def select_competitor(self, competitors):
        archive_probability = 0.3
        population_probability = 0.7
        archive_coverage = len(set((c['chromosome']['n_blocks'] for c in self.archive.values()))) / len(self.search_space['n_blocks'])
        if archive_coverage < 0.5:
            archive_probability *= 2
            population_probability /= 2
        if all((comp['fitness'] is None or comp['fitness'] < 0.5 for comp in competitors)):
            archive_probability = 0.7
            population_probability = 0.3
        if random.random() < archive_probability:
            return random.choice(list(self.archive.values()))
        else:
            return random.choice(competitors)
