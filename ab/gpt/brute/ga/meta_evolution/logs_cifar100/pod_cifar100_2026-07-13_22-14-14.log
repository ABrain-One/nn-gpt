    def mutate_gene(self, gene_name, current_value, possible_values):
        mutation_rate = 0.15
        if possible_values:
            if random.random() < mutation_rate:
                return random.choice(possible_values)
            else:
                return current_value
        if isinstance(current_value, (int, float, np.integer, np.floating)):
            perturbation_factor = 0.1
            lower_bound = max(0, current_value - perturbation_factor)
            upper_bound = min(max(possible_values), current_value + perturbation_factor)
            return random.uniform(lower_bound, upper_bound)
        return random.choice(possible_values)
