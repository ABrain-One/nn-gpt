    def select_competitor(self, competitors):
        # Define probabilities for sampling from archive and population
        archive_probability = 0.3
        population_probability = 0.7
        
        # Adjust probabilities based on archive size
        if len(self.archive) < 10:
            archive_probability *= 1.5
            population_probability *= 0.5
        elif len(self.archive) > 50:
            archive_probability *= 0.5
            population_probability *= 1.5
        
        # Sample from archive if fitness is low
        if all(comp['fitness'] is None or comp['fitness'] < 0.5 for comp in competitors):
            archive_probability = 0.7
            population_probability = 0.3
        
        # Select competitor based on probabilities
        if random.random() < archive_probability:
            archive_competitors = list(self.archive.values())
            # Ensure selected competitor is not too similar to existing solutions
            while True:
                selected = random.choice(archive_competitors)
                if not self.is_too_similar(selected, competitors):
                    break
            return selected
        else:
            return random.choice(competitors)
    
    def is_too_similar(self, competitor, competitors):
        # Check if competitor is too similar to any solution in competitors
        for comp in competitors:
            if self.calculate_similarity(competitor, comp) > 0.8:
                return True
        return False
    
    def calculate_similarity(self, competitor1, competitor2):
        # Calculate similarity between two competitors based on their genes
        similarity = 0
        for gene in self.search_space:
            if competitor1[gene] == competitor2[gene]:
                similarity += 1
        return similarity / len(self.search_space)
