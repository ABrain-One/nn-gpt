def combine_genes(self, gene_name, parent1_value, parent2_value, crossover_point, gene_index, total_genes):
    if gene_index < crossover_point:
        child_value = parent1_value
    else:
        child_value = parent2_value

    # Add strategies to maintain genetic diversity and avoid premature convergence
    if random.random() < 0.1:  # Introduce small mutations during crossover
        child_value = self.mutate_gene(gene_name, child_value, self.search_space[gene_name])

    # Apply tournament selection to further diversify the offspring
    if random.random() < 0.2:  # Apply tournament selection with a certain probability
        competitors = [parent1_value, parent2_value]
        child_value = random.choice(competitors)

    return child_value

# Ensure the chromosome remains valid
child_chromo = {gene: self.combine_genes(gene, p1_chromo[gene], p2_chromo[gene], point, i, len(genes)) for i, gene in enumerate(genes)}
return self._sanitize_chromosome(child_chromo)
