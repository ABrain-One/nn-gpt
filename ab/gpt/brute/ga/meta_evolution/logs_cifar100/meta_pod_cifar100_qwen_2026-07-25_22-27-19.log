def mutate_gene(self, gene_name, current_value, possible_values):
    if possible_values:
        possible_values = list(set(possible_values))  # Remove duplicates
        if len(possible_values) == 1:
            return current_value  # If only one option left, no need to mutate

        # Introduce larger mutations with higher probability
        mutation_probability = 0.2 * self.mutation_rate  # Higher chance of big changes
        if random.random() < mutation_probability:
            return random.choice(possible_values)  # Randomly choose a different value

        # Regular mutation
        while True:
            mutated_value = random.choice(possible_values)
            if mutated_value != current_value:
                return mutated_value  # Ensure we get a different value

    return current_value
