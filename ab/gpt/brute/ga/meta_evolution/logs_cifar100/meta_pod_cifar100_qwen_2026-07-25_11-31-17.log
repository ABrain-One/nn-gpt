def _create_random_chromosome(self):
    chromosome = {}
    for key, values in self.search_space.items():
        if isinstance(values[0], int):
            # For integer values, choose a random integer within the range
            min_val, max_val = min(values), max(values)
            chromosome[key] = random.randint(min_val, max_val)
        elif isinstance(values[0], float):
            # For floating-point values, choose a random float within the range
            min_val, max_val = min(values), max(values)
            chromosome[key] = random.uniform(min_val, max_val)
        else:
            # For other types, choose a random element from the list
            chromosome[key] = random.choice(values)
    return chromosome
