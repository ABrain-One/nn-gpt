    def mutate_gene(self, gene_name, current_value, possible_values):
        # Use historical context to mutate genes
        history_key = f"{gene_name}_history"
        if hasattr(self, history_key):
            history = getattr(self, history_key)
            most_common = max(set(history), key=history.count)
        else:
            most_common = random.choice(possible_values)
    
        # Mutate towards the most common value
        if gene_name == "dropout_prob":
            possible_values_filtered = [0.2, 0.3, 0.4, 0.5]
            mutated_value = random.choice(possible_values_filtered)
        elif gene_name == "base_channels":
            possible_values_filtered = [16, 32, 64]
            mutated_value = random.choice(possible_values_filtered)
        elif gene_name == "n_blocks":
            possible_values_filtered = [2, 3, 4]
            mutated_value = random.choice(possible_values_filtered)
        elif gene_name in ["n_columns", "kernel_size"]:
            mutated_value = max([parent1_value, parent2_value], key=self.search_space[gene_name].count)
        elif gene_name in ["fc_dropout", "lr", "momentum"]:
            mutated_value = random.choice([parent1_value, parent2_value])
        elif gene_name == 'activation':
            favored_activations = ['SiLU']
            mutated_value = random.choice(favored_activations + [parent1_value, parent2_value])
        elif gene_name == 'pooling_type':
            favored_poolings = ['Avg']
            mutated_value = random.choice(favored_poolings + [parent1_value, parent2_value])
        elif gene_name == 'optimizer_type':
