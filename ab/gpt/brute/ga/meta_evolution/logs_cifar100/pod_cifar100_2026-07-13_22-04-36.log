    def _create_random_chromosome(self):
        # Start with the best-known architecture
        best_architecture = {
            "n_columns": 2,
            "base_channels": 32,
            "n_blocks": 4,
            "dropout_prob": 0.25,
            "fc_dropout": 0.25,
            "lr": 0.001,
            "momentum": 0.9,
            "activation": "SiLU",
            "kernel_size": 5,
            "pooling_type": "Max",
            "conv_type": "Standard",
            "norm_type": "InstanceNorm",
            "optimizer_type": "SGD"
        }
        
        # Create a new chromosome by combining elements from the best architecture with random values
        new_chromosome = {}
        for gene, value in best_architecture.items():
            if gene == "dropout_prob":
                # Ensure the dropout probability is always greater than 0.0
                new_chromosome[gene] = random.choice([0.2, 0.3, 0.4, 0.5])
            elif gene in ["base_channels", "n_blocks"]:
                # Choose a value from the best architecture's value
                new_chromosome[gene] = value
            else:
                # Randomly choose a value from the search space
                new_chromosome[gene] = random.choice(self.search_space[gene])
        
        return new_chromosome
