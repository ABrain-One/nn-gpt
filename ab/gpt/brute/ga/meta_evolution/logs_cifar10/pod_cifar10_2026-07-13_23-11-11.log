    def select_competitor(self, competitors):
        # Sort competitors by fitness in descending order
        sorted_competitors = sorted(competitors, key=lambda x: x['fitness'] if x['fitness'] is not None else -1, reverse=True)
        
        # Select the best competitor
        best_competitor = sorted_competitors[0]
        
        # Sample a competitor from the archive
        archive_competitor = random.choice(list(self.archive.values()))
        
        # Introduce a momentum term to favor competitors from previous generations
        momentum = 0.5
        archive_weight = momentum * archive_competitor['fitness'] if archive_competitor['fitness'] is not None else 0
        
        # Combine the weights of the best competitor and the archive competitor
        combined_weight = best_competitor['fitness'] + archive_weight
        
        # Normalize the weights
        normalized_weights = [best_competitor['fitness'] / combined_weight, archive_weight / combined_weight]
        
        # Select the competitor based on the normalized weights
        selected_competitor = random.choices([best_competitor, archive_competitor], weights=normalized_weights)[0]
        
        return selected_competitor
