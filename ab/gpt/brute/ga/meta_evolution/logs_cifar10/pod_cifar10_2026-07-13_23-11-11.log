    def mutate_gene(self, gene_name, current_value, possible_values):
        # Define the mutation strength
        mutation_strength = 0.1

        # Check if the gene name exists in the search space
        if gene_name not in self.search_space:
            return random.choice(possible_values)

        # Get the possible values for the gene
        valid_values = self.search_space[gene_name]

        # Determine the type of mutation
        if isinstance(current_value, (int, float, np.integer, np.floating)):
            # Generate a new value using Gaussian noise
            new_value = current_value + mutation_strength * np.random.randn()

            # Clamp the new value within the valid range
            new_value = max(min(new_value, max(valid_values)), min(valid_values))

            # Ensure the new value is one of the possible values
            new_value = min(possible_values, key=lambda x: abs(x - new_value))

        elif isinstance(current_value, str):
            # Select a new value randomly from the possible values
            new_value = random.choice(possible_values)

        else:
            # Fallback to random choice if the gene type is not supported
            new_value = random.choice(possible_values)

        return new_value
