    def _polynomial_interpolation(self, alpha, parent1_value, parent2_value, degree=2):
        """Perform polynomial interpolation between two values."""
        terms = [alpha**i * parent2_value + (1 - alpha)**i * parent1_value for i in range(degree + 1)]
        return sum(terms)

    def _combine_categorical_with_momentum(self, gene_name, parent1_value, parent2_value, momentum, momentum_decay=0.9):
        """Combine two categorical values with momentum."""
        if parent1_value == parent2_value:
            return parent1_value
        
        choices = [parent1_value, parent2_value]
        choice_weights = [momentum, 1 - momentum]
        
        # Apply momentum decay
        momentum *= momentum_decay
        
        # Combine choices based on momentum
        new_choice = random.choices(choices, weights=choice_weights, k=1)[0]
        
        return new_choice
```

