    def combine_genes(self, gene_name, parent1_value, parent2_value, crossover_point, gene_index, total_genes):
        # Get the possible values for the given gene
        possible_values = self.search_space[gene_name]

        # Initialize dictionaries to store the fitness history of each gene value
        fitness_history = {value: [] for value in possible_values}

        # Collect the fitness history for each gene value
        for cell in self.archive.values():
            if gene_name in cell:
                fitness_history[cell[gene_name]].append(cell['fitness'])

        # Calculate the average fitness for each gene value
        avg_fitness = {value: sum(fits) / len(fits) if fits else 0 for value, fits in fitness_history.items()}

        # Normalize the average fitness values to get probabilities
        total_avg_fitness = sum(avg_fitness.values())
        probabilities = {value: avg_fit / total_avg_fitness for value, avg_fit in avg_fitness.items()}

        # Select the gene value based on the calculated probabilities
        selected_value = random.choices(list(probabilities.keys()), weights=list(probabilities.values()))[0]

        return selected_value
