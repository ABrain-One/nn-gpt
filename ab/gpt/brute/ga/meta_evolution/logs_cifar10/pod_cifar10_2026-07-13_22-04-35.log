    def combine_genes(self, gene_name, parent1_value, parent2_value, crossover_point, gene_index, total_genes):
        # Randomly choose which parent's value to inherit
        choice = random.choice([parent1_value, parent2_value])

        # Coerce the chosen value to ensure it's valid
        possible_values = self.search_space[gene_name]
        if choice not in possible_values:
            choice = random.choice(possible_values)

        # Introduce hybridization by averaging the two choices
        hybrid_choice = (choice + random.choice([parent1_value, parent2_value])) / 2
        hybrid_choice = round(hybrid_choice) if isinstance(choice, int) else hybrid_choice

        # Invert the choice with a small probability
        if random.random() < 0.1:
            inverted_choice = 1 - choice if isinstance(choice, int) else random.choice([x for x in possible_values if x != choice])

        # Select the final choice based on hybridization and inversion
        final_choice = random.choice([choice, hybrid_choice, inverted_choice])

        # Ensure the final choice is within the valid range
        if final_choice not in possible_values:
            final_choice = random.choice(possible_values)

        return final_choice
