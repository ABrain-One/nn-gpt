            "kernel_size": 5,
            "pooling_type": "Max",
            "conv_type": "Standard",
            "norm_type": "InstanceNorm",
            "optimizer_type": "SGD"
        }
        
        new_chromosome = {}
        for gene_name, possible_values in self.search_space.items():
            # Calculate distance from SOTA value
            sota_value = sota_chromosome[gene_name]
            distances = [(abs(val - sota_value), val) for val in possible_values]
            sorted_distances = sorted(distances)
            
            # Weighted random selection
            weights = [dist[0] for dist in sorted_distances]
            selected_value = random.choices([dist[1] for dist in sorted_distances], weights=weights)[0]
            
            # Small chance to select completely random value
            if random.random() < 0.1:
                selected_value = random.choice(possible_values)
            
            new_chromosome[gene_name] = selected_value
        
        return new_chromosome
