    def _create_random_chromosome(self):
        # Start with the SOTA architecture
        sota_architecture = {
            "n_columns": 2,
            "base_channels": 32,
            "n_blocks": 4,
            "dropout_prob": 0.25,
            "fc_dropout": 0.25,
            "lr": 0.001,
            "momentum": 0.9,
            "activation": "SiLU",
            "kernel_size": 5,
            "pooling_type": "Max",
            "conv_type": "Standard",
            "norm_type": "InstanceNorm",
            "optimizer_type": "SGD"
        }
    
        # List of top-performing cells in the MAP-Elites archive
        top_cells = list(self.archive.values())[:5]
    
        # Create a new chromosome by combining elements from SOTA and top cells
        new_chromosome = {}
        for gene_name in self.search_space:
            possible_values = self.search_space[gene_name]
            if gene_name in sota_architecture:
                # Prefer values from the SOTA architecture but also allow for some randomness
                weights = [0.6, 0.4]  # Higher weight for SOTA values
                sources = [[sota_architecture[gene_name]], [cell[gene_name] for cell in top_cells]]
            else:
                weights = [0.5, 0.5]  # Equal weight for both sources
                sources = [[cell[gene_name] for cell in top_cells], possible_values]
    
            # Sample from both sources with weighted probabilities
            choice = random.choices(sources, weights=weights, k=1)[0]
            new_value = random.choice(choice)
    
            # Ensure the selected value is within the allowed range
            new_value = self._coerce_gene_value(gene_name, new_value)
            new_chromosome[gene_name] = new_value
    
        return new_chromosome
