        for gene_name in self.search_space:
            possible_values = self.search_space[gene_name]
            if gene_name in sota_architecture:
                # Prefer values from the SOTA architecture but allow for some variation
                if random.random() < 0.7:
                    new_value = random.choice([sota_architecture[gene_name]] + possible_values)
                else:
                    new_value = random.choice([cell[gene_name] for cell in top_cells] + possible_values)
            else:
                # Prefer values from top-performing cells
                new_value = random.choice([cell[gene_name] for cell in top_cells] + possible_values)
    
            # Ensure the selected value is within the allowed range
            new_value = self._coerce_gene_value(gene_name, new_value)
            new_chromosome[gene_name] = new_value
    
        return new_chromosome
