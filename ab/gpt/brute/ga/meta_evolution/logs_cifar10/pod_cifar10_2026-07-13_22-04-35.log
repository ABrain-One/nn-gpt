        # Calculate weights based on historical performance
        parent1_weight = self._get_performance_weight(parent1_value)
        parent2_weight = self._get_performance_weight(parent2_value)
        total_weight = parent1_weight + parent2_weight

        # Choose a value based on weighted probability
        if random.random() * total_weight < parent1_weight:
            choice = parent1_value
        else:
            choice = parent2_value

        # Apply hybridization if the gene supports it
        if isinstance(choice, tuple) and len(choice) == 2:
            choice = (choice[0], choice[1])

        # Invert the choice with a small probability
        if random.random() < 0.1:
            choice = self._invert_choice(choice, possible_values)

