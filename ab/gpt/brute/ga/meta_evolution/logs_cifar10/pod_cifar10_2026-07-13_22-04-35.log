```python
    def combine_genes(self, gene_name, parent1_value, parent2_value, crossover_point, gene_index, total_genes):
        possible_values = self.search_space[gene_name]
        momentum = self.archive.get(gene_name, {}).get('momentum', 0.5)
        
        if isinstance(parent1_value, (int, float, np.integer, np.floating)):
            # Polynomial interpolation for numerical values
            alpha = random.random()
            new_value = self._polynomial_interpolation(alpha, parent1_value, parent2_value, degree=2)
            new_value = min(possible_values, key=lambda x: abs(x - new_value))
        elif isinstance(parent1_value, str):
            # Combine categorical values with momentum
            new_value = self._combine_categorical_with_momentum(gene_name, parent1_value, parent2_value, momentum)
        else:
            # Random selection for other types
            new_value = random.choice(possible_values)
        
        return new_value
