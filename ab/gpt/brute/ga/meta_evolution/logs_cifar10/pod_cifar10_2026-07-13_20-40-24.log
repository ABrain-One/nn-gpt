    def select_competitor(self, competitors):
        # Define weights for fitness and rank
        fitness_weight = 0.7
        rank_weight = 0.3

        # Sort competitors by fitness in descending order
        sorted_competitors = sorted(competitors, key=lambda x: x['fitness'] if x['fitness'] is not None else -1, reverse=True)

        # Calculate total fitness and rank
        total_fitness = sum(max(comp['fitness'], 1e-10) for comp in sorted_competitors)
        total_rank = len(sorted_competitors)

        # Ensure we don't divide by zero
        if total_fitness <= 0:
            total_fitness = 1

        # Select competitor based on weighted fitness and rank
        rand_val = random.random() * total_fitness
        cumulative_fitness = 0
        for competitor in sorted_competitors:
            competitor['weighted_fitness'] = fitness_weight * competitor['fitness'] + rank_weight * (total_rank - sorted_competitors.index(competitor))
            cumulative_fitness += competitor['weighted_fitness']
            if rand_val <= cumulative_fitness:
                return competitor

        # Fallback in case of numerical issues
        return random.choice(competitors)
