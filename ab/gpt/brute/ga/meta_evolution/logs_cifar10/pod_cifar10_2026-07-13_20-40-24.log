```python
    def combine_genes(self, gene_name, parent1_value, parent2_value, crossover_point, gene_index, total_genes):
        if gene_index < crossover_point:
            return parent1_value
        
        # Hybridization strategies
        if isinstance(parent1_value, (int, float, np.integer, np.floating)):
            # Average values for numerical types
            combined_value = (parent1_value + parent2_value) / 2
        elif isinstance(parent1_value, str):
            # Choose between two strings (e.g., 'ReLU' or 'LeakyReLU')
            combined_value = random.choice([parent1_value, parent2_value])
        else:
            # Default to the original value if it's not a simple type
            combined_value = parent1_value
        
        # Inversion strategy
        if random.random() < 0.5:
            combined_value = self.invert_gene(combined_value)
        
        return combined_value

    def invert_gene(self, gene_value):
        # Invert the gene value for numerical types
        if isinstance(gene_value, (int, float, np.integer, np.floating)):
            if gene_value == 0:
                return 1e-8  # Avoid division by zero
            return 1 / gene_value
        # For boolean values, flip the state
        elif isinstance(gene_value, bool):
            return not gene_value
        # For string values, return a different option if applicable
        elif isinstance(gene_value, str):
            options = ['ReLU', 'GELU', 'LeakyReLU', 'SiLU']
            return options[(options.index(gene_value) + 1) % len(options)]
        # Default to the original value if it's not a simple type
        return gene_value

    def select_competitor(self, competitors):
        # Sample from both population and archive to encourage exploration
        archive_samples = random.choices(list(self.archive.values()), k=min(3, len(self.archive)))
        all_competitors = competitors + archive_samples
        return max(all_competitors, key=lambda x: x['fitness'] if x['fitness'] is not None else -1)
```
This implementation incorporates hybridization, inversion, and ensures that competitors are selected from both the population and the archive to promote diversity and exploration.
