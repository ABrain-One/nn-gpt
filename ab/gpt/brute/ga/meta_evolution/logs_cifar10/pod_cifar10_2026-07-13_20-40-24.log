    def combine_genes(self, gene_name, parent1_value, parent2_value, crossover_point, gene_index, total_genes):
        if gene_name in ['n_columns', 'n_blocks', 'base_channels']:
            # Numerical values
            if gene_index < crossover_point:
                return parent1_value
            else:
                avg_val = (parent1_value + parent2_value) / 2
                inv_val = -avg_val
                return random.choice([avg_val, inv_val])
        elif gene_name in ['dropout_prob', 'fc_dropout', 'lr', 'momentum']:
            # Numerical values with inversion
            if gene_index < crossover_point:
                return parent1_value
            else:
                avg_val = (parent1_value + parent2_value) / 2
                inv_val = -avg_val
                return random.choice([avg_val, inv_val])
        elif gene_name in ['activation', 'kernel_size', 'pooling_type', 'conv_type', 'norm_type', 'optimizer_type']:
            # Categorical values with inversion
            if gene_index < crossover_point:
                return parent1_value
            else:
                choices = self.search_space[gene_name]
                inv_choice = random.choice(choices)
                return random.choice([parent1_value, inv_choice])
        else:
            raise ValueError(f"Unknown gene name: {gene_name}")
