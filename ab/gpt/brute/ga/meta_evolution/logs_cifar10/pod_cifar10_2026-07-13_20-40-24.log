    def mutate_gene(self, gene_name, current_value, possible_values):
        if possible_values:
            if gene_name in ['dropout_prob', 'fc_dropout', 'lr', 'momentum']:
                # Introduce small perturbation towards the current value
                perturbation = random.choice([-0.01, 0.01]) if current_value > 0 else random.choice([-0.01, 0.01])
                new_value = current_value + perturbation
                # Ensure new value is within valid range
                new_value = min(max(new_value, 0), 1)
                # Invert to explore complementary values
                inv_value = 1 - new_value
                return random.choice([new_value, inv_value])
            else:
                # Select complementary or alternative options
                complement = random.choice([v for v in possible_values if v != current_value])
                return random.choice([complement, current_value])
        return current_value
