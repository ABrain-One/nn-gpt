def combine_genes(self, gene_name, parent1_value, parent2_value, crossover_point, gene_index, total_genes):
    child_value = parent1_value
    if gene_index >= crossover_point:
        child_value = parent2_value
    
    # Strategy to maintain genetic diversity: Occasionally swap values between parents
    if random.random() < 0.1:
        child_value = parent2_value if parent1_value == parent2_value else parent1_value
    
    # Ensure the combined value is within the valid range for the gene
    child_value = self._coerce_gene_value(gene_name, child_value)
    
    return child_value
