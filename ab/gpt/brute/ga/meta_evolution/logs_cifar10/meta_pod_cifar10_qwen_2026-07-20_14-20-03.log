def mutate_gene(self, gene_name, current_value, possible_values):
    mutated_chromo = chromosome.copy()
    for gene in self.search_space.keys():
        if random.random() < self.mutation_rate:
            possible_values = [v for v in self.search_space[gene] if v != mutated_chromo[gene]]
            if possible_values:
                # Apply more aggressive mutation
                mutation_factor = random.uniform(0.5, 1.5)
                index = random.randint(0, len(possible_values) - 1)
                mutated_value = possible_values[index]
                if isinstance(mutated_value, (int, float)):
                    mutated_value *= mutation_factor
                mutated_chromo[gene] = mutated_value
            else:
                mutated_chromo[gene] = current_value
    return self._sanitize_chromosome(mutated_chromo)
