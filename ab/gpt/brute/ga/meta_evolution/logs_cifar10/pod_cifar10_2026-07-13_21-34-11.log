            return current_value

        # Initialize history if it doesn't exist
        if not hasattr(self, 'mutation_history'):
            self.mutation_history = {}

        if gene_name not in self.mutation_history:
            self.mutation_history[gene_name] = {'direction': None, 'value': current_value}

        # Get the previous mutation direction and value
        prev_direction = self.mutation_history[gene_name]['direction']
        prev_value = self.mutation_history[gene_name]['value']

        # Determine whether to use momentum or random exploration
        if random.random() < 0.7:  # 70% chance to use momentum
            if prev_direction is not None:
                new_value = prev_value + prev_direction * 0.1
            else:
                new_value = current_value
        else:
            new_value = random.choice(possible_values)

        # Snap to the nearest valid value
        valid_values = self.search_space[gene_name]
        closest_value = min(valid_values, key=lambda x: abs(x - new_value))

        # Update the mutation history
        self.mutation_history[gene_name]['direction'] = new_value - closest_value
        self.mutation_history[gene_name]['value'] = closest_value

        return closest_value
