    def select_competitor(self, competitors):
        # Combine population and archive competitors
        combined_competitors = self.population + list(self.archive.values())

        # Calculate weights for each competitor
        weights = []
        for competitor in combined_competitors:
            fitness = competitor.get('fitness', -1)
            novelty = self.calculate_novelty(competitor)
            weight = fitness * novelty
            weights.append(weight)

        # Normalize weights
        total_weight = sum(weights)
        normalized_weights = [weight / total_weight for weight in weights]

        # Select competitor based on weighted probabilities
        selected_index = np.random.choice(range(len(combined_competitors)), p=normalized_weights)
        return combined_competitors[selected_index]

    def calculate_novelty(self, competitor):
        # Calculate novelty based on distance from other competitors in the archive
        distances = []
        for archived_competitor in self.archive.values():
            distance = self.calculate_distance(competitor, archived_competitor)
            distances.append(distance)
        average_distance = sum(distances) / len(distances)
        return 1 / (average_distance + 1)

    def calculate_distance(self, competitor1, competitor2):
        # Calculate Euclidean distance between two competitors
        keys = set(competitor1.keys()).union(set(competitor2.keys()))
        squared_diffs = [(competitor1.get(key, 0) - competitor2.get(key, 0)) ** 2 for key in keys]
        return sum(squared_diffs) ** 0.5
