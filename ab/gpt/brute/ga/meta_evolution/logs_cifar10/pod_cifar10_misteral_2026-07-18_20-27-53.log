def combine_genes(self, gene_name, parent1_chromo, parent2_chromo, crossover_point, gene_index, total_genes):
    child_chromo = {}
    for i, gene in enumerate(self.search_space.keys()):
        if i < crossover_point:
            child_chromo[gene] = parent1_chromo[gene]
        else:
            child_chromo[gene] = parent2_chromo[gene]

    # Strategies to maintain genetic diversity and avoid premature convergence
    for gene in child_chromosome:
        if np.random.random() < self.mutation_rate:
            possibles = [v for v in self.search_space[gene] if v not in (parent1_chromo[gene], parent2_chromo[gene])]
            child_chromo[gene] = self.mutate_gene(gene, child_chromo[gene], possibles)

    return self._sanitize_chromosome(child_chromo)
