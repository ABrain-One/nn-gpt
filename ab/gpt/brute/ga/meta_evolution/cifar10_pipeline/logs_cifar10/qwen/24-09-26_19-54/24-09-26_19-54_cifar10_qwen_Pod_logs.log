    def combine_genes(self, gene_name, parent1_value, parent2_value, crossover_point, gene_index, total_genes):
        if gene_index < crossover_point:
            # Standard crossover
            return parent1_value
        else:
            # Novel combination strategy: Introduce randomness and diversity
            if random.random() < 0.5:
                # Swap with another parameter within the same group
                swap_group = ['n_columns', 'base_channels', 'n_blocks', 'dropout_prob', 'fc_dropout',
                              'lr', 'momentum', 'activation', 'kernel_size', 'pooling_type', 'conv_type', 'norm_type']
                swap_group.remove(gene_name)
                swap_group.remove('optimizer_type')
                if swap_group:
                    swap_index = random.randint(0, len(swap_group) - 1)
                    swap_key = swap_group[swap_index]
                    swap_possible_values = list(self.search_space[swap_key])
                    swap_value = self._coerce_gene_value(swap_key, random.choice(swap_possible_values))
                    return swap_value
            else:
                # Mutate slightly with high probability
                possible_values = list(self.search_space[gene_name])
                choice_probability = 0.75
                if random.random() < choice_probability:
                    return random.choice(possible_values)
                else:
                    return parent2_value
