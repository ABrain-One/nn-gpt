def combine_genes(self, gene_name, parent1_value, parent2_value, crossover_point, gene_index, total_genes):
    if gene_index < crossover_point:
        return parent1_value
    else:
        return parent2_value

# Introduce a strategy to maintain genetic diversity and avoid premature convergence
def combine_genes(self, gene_name, parent1_value, parent2_value, crossover_point, gene_index, total_genes):
    # Use a simple linear combination with a random factor to introduce diversity
    alpha = random.uniform(0.3, 0.7)
    beta = 1 - alpha
    
    # Combine the two parent values using the alpha and beta factors
    combined_value = alpha * parent1_value + beta * parent2_value
    
    # Ensure the combined value falls within the valid range for the gene
    min_val, max_val = self.search_space[gene_name]
    combined_value = max(min_val, min(max_val, combined_value))
    
    return combined_value
