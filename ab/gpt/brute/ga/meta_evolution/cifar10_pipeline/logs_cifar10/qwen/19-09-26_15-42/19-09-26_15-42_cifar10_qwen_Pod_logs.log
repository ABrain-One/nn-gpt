    def _crossover(self, parent1_chromo, parent2_chromo):
        child_chromo = {}
        genes = list(self.search_space.keys())
        point = random.randint(1, len(genes) - 1)
        for i, gene in enumerate(genes):
            if gene == "activation" or gene == "optimizer_type":
                child_chromo[gene] = random.choice([parent1_chromo[gene], parent2_chromo[gene]])
            elif gene == "conv_type":
                child_chromo[gene] = random.choice(["Standard", "Depthwise"])
            else:
                child_chromo[gene] = self.combine_genes(gene, parent1_chromo[gene], parent2_chromo[gene], point, i, len(genes))
        return child_chromo
