    def combine_genes(self, gene_name, parent1_value, parent2_value, crossover_point, gene_index, total_genes):
        if gene_name == "architecture":
            # Use different mechanisms for combining architectures
            if gene_index < crossover_point:
                # Cross layer types and numbers
                return parent1_value + "_" + parent2_value
            else:
                # Randomly choose from either parent's architecture
                return random.choice([parent1_value, parent2_value])
        elif gene_name in ["base_channels", "dropout_prob", "fc_dropout", "lr", "momentum"]:
            # Use arithmetic mean or geometric mean for numeric parameters
            if gene_index < crossover_point:
                return (parent1_value + parent2_value) / 2
            else:
                # Use one of the parents' value with some randomness
                choice = random.choice([parent1_value, parent2_value])
                mutation_probability = self.mutation_rate * 2
                if random.random() < mutation_probability:
                    return self._coerce_gene_value(gene_name, choice * random.uniform(0.8, 1.2))
                return choice
        elif gene_name in ["activation", "kernel_size", "pooling_type", "conv_type", "norm_type", "optimizer_type"]:
            # Use union or intersection of sets for categorical parameters
            if gene_index < crossover_point:
                return parent1_value.union(parent2_value)
            else:
                # Randomly choose from either parent's value
                return random.choice([parent1_value, parent2_value])
