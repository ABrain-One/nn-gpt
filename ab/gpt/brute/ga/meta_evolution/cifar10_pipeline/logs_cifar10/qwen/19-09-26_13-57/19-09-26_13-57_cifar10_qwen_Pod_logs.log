def combine_genes(self, gene_name, parent1_value, parent2_value, crossover_point, gene_index, total_genes):
    if gene_index < crossover_point:
        return parent1_value
    else:
        return parent2_value

# Improved version with genetic diversity and exploration strategies
def combine_genes(self, gene_name, parent1_value, parent2_value, crossover_point, gene_index, total_genes):
    if gene_index < crossover_point:
        # Simple crossover
        return parent1_value
    else:
        # More complex crossover strategies to increase diversity
        if gene_name == "base_channels" or gene_name == "n_blocks":
            # Randomly choose between parents' values with a slight bias towards the larger value
            if parent1_value > parent2_value:
                return parent1_value
            else:
                return parent2_value
        elif gene_name == "activation" or gene_name == "conv_type":
            # Cycle through possible values using a shift based on gene index
            possible_values = self.search_space[gene_name]
            shifted_index = (gene_index + crossover_point) % len(possible_values)
            return possible_values[shifted_index]
        elif gene_name == "dropout_prob" or gene_name == "fc_dropout":
            # Interpolate between parent values with a small step size
            alpha = 0.1
            return (1 - alpha) * parent1_value + alpha * parent2_value
        elif gene_name == "lr" or gene_name == "momentum":
            # Use a geometric mean approach
            return (parent1_value ** 0.5) * (parent2_value ** 0.5)
        elif gene_name == "kernel_size" or gene_name == "pooling_type" or gene_name == "norm_type" or gene_name == "optimizer_type":
            # Randomly choose between parents' values with a slight bias towards the first parent
            if random.random() < 0.6:
                return parent1_value
            else:
                return parent2_value
