def combine_genes(self, gene_name, parent1_value, parent2_value, crossover_point, gene_index, total_genes):
    if gene_index < crossover_point:
        return parent1_value
    else:
        return parent2_value

    # Additional strategies to maintain genetic diversity and avoid premature convergence
    if gene_name == "activation":
        if parent1_value == "ReLU" and parent2_value == "GELU":
            return random.choice(["ReLU", "GELU"])
        elif parent1_value == "LeakyReLU" and parent2_value == "SiLU":
            return random.choice(["LeakyReLU", "SiLU"])
        else:
            return random.choice([parent1_value, parent2_value])

    if gene_name == "kernel_size":
        if abs(parent1_value - parent2_value) > 1:
            return random.choice([parent1_value, parent2_value])
        else:
            return random.choice([parent1_value - 1, parent1_value + 1])

    if gene_name == "dropout_prob":
        if abs(parent1_value - parent2_value) > 0.05:
            return random.choice([parent1_value, parent2_value])
        else:
            return random.choice([parent1_value - 0.05, parent1_value + 0.05])

    if gene_name == "lr":
        if abs(parent1_value - parent2_value) > 0.001:
            return random.choice([parent1_value, parent2_value])
        else:
            return random.choice([parent1_value - 0.001, parent1_value + 0.001])

    if gene_name == "momentum":
        if abs(parent1_value - parent2_value) > 0.03:
            return random.choice([parent1_value, parent2_value])
        else:
            return random.choice([parent1_value - 0.03, parent1_value + 0.03])

    if gene_name == "optimizer_type":
        if parent1_value == "SGD" and parent2_value == "AdamW":
            return random.choice(["SGD", "AdamW"])
        elif parent1_value == "RMSprop" and parent2_value == "AdamW":
            return random.choice(["RMSprop", "AdamW"])
        else:
            return random.choice([parent1_value, parent2_value])
