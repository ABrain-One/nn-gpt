    def combine_genes(self, gene_name, parent1_value, parent2_value, crossover_point, gene_index, total_genes):
        # Force exploration by randomly selecting a combination with a certain probability
        if random.random() < 0.2:
            combined_value = random.choice([parent1_value, parent2_value])
        else:
            combined_value = parent1_value if gene_index < crossover_point else parent2_value
        
        # Introduce randomness in activation types to break out of local minima
        if gene_name == 'activation':
            alternatives = ['ReLU', 'GELU', 'LeakyReLU', 'SiLU']
            alternatives.remove(parent1_value)
            alternatives.remove(parent2_value)
            if alternatives:
                combined_value = random.choice(alternatives)
        
        # Introduce randomness in dropout probabilities to avoid premature convergence
        if gene_name == 'dropout_prob' or gene_name == 'fc_dropout':
            low_range = 0.05
            high_range = 0.3
            combined_value = random.uniform(low_range, high_range)
        
        # Introduce randomness in learning rates to explore different optimization paths
        if gene_name == 'lr':
            low_range = 0.001
            high_range = 0.01
            combined_value = random.uniform(low_range, high_range)
        
        # Introduce randomness in momentum values to prevent oscillation
        if gene_name == 'momentum':
            low_range = 0.75
            high_range = 0.95
            combined_value = random.uniform(low_range, high_range)
        
        return combined_value
