def _create_random_chromosome(self):
    chromosome = {}
    for key, values in self.search_space.items():
        # Randomly choose a value from the search space
        value = random.choice(values)
        
        # Introduce randomness by mutating the chosen value
        mutation_probability = 0.3  # Higher mutation rate to encourage exploration
        if random.random() < mutation_probability:
            possible_values = list(set(values) - set([value]))
            if possible_values:
                value = random.choice(possible_values)
                
        chromosome[key] = value
        
    return chromosome
```
