    def select_competitor(self, competitors):
        k = 3
        competitors = random.sample(self.population, min(k, len(self.population)))
        best_fit = max(competitors, key=lambda x: x['fitness'] if x['fitness'] is not None else -1)
        other_fitnesses = sorted([x['fitness'] for x in competitors if x['fitness'] is not None], reverse=True)
        if other_fitnesses[0] == best_fit['fitness']:
            return best_fit
        elif other_fitnesses[0] > best_fit['fitness']:
            selection_probabilities = [max(x['fitness'], 0) / sum(max(c['fitness'], 0) for c in competitors) for c in competitors]
            return random.choices(competitors, weights=selection_probabilities)[0]
        else:
            return random.choice(competitors)
