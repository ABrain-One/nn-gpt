    def combine_genes(self, gene_name, parent1_value, parent2_value, crossover_point, gene_index, total_genes):
        if gene_index < crossover_point:
            child_value = parent1_value
        else:
            child_value = parent2_value
        
        # Add randomness to the crossover point to increase diversity
        if random.random() < 0.1:
            child_value = random.choice([parent1_value, parent2_value])
        
        # Mutate the chosen value with higher probability to escape local minima
        if random.random() < self.mutation_rate * 3:
            possibles = [v for v in self.search_space[gene_name] if v != child_value]
            child_value = random.choice(possibles)
        
        return child_value
