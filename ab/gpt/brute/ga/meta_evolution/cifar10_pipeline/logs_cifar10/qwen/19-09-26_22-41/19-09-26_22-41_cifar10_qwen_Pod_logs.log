def combine_genes(self, gene_name, parent1_value, parent2_value, crossover_point, gene_index, total_genes):
    if gene_index < crossover_point:
        return parent1_value
    else:
        return parent2_value

# Additional strategies to maintain genetic diversity and avoid premature convergence
def combine_genes(self, gene_name, parent1_value, parent2_value, crossover_point, gene_index, total_genes):
    if gene_index < crossover_point:
        return parent1_value
    else:
        return parent2_value

# Introduce additional strategies to enhance exploration
if gene_index % 2 == 0:
    return parent1_value
else:
    return parent2_value

# Further diversification
if gene_name == 'activation':
    if parent1_value != parent2_value:
        return random.choice(['ReLU', 'GELU', 'LeakyReLU', 'SiLU'])
    else:
        return parent1_value

# Aggressive exploration using non-deterministic strategies
if random.random() < 0.1:
    return random.choice(self.search_space[gene_name])
else:
    if gene_index < crossover_point:
        return parent1_value
    else:
        return parent2_value
