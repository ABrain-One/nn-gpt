    def combine_genes(self, gene_name, parent1_value, parent2_value, crossover_point, gene_index, total_genes):
        if gene_index < crossover_point:
            # Cross-over strategy to maintain genetic diversity
            if isinstance(parent1_value, str) and isinstance(parent2_value, str):
                options = [parent1_value, parent2_value]
                return random.choice(options)
            elif isinstance(parent1_value, float) and isinstance(parent2_value, float):
                # Use arithmetic mean with added noise to encourage exploration
                noise = random.uniform(-0.1, 0.1)
                return (parent1_value + parent2_value) / 2 + noise
            else:
                return parent1_value
        else:
            # Mutation to introduce novelty and prevent premature convergence
            mutation_probability = 0.15
            if random.random() < mutation_probability:
                if isinstance(parent1_value, str):
                    possible_values = [v for v in self.search_space[gene_name] if v != parent1_value]
                    new_value = random.choice(possible_values)
                    while new_value == parent1_value:
                        new_value = random.choice(possible_values)
                    return new_value
                elif isinstance(parent1_value, float):
                    # Use Gaussian mutation with adjusted standard deviation
                    std_dev = 0.05
                    mutation = random.gauss(0, std_dev)
                    new_value = parent1_value + mutation
                    return max(min(new_value, self.search_space[gene_name][-1]), self.search_space[gene_name][0])
            return parent1_value
