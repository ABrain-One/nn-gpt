def mutate_gene(self, gene_name, current_value, possible_values):
    if possible_values:
        choices = list(set(possible_values) - set([current_value]))
        if choices:
            mutation_probability = self.mutation_rate * 2  # Increase mutation probability
            if random.random() < mutation_probability:
                new_value = random.choice(choices)
                if isinstance(new_value, int) or isinstance(new_value, float):
                    if new_value < current_value:
                        mutation_strength = random.uniform(1.2, 3.0)  # Aggressive strength for numerical values
                    else:
                        mutation_strength = random.uniform(0.2, 0.5)  # Gentle strength for numerical values
                    if isinstance(current_value, int) or isinstance(current_value, float):
                        new_value += mutation_strength * (new_value - current_value)
                        new_value = max(min(new_value, max(possible_values)), min(possible_values))  # Clamp value within bounds
                return new_value
    return current_value
