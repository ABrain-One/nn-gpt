def combine_genes(self, gene_name, parent1_value, parent2_value, crossover_point, gene_index, total_genes):
    if gene_index < crossover_point:
        # Cross-over strategy to maintain genetic diversity
        if isinstance(parent1_value, str) and isinstance(parent2_value, str):
            options = [parent1_value, parent2_value]
            return random.choice(options)
        elif isinstance(parent1_value, float) and isinstance(parent2_value, float):
            # Use weighted average with added noise to encourage exploration
            alpha = random.uniform(0.3, 0.7)
            noise = random.uniform(-0.1, 0.1)
            child_value = alpha * parent1_value + (1 - alpha) * parent2_value + noise
            return child_value
        else:
            return parent1_value
    else:
        # Mutation to introduce novelty 
        mutation_probability = 0.1
        if random.random() < mutation_probability:
            if isinstance(parent1_value, str):
                options = [v for v in self.search_space[gene_name] if v != parent1_value]
                if options:
                    return random.choice(options)
            elif isinstance(parent1_value, float):
                choices = list(set(range(int(parent1_value) - 1, int(parent1_value) + 2)) - {int(parent1_value)})
                if choices:
                    return random.choice(choices)
            elif isinstance(parent1_value, int):
                choices = list(set(range(max(1, parent1_value - 2), parent1_value + 3)) - {parent1_value})
                if choices:
                    return random.choice(choices)
        return parent1_value
