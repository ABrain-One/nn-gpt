    def combine_genes(self, gene_name, parent1_value, parent2_value, crossover_point, gene_index, total_genes):
        if gene_index < crossover_point:
            return parent1_value
        else:
            return parent2_value

        # Additional strategies to maintain genetic diversity and avoid premature convergence
        if gene_name == "architecture":
            if gene_index < crossover_point:
                return self._mutate(parent1_value)
            else:
                return self._mutate(parent2_value)
        
        if gene_name == "learning_rate":
            if gene_index < crossover_point:
                return parent1_value * 0.95 + parent2_value * 0.05
            else:
                return parent1_value * 0.05 + parent2_value * 0.95
        
        if gene_name == "dropout_prob":
            if gene_index < crossover_point:
                return parent1_value * 0.9 + parent2_value * 0.1
            else:
                return parent1_value * 0.1 + parent2_value * 0.9
        
        if gene_name == "optimizer_type":
            if gene_index < crossover_point:
                return parent1_value
            else:
                if parent1_value == parent2_value:
                    return random.choice(list(self.search_space["optimizer_type"]) - {parent1_value})
                else:
                    return parent2_value
