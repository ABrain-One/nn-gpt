    def combine_genes(self, gene_name, parent1_value, parent2_value, crossover_point, gene_index, total_genes):
        if gene_index < crossover_point[0]:
            child_value = parent1_value
        elif gene_index < crossover_point[1]:
            child_value = parent2_value
        else:
            child_value = parent1_value

        # Introduce diversity by randomly choosing between parents
        if random.random() > 0.5:
            child_value = parent1_value
        else:
            child_value = parent2_value

        # Mutate the chosen value to further explore the search space
        mutation_probability = self.mutation_rate * 2
        if random.random() < mutation_probability:
            possible_values = list(set(self.search_space[gene_name]) - set([child_value]))
            if possible_values:
                child_value = random.choice(possible_values)

        # Apply inversion mutation
        if random.random() < self.mutation_rate:
            inverted_child_value = parent1_value if child_value == parent2_value else parent2_value
            child_value = inverted_child_value

        # Ensure the child value is within the search space
        if child_value not in self.search_space[gene_name]:
            child_value = random.choice(self.search_space[gene_name])

        # Sanitize the chromosome to ensure validity
        child_chromo = self._sanitize_chromosome({gene_name: child_value})
        return child_chromo
