    def combine_genes(self, gene_name, parent1_value, parent2_value, crossover_point, gene_index, total_genes):
        if gene_index < crossover_point:
            child_value = parent1_value
        elif gene_index < crossover_point + (total_genes // 3):
            child_value = parent2_value
        else:
            child_value = parent1_value

        # Introduce diversity by randomly choosing between parents
        if random.random() > 0.5:
            child_value = parent1_value
        else:
            child_value = parent2_value

        # Mutate the chosen value to further explore the search space
        mutation_probability = self.mutation_rate * 2
        if random.random() < mutation_probability:
            possible_values = list(set(self.search_space[gene_name]) - set([child_value]))
            if possible_values:
                child_value = random.choice(possible_values)

        return child_value
