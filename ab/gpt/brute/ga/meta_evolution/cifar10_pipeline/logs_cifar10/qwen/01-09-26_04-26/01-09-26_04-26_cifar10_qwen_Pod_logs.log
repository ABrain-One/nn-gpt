    def _create_random_chromosome(self):
        # Introduce randomness in architecture design
        n_columns = random.choice(self.search_space["n_columns"])
        base_channels = random.choice(self.search_space["base_channels"])
        n_blocks = random.choice(self.search_space["n_blocks"])

        # Introduce architectural innovation
        convolutional_layers = []
        for _ in range(n_blocks):
            layer = {
                "type": random.choice(["Standard", "Depthwise"]),
                "channels": int(base_channels * (2 ** random.uniform(-0.5, 0.5))),
                "kernel_size": random.choice([1, 3, 5, 7]),
                "padding": random.choice([0, 1]),
                "stride": random.choice([1, 2]),
                "dilation": random.choice([1, 2]),
                "groups": 1 if random.random() < 0.5 else base_channels,
                "bias": random.choice([True, False]),
                "activation": random.choice(self.search_space["activation"]),
                "batch_norm": random.choice([True, False]),
                "dropout": random.choice([None, random.uniform(0.05, 0.5)]),
            }
            convolutional_layers.append(layer)

        # Add pooling layers
        pool_layers = []
        for _ in range(random.randint(0, 2)):
            pool_layer = {
                "type": random.choice(["Max", "Avg"]),
                "kernel_size": random.choice([2, 3]),
                "stride": random.choice([2, 3]),
                "padding": random.choice([0, 1]),
            }
            pool_layers.append(pool_layer)

        # Flatten and fully connected layer
        fc_layer = {
            "in_features": convolutional_layers[-1]["channels"] * pool_layers[-1]["kernel_size"]**2,
            "out_features": int(base_channels * (2 ** random.uniform(-0.5, 0.5))),
            "bias": True,
            "dropout": random.choice([None, random.uniform(0.05, 0.5)]),
        }

        # Combine all layers into a single chromosome
        chromosome = {
            "architecture": {
                "convolutional_layers": convolutional_layers,
                "pooling_layers": pool_layers,
                "fully_connected_layer": fc_layer,
            },
            "dropout_prob": random.choice(self.search_space["dropout_prob"]),
            "fc_dropout": random.choice(self.search_space["fc_dropout"]),
            "learning_rate": random.choice(self.search_space["lr"]),
            "momentum": random.choice(self.search_space["momentum"]),
            "optimizer_type": random.choice(self.search_space["optimizer_type"]),
        }

        return chromosome
