def combine_genes(self, gene_name, parent1_value, parent2_value, crossover_point, gene_index, total_genes):
    if gene_index < crossover_point:
        if isinstance(parent1_value, list) and isinstance(parent2_value, list):
            return self._sanitize_chromosome({gene_name: parent1_value[crossover_point:] + parent2_value[:crossover_point]})
        elif isinstance(parent1_value, dict) and isinstance(parent2_value, dict):
            return self._sanitize_chromosome({**parent1_value, **parent2_value})
        else:
            return parent1_value
    else:
        if isinstance(parent1_value, list) and isinstance(parent2_value, list):
            return self._sanitize_chromosome({gene_name: parent2_value[crossover_point:] + parent1_value[:crossover_point]})
        elif isinstance(parent1_value, dict) and isinstance(parent2_value, dict):
            return self._sanitize_chromosome({**parent2_value, **parent1_value})
        else:
            return parent2_value
