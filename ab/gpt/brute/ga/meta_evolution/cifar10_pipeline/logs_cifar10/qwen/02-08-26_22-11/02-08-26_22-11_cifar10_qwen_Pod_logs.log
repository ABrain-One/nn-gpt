def mutate_gene(self, gene_name, current_value, possible_values):
    if possible_values:
        choices = list(set(possible_values) - set([current_value]))
        if choices:
            mutation_probability = self.mutation_rate * 3  # Further increase mutation probability
            if random.random() < mutation_probability:
                if isinstance(current_value, list):
                    mutation_index = random.randint(0, len(current_value) - 1)
                    current_value[mutation_index] = random.choice(choices)
                elif isinstance(current_value, dict):
                    mutation_key = random.choice(list(current_value.keys()))
                    current_value[mutation_key] = random.choice(choices)
                else:
                    return random.choice(choices)
    return self._sanitize_chromosome({gene_name: current_value})
