    def combine_genes(self, gene_name, parent1_value, parent2_value, crossover_point, gene_index, total_genes):
        if gene_name == 'activation':
            # Alternate between ReLU and GELU to maintain diversity
            if parent1_value == 'ReLU' and parent2_value == 'GELU':
                return random.choice(['ReLU', 'GELU'])
            elif parent1_value == 'ReLU':
                return 'GELU'
            elif parent2_value == 'GELU':
                return 'ReLU'
            else:
                return random.choice([parent1_value, parent2_value])
        
        elif gene_name == 'kernel_size':
            # Use arithmetic mean to mix kernel sizes
            mean = int((parent1_value + parent2_value) / 2)
            return mean
        
        elif gene_name == 'optimizer_type':
            # Alternate between SGD and AdamW to maintain diversity
            if parent1_value == 'SGD' and parent2_value == 'AdamW':
                return random.choice(['SGD', 'AdamW'])
            elif parent1_value == 'SGD':
                return 'AdamW'
            elif parent2_value == 'AdamW':
                return 'SGD'
            else:
                return random.choice([parent1_value, parent2_value])
        
        elif gene_name == 'base_channels':
            # Scale base channels linearly
            return int(parent1_value * (1 + (parent2_value - parent1_value) * random.uniform(-0.2, 0.2)))
        
        elif gene_name == 'fc_dropout':
            # Mix dropout probabilities with some randomness
            return random.uniform(min(parent1_value, parent2_value), max(parent1_value, parent2_value))
        
        else:
            # Default behavior: alternate between two values
            return random.choice([parent1_value, parent2_value])
