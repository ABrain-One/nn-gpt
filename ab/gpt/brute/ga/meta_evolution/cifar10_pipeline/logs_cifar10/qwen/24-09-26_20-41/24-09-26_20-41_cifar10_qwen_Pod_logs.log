    def _create_random_chromosome(self):
        chromosome = {}
        for key, values in self.search_space.items():
            if key == 'activation':
                # Randomly choose between ReLU and GELU with higher probability to explore non-linear activations
                chromosome[key] = random.choices(['ReLU', 'GELU'], weights=[0.7, 0.3])[0]
            elif key == 'kernel_size':
                # Randomly choose between smaller and larger kernel sizes with higher probability to explore different scales
                chromosome[key] = random.choices([1, 3, 5, 7], weights=[0.1, 0.3, 0.4, 0.2])[0]
            elif key == 'optimizer_type':
                # Randomly choose between SGD and AdamW with higher probability to explore different optimization strategies
                chromosome[key] = random.choices(['SGD', 'AdamW'], weights=[0.5, 0.5])[0]
            elif key == 'base_channels':
                # Randomly choose between lower and higher channel counts with higher probability to explore different network depths
                chromosome[key] = random.choices([16, 32, 64], weights=[0.2, 0.5, 0.3])[0]
            elif key == 'fc_dropout':
                # Randomly choose between lower and higher dropout rates with higher probability to explore different regularization strengths
                chromosome[key] = random.choices([0.05, 0.1, 0.15, 0.2], weights=[0.2, 0.4, 0.3, 0.1])[0]
            else:
                chromosome[key] = random.choice(values)
        return chromosome
