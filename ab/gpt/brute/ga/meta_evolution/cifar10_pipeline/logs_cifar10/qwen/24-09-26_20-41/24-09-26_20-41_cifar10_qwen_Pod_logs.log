    def combine_genes(self, gene_name, parent1_value, parent2_value, crossover_point, gene_index, total_genes):
        if gene_name == 'activation':
            # Alternate between different activation functions to maintain diversity
            activations = ['ReLU', 'GELU', 'LeakyReLU', 'SiLU']
            return random.choice(activations)
        
        elif gene_name == 'kernel_size':
            # Use geometric mean to mix kernel sizes
            geometric_mean = round((parent1_value * parent2_value) ** 0.5)
            return geometric_mean
        
        elif gene_name == 'optimizer_type':
            # Cycle through optimizer types to maintain diversity
            optimizers = ['SGD', 'AdamW', 'RMSprop']
            next_optimizer_index = (optimizers.index(parent1_value) + 1) % len(optimizers)
            return optimizers[next_optimizer_index]
        
        elif gene_name == 'base_channels':
            # Exponentially scale base channels to avoid premature convergence
            return int(parent1_value * (1 + (parent2_value - parent1_value) * random.uniform(-0.1, 0.1)) ** 2)
        
        elif gene_name == 'fc_dropout':
            # Introduce more randomness in dropout probability mixing
            mixed_dropout = random.uniform(min(parent1_value, parent2_value), max(parent1_value, parent2_value))
            return max(0.05, min(mixed_dropout, 0.95))
        
        else:
            # Alternate between different values while introducing randomness
            choices = [parent1_value, parent2_value] + [random.choice(list(self.search_space[gene])) for _ in range(2)]
            return random.choice(choices)
