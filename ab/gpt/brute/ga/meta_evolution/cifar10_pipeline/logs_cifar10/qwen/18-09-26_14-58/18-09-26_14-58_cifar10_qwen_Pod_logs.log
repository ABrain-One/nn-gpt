def mutate_gene(self, gene_name, current_value, possible_values):
    mutation_probability = self.mutation_rate * 4  # Increase mutation probability even more
    if random.random() < mutation_probability:
        if isinstance(current_value, int):
            # Mutate integers by choosing a completely different value from the search space
            possible_values = list(set(possible_values) - set([current_value]))
            if possible_values:
                return random.choice(possible_values)
        elif isinstance(current_value, float):
            # Mutate floats to a completely different value within a larger range
            possible_values = [v for v in possible_values if v != current_value]
            if possible_values:
                new_value = random.choice(possible_values)
                return new_value
        elif isinstance(current_value, str):
            # Mutate strings to a completely different value from the search space
            possible_values = list(set(possible_values) - set([current_value]))
            if possible_values:
                return random.choice(possible_values)
    return current_value
