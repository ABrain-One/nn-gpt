def mutate_gene(self, gene_name, current_value, possible_values):
    mutation_probability = self.mutation_rate * 3  # Increase mutation probability further
    if random.random() < mutation_probability:
        if isinstance(current_value, int):
            # Mutate integers by changing their magnitude or sign
            if current_value > 0:
                return random.randint(-current_value, current_value)
            elif current_value < 0:
                return random.randint(current_value, -current_value)
            else:
                return random.choice([-abs(current_value), abs(current_value)])
        elif isinstance(current_value, float):
            # Mutate floats by adding/subtracting a larger value
            mutation_range = abs(current_value) * 0.1
            if mutation_range == 0:
                mutation_range = 0.1
            return current_value + random.uniform(-mutation_range, mutation_range)
        elif isinstance(current_value, str):
            # Mutate strings by swapping characters or replacing with similar ones
            if len(current_value) > 1:
                index1 = random.randint(0, len(current_value) - 1)
                index2 = random.randint(0, len(current_value) - 1)
                current_list = list(current_value)
                current_list[index1], current_list[index2] = current_list[index2], current_list[index1]
                return ''.join(current_list)
            else:
                return random.choice([v for v in possible_values if v != current_value])
        else:
            # Handle other types by randomly choosing another value
            return random.choice([v for v in possible_values if v != current_value])
    return current_value
