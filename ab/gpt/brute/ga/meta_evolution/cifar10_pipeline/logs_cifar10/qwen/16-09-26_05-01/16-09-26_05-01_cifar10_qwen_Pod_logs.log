    def mutate_gene(self, gene_name, current_value, possible_values):
        if possible_values:
            choices = list(set(possible_values) - set([current_value]))
            if choices:
                mutation_probability = self.mutation_rate * 3  # Further increase mutation probability
                if random.random() < mutation_probability:
                    new_value = random.choice(choices)
                    # Introduce a randomness in the choice to further explore the search space
                    if isinstance(new_value, (int, float)):
                        step_size = abs(new_value - current_value) / 4
                        sign = random.choice([-1, 1])
                        new_value += sign * step_size
                    elif isinstance(new_value, str):
                        options = set([new_value])
                        while len(options) == 1:
                            options.update(random.sample(choices, min(len(choices), 2)))
                        new_value = random.choice(list(options))
                    return new_value
        return current_value
