        if random.random() < self.mutation_rate * 2:
            child_value = self.mutate_gene(gene_name, child_value, self.search_space[gene_name])
        
        # Apply elitist selection to ensure high quality parents contribute
        if random.random() < 0.6:
            child_value = self.elitist_selection(child1_value, child2_value)
        
        # Break out of local minima by using a combination of arithmetic mean and random selection
        if random.random() < 0.1:
            alpha = random.uniform(0.5, 1.5)
            child_value = alpha * child_value + (1 - alpha) * random.choice([parent1_value, parent2_value])
        
        # Sanitize the child chromosome value
        sanitized_child_value = self._sanitize_chromosome(child_value)
        
        return sanitized_child_value
