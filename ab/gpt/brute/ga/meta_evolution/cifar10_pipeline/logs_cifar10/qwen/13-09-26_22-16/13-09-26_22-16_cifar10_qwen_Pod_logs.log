def combine_genes(self, gene_name, parent1_value, parent2_value, crossover_point, gene_index, total_genes):
    child_value = parent1_value if gene_index < crossover_point else parent2_value
    
    # Introduce variation to maintain genetic diversity
    if random.random() < 0.5:
        child_value = self.mutate_gene(gene_name, child_value, self.search_space[gene_name])
    
    # Randomly choose between parents or explore new possibilities
    if random.random() < 0.4:
