                child_value = parent2_value
        
        # Break out of local minima by using a combination of arithmetic mean and random selection
        if random.random() < 0.4:
            combined_value = (child_value + parent1_value + parent2_value) / 3
            if random.random() < 0.5:
                child_value = combined_value
            else:
                child_value = parent1_value if random.random() < 0.5 else parent2_value
        
        # Sanitize the chromosome before returning
        child_chromo = {gene_name: child_value}
        return self._sanitize_chromosome(child_chromo)
```
