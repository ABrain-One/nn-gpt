        if gene_index >= crossover_point:
            child_value = parent2_value
        
        # Introduce variation to maintain genetic diversity
        if random.random() < self.mutation_rate * 2:
            child_value = self.mutate_gene(gene_name, child_value, self.search_space[gene_name])
        
        # Apply elitist selection to ensure high quality parents contribute
        if parent1_value > parent2_value:
            child_value = max(parent1_value, child_value)
        else:
            child_value = min(parent1_value, child_value)
        
        # Avoid premature convergence by using a combination of arithmetic mean and random choice
        if random.random() < 0.5:
            child_value = (parent1_value + parent2_value) / 2
        elif random.random() < 0.3:
            child_value = random.choice([parent1_value, parent2_value])
        
        # Ensure the value stays within valid bounds
        child_value = self._coerce_gene_value(gene_name, child_value)
        
        return child_value
