    def combine_genes(self, gene_name, parent1_value, parent2_value, crossover_point, gene_index, total_genes):
        if gene_index < crossover_point:
            return parent1_value
        else:
            return parent2_value

        # Additional strategies to maintain genetic diversity and avoid premature convergence
        if gene_name == 'activation':
            possible_activations = ['ReLU', 'GELU', 'LeakyReLU', 'SiLU']
            if parent1_value != parent2_value:
                if random.random() < 0.2:
                    return random.choice(possible_activations)
        
        if gene_name == 'optimizer_type':
            possible_optimizers = ['SGD', 'AdamW', 'RMSprop']
            if parent1_value != parent2_value:
                if random.random() < 0.2:
                    return random.choice(possible_optimizers)
        
        if gene_name == 'kernel_size':
            possible_sizes = [1, 3, 5, 7]
            if parent1_value != parent2_value:
                if random.random() < 0.2:
                    return random.choice(possible_sizes)
        
        if gene_name == 'base_channels':
            possible_channels = [16, 32, 64]
            if parent1_value != parent2_value:
                if random.random() < 0.2:
                    return random.choice(possible_channels)
        
        if gene_name == 'n_blocks':
            possible_blocks = [2, 3, 4]
            if parent1_value != parent2_value:
                if random.random() < 0.2:
                    return random.choice(possible_blocks)
        
        if gene_name == 'n_columns':
            possible_columns = [2, 3, 4]
            if parent1_value != parent2_value:
                if random.random() < 0.2:
                    return random.choice(possible_columns)
        
        return parent1_value
