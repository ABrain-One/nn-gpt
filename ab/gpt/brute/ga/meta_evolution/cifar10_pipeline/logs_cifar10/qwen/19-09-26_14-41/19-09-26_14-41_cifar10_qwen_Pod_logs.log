    if gene_name == 'n_blocks':
        if abs(parent1_value - parent2_value) > 1:
            return random.choice([parent1_value, parent2_value])

    if gene_name == 'dropout_prob':
        delta = abs(parent1_value - parent2_value)
        if delta > 0.05:
            choice = random.choice([parent1_value, parent2_value])
            return choice + random.uniform(-delta / 2, delta / 2)

    if gene_name == 'fc_dropout':
        delta = abs(parent1_value - parent2_value)
        if delta > 0.05:
            choice = random.choice([parent1_value, parent2_value])
            return choice + random.uniform(-delta / 2, delta / 2)

    if gene_name == 'lr':
        delta = abs(parent1_value - parent2_value)
        if delta > 0.001:
            choice = random.choice([parent1_value, parent2_value])
            return choice * (1 + random.uniform(-delta / parent1_value, delta / parent1_value))

    if gene_name == 'momentum':
        delta = abs(parent1_value - parent2_value)
        if delta > 0.05:
            choice = random.choice([parent1_value, parent2_value])
            return choice + random.uniform(-delta / 2, delta / 2)

