    def combine_genes(self, gene_name, parent1_value, parent2_value, crossover_point, gene_index, total_genes):
        if gene_index < crossover_point:
            return parent1_value
        else:
            return parent2_value

        # Additional strategies to maintain genetic diversity and avoid premature convergence
        if gene_name == 'n_columns' and abs(parent1_value - parent2_value) > 1:
            return random.choice([parent1_value, parent2_value])
        
        if gene_name == 'base_channels' and abs(parent1_value - parent2_value) > 16:
            return random.choice([parent1_value, parent2_value])
        
        if gene_name == 'n_blocks' and abs(parent1_value - parent2_value) > 1:
            return random.choice([parent1_value, parent2_value])
        
        if gene_name == 'dropout_prob' and abs(parent1_value - parent2_value) > 0.1:
            return random.choice([parent1_value, parent2_value])
        
        if gene_name == 'fc_dropout' and abs(parent1_value - parent2_value) > 0.1:
            return random.choice([parent1_value, parent2_value])
        
        if gene_name == 'lr' and abs(parent1_value - parent2_value) > 0.001:
            return random.choice([parent1_value, parent2_value])
        
        if gene_name == 'momentum' and abs(parent1_value - parent2_value) > 0.05:
            return random.choice([parent1_value, parent2_value])
        
        if gene_name == 'activation':
            choices = list(set(self.search_space['activation']) - set([parent1_value, parent2_value]))
            if choices:
                return random.choice(choices)
        
        if gene_name == 'kernel_size':
            choices = list(set(self.search_space['kernel_size']) - set([parent1_value, parent2_value]))
            if choices:
                return random.choice(choices)
        
        if gene_name == 'pooling_type':
            choices = list(set(self.search_space['pooling_type']) - set([parent1_value, parent2_value]))
            if choices:
                return random.choice(choices)
        
        if gene_name == 'conv_type':
            choices = list(set(self.search_space['conv_type']) - set([parent1_value, parent2_value]))
            if choices:
                return random.choice(choices)
        
        if gene_name == 'norm_type':
            choices = list(set(self.search_space['norm_type']) - set([parent1_value, parent2_value]))
            if choices:
                return random.choice(choices)
        
        if gene_name == 'optimizer_type':
            choices = list(set(self.search_space['optimizer_type']) - set([parent1_value, parent2_value]))
            if choices:
                return random.choice(choices)
        
        return random.choice([parent1_value, parent2_value])
