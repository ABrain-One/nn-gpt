    def combine_genes(self, gene_name, parent1_value, parent2_value, crossover_point, gene_index, total_genes):
        if gene_index < crossover_point:
            return parent1_value
        else:
            return parent2_value

        # Additional strategies to maintain genetic diversity and avoid premature convergence
        if gene_name == 'n_columns' and abs(parent1_value - parent2_value) > 1:
            return random.choice([parent1_value, parent2_value])
        
        if gene_name == 'base_channels' and abs(parent1_value - parent2_value) > 16:
            return random.choice([parent1_value, parent2_value])
        
        if gene_name == 'n_blocks' and abs(parent1_value - parent2_value) > 1:
            return random.choice([parent1_value, parent2_value])
        
        if gene_name == 'dropout_prob':
            avg = (parent1_value + parent2_value) / 2
            return random.uniform(avg - 0.05, avg + 0.05)
        
        if gene_name == 'fc_dropout':
            avg = (parent1_value + parent2_value) / 2
            return random.uniform(avg - 0.05, avg + 0.05)
        
        if gene_name == 'lr':
            avg = (parent1_value + parent2_value) / 2
            return random.uniform(avg - 0.001, avg + 0.001)
        
        if gene_name == 'momentum':
            avg = (parent1_value + parent2_value) / 2
            return random.uniform(avg - 0.05, avg + 0.05)
        
        if gene_name == 'kernel_size' and abs(parent1_value - parent2_value) > 1:
            return random.choice([parent1_value, parent2_value])
        
        if gene_name == 'pooling_type' and parent1_value != parent2_value:
            return random.choice([parent1_value, parent2_value])
        
        if gene_name == 'conv_type' and parent1_value != parent2_value:
            return random.choice([parent1_value, parent2_value])
        
        if gene_name == 'norm_type' and parent1_value != parent2_value:
            return random.choice([parent1_value, parent2_value])
        
        if gene_name == 'optimizer_type' and parent1_value != parent2_value:
            return random.choice([parent1_value, parent2_value])
