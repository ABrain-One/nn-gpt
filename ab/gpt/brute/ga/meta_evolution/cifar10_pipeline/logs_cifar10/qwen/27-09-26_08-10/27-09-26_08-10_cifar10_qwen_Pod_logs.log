    def _create_random_chromosome(self):
        chromosome = {}
        for key, values in self.search_space.items():
            if key == "activation":
                # Randomly choose between two different activation functions
                activation1, activation2 = random.sample(["ReLU", "GELU"], 2)
                chromosome[key] = random.choice([activation1, activation2])
            elif key == "conv_type":
                # Randomly choose between two different convolution types
                conv_type1, conv_type2 = random.sample(["Standard", "Depthwise"], 2)
                chromosome[key] = random.choice([conv_type1, conv_type2])
            elif key == "pooling_type":
                # Randomly choose between two different pooling types
                pooling_type1, pooling_type2 = random.sample(["Max", "Avg"], 2)
                chromosome[key] = random.choice([pooling_type1, pooling_type2])
            elif key == "norm_type":
                # Randomly choose between two different normalization types
                norm_type1, norm_type2 = random.sample(["BatchNorm", "InstanceNorm"], 2)
                chromosome[key] = random.choice([norm_type1, norm_type2])
            elif key == "optimizer_type":
                # Randomly choose between three different optimizer types
                optimizer_type1, optimizer_type2, optimizer_type3 = random.sample(["SGD", "AdamW", "RMSprop"], 3)
                chromosome[key] = random.choice([optimizer_type1, optimizer_type2, optimizer_type3])
            else:
                chromosome[key] = random.choice(values)
        return chromosome
