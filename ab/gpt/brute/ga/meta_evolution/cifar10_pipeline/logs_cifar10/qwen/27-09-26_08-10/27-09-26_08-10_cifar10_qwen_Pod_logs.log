    def combine_genes(self, gene_name, parent1_value, parent2_value, crossover_point, gene_index, total_genes):
        if gene_index < crossover_point:
            return parent1_value
        else:
            # Introduce randomness to avoid premature convergence
            if random.random() < 0.5:
                return parent1_value
            else:
                return parent2_value

        # Additional strategy to ensure genetic diversity
        if gene_name == 'base_channels' or gene_name == 'lr' or gene_name == 'momentum':
            return random.choice([parent1_value, parent2_value])

        # Strategy to promote exploration of different activation functions
        if gene_name == 'activation':
            if parent1_value == parent2_value:
                return random.choice(['ReLU', 'GELU', 'LeakyReLU', 'SiLU'])
            else:
                return random.choice([parent1_value, parent2_value])

        # Strategy to diversify convolution types
        if gene_name == 'conv_type':
            if parent1_value == parent2_value:
                return random.choice(['Standard', 'Depthwise'])
            else:
                return random.choice([parent1_value, parent2_value])

        # Strategy to vary normalization types
        if gene_name == 'norm_type':
            if parent1_value == parent2_value:
                return random.choice(['BatchNorm', 'InstanceNorm'])
            else:
                return random.choice([parent1_value, parent2_value])

        # Strategy to explore different pooling types
        if gene_name == 'pooling_type':
            if parent1_value == parent2_value:
                return random.choice(['Max', 'Avg'])
            else:
                return random.choice([parent1_value, parent2_value])

        # Strategy to diversify optimizer types
        if gene_name == 'optimizer_type':
            if parent1_value == parent2_value:
                return random.choice(['SGD', 'AdamW', 'RMSprop'])
            else:
                return random.choice([parent1_value, parent2_value])
