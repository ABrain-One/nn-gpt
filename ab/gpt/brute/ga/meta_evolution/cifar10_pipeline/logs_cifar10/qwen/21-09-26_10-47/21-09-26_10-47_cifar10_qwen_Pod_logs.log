    def combine_genes(self, gene_name, parent1_value, parent2_value, crossover_point, gene_index, total_genes):
        if gene_index < crossover_point:
            return parent1_value
        else:
            return parent2_value

        # Novel strategies to maintain genetic diversity and avoid premature convergence
        if gene_name == 'base_channels':
            if random.random() < 0.5:
                return parent1_value
            else:
                return parent2_value

        if gene_name == 'dropout_prob' or gene_name == 'fc_dropout':
            avg = (parent1_value + parent2_value) / 2
            if random.random() < 0.5:
                return avg
            else:
                return parent1_value if random.random() < 0.5 else parent2_value

        if gene_name == 'lr':
            avg = (parent1_value + parent2_value) / 2
            if random.random() < 0.5:
                return avg
            else:
                return parent1_value if random.random() < 0.5 else parent2_value

        if gene_name == 'momentum':
            avg = (parent1_value + parent2_value) / 2
            if random.random() < 0.5:
                return avg
            else:
                return parent1_value if random.random() < 0.5 else parent2_value

        if gene_name == 'kernel_size':
            choices = [1, 3, 5, 7]
            parent_choice = random.choice([parent1_value, parent2_value])
            return random.choice([choice for choice in choices if choice != parent_choice])

        if gene_name == 'pooling_type':
            if parent1_value == parent2_value:
                return parent1_value
            else:
                return random.choice(['Max', 'Avg'])

        if gene_name == 'conv_type':
            if parent1_value == parent2_value:
                return parent1_value
            else:
                return random.choice(['Standard', 'Depthwise'])

        if gene_name == 'norm_type':
            if parent1_value == parent2_value:
                return parent1_value
            else:
                return random.choice(['BatchNorm', 'InstanceNorm'])

        if gene_name == 'optimizer_type':
            if parent1_value == parent2_value:
                return parent1_value
            else:
                return random.choice(['SGD', 'AdamW', 'RMSprop'])
