    def combine_genes(self, gene_name, parent1_value, parent2_value, crossover_point, gene_index, total_genes):
        if gene_name == 'activation':
            # Alternating between ReLU and GELU
            if gene_index % 2 == 0:
                return parent1_value
            else:
                return parent2_value
        elif gene_name == 'kernel_size':
            # Cycle through kernel sizes
            kernels = [1, 3, 5, 7]
            index = kernels.index(parent1_value)
            next_index = (index + 1) % len(kernels)
            if gene_index % 2 == 0:
                return parent1_value
            else:
                return kernels[next_index]
        elif gene_name == 'pooling_type':
            # Alternate between Max and Avg pooling
            if gene_index % 2 == 0:
                return parent1_value
            else:
                return 'Avg' if parent1_value == 'Max' else 'Max'
        elif gene_name == 'conv_type':
            # Alternate between Standard and Depthwise convolutions
            if gene_index % 2 == 0:
                return parent1_value
            else:
                return 'Depthwise' if parent1_value == 'Standard' else 'Standard'
        elif gene_name == 'norm_type':
            # Alternate between BatchNorm and InstanceNorm
            if gene_index % 2 == 0:
                return parent1_value
            else:
                return 'InstanceNorm' if parent1_value == 'BatchNorm' else 'BatchNorm'
        elif gene_name == 'optimizer_type':
            # Alternate between SGD and AdamW
            if gene_index % 2 == 0:
                return parent1_value
            else:
                return 'AdamW' if parent1_value == 'SGD' else 'SGD'
        else:
            # Default behavior for other parameters
            if gene_index < crossover_point:
                return parent1_value
            else:
                return parent2_value
