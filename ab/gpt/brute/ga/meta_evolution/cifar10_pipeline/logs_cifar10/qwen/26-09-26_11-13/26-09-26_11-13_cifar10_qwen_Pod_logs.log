    def _create_random_chromosome(self):
        chromosome = {}
        for key, values in self.search_space.items():
            if key == 'activation':
                # Randomly choose between ReLU and GELU
                chromosome[key] = random.choice(['ReLU', 'GELU'])
            elif key == 'kernel_size':
                # Randomly choose between 1, 3, 5, 7
                chromosome[key] = random.choice([1, 3, 5, 7])
            elif key == 'pooling_type':
                # Randomly choose between Max and Avg
                chromosome[key] = random.choice(['Max', 'Avg'])
            elif key == 'conv_type':
                # Randomly choose between Standard and Depthwise
                chromosome[key] = random.choice(['Standard', 'Depthwise'])
            elif key == 'norm_type':
                # Randomly choose between BatchNorm and InstanceNorm
                chromosome[key] = random.choice(['BatchNorm', 'InstanceNorm'])
            elif key == 'optimizer_type':
                # Randomly choose between SGD and AdamW
                chromosome[key] = random.choice(['SGD', 'AdamW'])
            else:
                chromosome[key] = random.choice(values)
        return chromosome
