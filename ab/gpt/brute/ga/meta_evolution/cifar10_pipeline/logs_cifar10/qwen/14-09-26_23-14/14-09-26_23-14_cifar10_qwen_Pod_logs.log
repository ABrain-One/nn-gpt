def combine_genes(self, gene_name, parent1_value, parent2_value, crossover_point, gene_index, total_genes):
    # Determine the type of gene to handle different data types
    if isinstance(parent1_value, int) or isinstance(parent1_value, float):
        # Integer or Float Gene
        if gene_index < crossover_point:
            child_value = parent1_value
        else:
            child_value = parent2_value
    elif isinstance(parent1_value, str):
        # String Gene (e.g., activation functions, optimizer types)
        possible_values = list(set(self.search_space[gene_name]) - {parent1_value, parent2_value})
        if possible_values:
            child_value = random.choice(possible_values)
        else:
            child_value = parent1_value
    elif isinstance(parent1_value, bool):
        # Boolean Gene
        child_value = not parent1_value
    else:
        raise ValueError(f"Unsupported gene type: {type(parent1_value)}")

    # Aggressively explore the search space
    exploration_probability = 0.2
    if random.random() < exploration_probability:
