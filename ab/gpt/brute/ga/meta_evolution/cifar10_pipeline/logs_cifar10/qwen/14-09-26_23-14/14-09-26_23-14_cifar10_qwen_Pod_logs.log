        search_space_length = len(self.search_space[gene_name])
        
        # Create a mapping from the current value to its index in the search space
        value_to_index = {value: idx for idx, value in enumerate(self.search_space[gene_name])}
        
        # Convert the current values to indices
        parent1_idx = value_to_index[parent1_value]
        parent2_idx = value_to_index[parent2_value]
        
        # Calculate the midpoint of the crossover point and the length of the search space
        mid_point = (crossover_point + gene_index) // 2
        
        # Cross over the indices
        child_idx = parent1_idx if gene_index < mid_point else parent2_idx
        
        # Map the child index back to the corresponding value
        child_value = self.search_space[gene_name][child_idx]
        
        # Introduce diversity by considering the next and previous values in the search space
