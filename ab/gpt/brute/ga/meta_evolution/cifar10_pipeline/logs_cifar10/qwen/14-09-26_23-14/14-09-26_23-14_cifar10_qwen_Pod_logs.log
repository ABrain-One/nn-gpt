    mutation_probability = 0.1
    if random.random() < mutation_probability:
        child_value = self.mutate_gene(gene_name, child_value, self.search_space[gene_name])

    # Ensure proper sanitization before returning
    child_chromo = {gene_name: child_value}
    return self._sanitize_chromosome(child_chromo)
