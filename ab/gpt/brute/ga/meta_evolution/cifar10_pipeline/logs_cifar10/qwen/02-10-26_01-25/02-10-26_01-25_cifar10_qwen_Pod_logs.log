def combine_genes(self, gene_name, parent1_value, parent2_value, crossover_point, gene_index, total_genes):
    if gene_name == 'architecture':
        # Combine different parts of architecture from both parents
        parent1_parts = parent1_value.split('_')
        parent2_parts = parent2_value.split('_')
        combined_parts = []
        for p1, p2 in zip(parent1_parts, parent2_parts):
            if random.random() > 0.5:
                combined_parts.append(p1)
            else:
                combined_parts.append(p2)
        return '_'.join(combined_parts)
    elif gene_name == 'hyperparameters':
        # Combine hyperparameters from both parents with some randomness
        combined_value = (parent1_value + parent2_value) / 2
        if random.random() > 0.5:
            combined_value += random.uniform(-0.1, 0.1)
        else:
            combined_value -= random.uniform(-0.1, 0.1)
        return combined_value
    else:
        if gene_index < crossover_point:
            return parent1_value
        else:
            return parent2_value
