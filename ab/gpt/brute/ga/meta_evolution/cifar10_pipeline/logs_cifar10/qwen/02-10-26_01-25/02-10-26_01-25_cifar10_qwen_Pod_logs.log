    def _create_random_chromosome(self):
        chromosome = {}
        for key, values in self.search_space.items():
            if key == 'architecture':
                # Generate a random architecture string
                n_columns = random.choice(self.search_space['n_columns'])
                base_channels = random.choice(self.search_space['base_channels'])
                n_blocks = random.choice(self.search_space['n_blocks'])
                architecture = f"{n_columns}_{base_channels}_{n_blocks}"
                chromosome[key] = architecture
            elif key == 'hyperparameters':
                # Generate random hyperparameters
                lr = random.choice(self.search_space['lr'])
                momentum = random.choice(self.search_space['momentum'])
                dropout_prob = random.choice(self.search_space['dropout_prob'])
                fc_dropout = random.choice(self.search_space['fc_dropout'])
                chromosome[key] = {'lr': lr, 'momentum': momentum, 'dropout_prob': dropout_prob, 'fc_dropout': fc_dropout}
            elif key in ['activation', 'pooling_type', 'conv_type', 'norm_type', 'optimizer_type']:
                # Select random value from the search space
                chromosome[key] = random.choice(self.search_space[key])
            else:
                raise ValueError(f"Unknown gene type: {key}")
        return chromosome
