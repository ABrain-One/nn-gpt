    def mutate_gene(self, gene_name, current_value, possible_values):
        if possible_values:
            choices = list(set(possible_values) - set([current_value]))
            if choices:
                mutation_probability = self.mutation_rate * 3  # Increase mutation probability further
                if random.random() < mutation_probability:
                    # Introduce large step mutations for radical architectural innovation
                    if gene_name == 'architecture':
                        return random.choice(list(self.search_space[gene_name].keys()))
                    elif gene_name == 'hyperparameters':
                        if isinstance(current_value, float):
                            new_value = current_value + random.gauss(0, 0.2)  # Gaussian mutation
                            return max(0.001, min(new_value, 1.0))  # Clamp between valid ranges
                        elif isinstance(current_value, int):
                            return random.randint(1, 10)  # Large jump in integer parameters
                    else:
                        return random.choice(choices)
        return current_value
