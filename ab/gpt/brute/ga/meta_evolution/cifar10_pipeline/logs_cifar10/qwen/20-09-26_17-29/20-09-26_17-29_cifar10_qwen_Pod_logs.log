    def combine_genes(self, gene_name, parent1_value, parent2_value, crossover_point, gene_index, total_genes):
        # Split the gene at the crossover point
        if gene_index < crossover_point:
            child_value = parent1_value
        else:
            child_value = parent2_value
        
        # Introduce variation by randomly selecting from either parent
        if random.random() < 0.5:
            child_value = parent1_value
        else:
            child_value = parent2_value
        
        # Force exploration by introducing randomness
        if random.random() < self.mutation_rate * 2:
            possible_values = [v for v in self.search_space[gene_name] if v != child_value]
            if possible_values:
                child_value = random.choice(possible_values)
        
        # Enhance diversity by choosing a value that is not the most common among parents
        parent_values = [parent1_value, parent2_value]
        if child_value in parent_values:
            other_parent_value = parent1_value if child_value == parent2_value else parent2_value
            child_value = other_parent_value
        
        return child_value
