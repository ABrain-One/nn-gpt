    def mutate_gene(self, gene_name, current_value, possible_values):
        if possible_values:
            choices = list(set(possible_values) - set([current_value]))
            if choices:
                mutation_probability = self.mutation_rate * 3  # Further increase mutation probability
                if random.random() < mutation_probability:
                    # Introduce more diverse mutations
                    if gene_name == 'conv_type':
                        if current_value == 'Standard':
                            return 'Depthwise'
                        else:
                            return 'Standard'
                    elif gene_name == 'activation':
                        if current_value == 'GELU':
                            return 'SiLU'
                        else:
                            return 'GELU'
                    else:
                        return random.choice(choices)
        return current_value
