    def combine_genes(self, gene_name, parent1_value, parent2_value, crossover_point, gene_index, total_genes):
        if gene_name == "conv_type":
            # Combine convolution types using a more complex strategy
            if parent1_value == "Standard" and parent2_value == "Depthwise":
                if gene_index < crossover_point:
                    return parent1_value
                else:
                    return parent2_value
            elif parent1_value == "Depthwise" and parent2_value == "Standard":
                if gene_index < crossover_point:
                    return parent2_value
                else:
                    return parent1_value
            else:
                return random.choice([parent1_value, parent2_value])
        elif gene_name == "activation":
            # Use a more sophisticated activation function combination strategy
            if parent1_value == "GELU" and parent2_value == "SiLU":
                if gene_index < crossover_point:
                    return parent1_value
                else:
                    return parent2_value
            elif parent1_value == "SiLU" and parent2_value == "GELU":
                if gene_index < crossover_point:
                    return parent2_value
                else:
                    return parent1_value
            else:
                return random.choice([parent1_value, parent2_value])
        else:
            # Default behavior for other parameters
            if gene_index < crossover_point:
                return parent1_value
            else:
                return parent2_value
