    def mutate_gene(self, gene_name, current_value, possible_values):
        if possible_values:
            choices = list(set(possible_values) - set([current_value]))
            if choices:
                mutation_probability = self.mutation_rate * 3  # Increase mutation probability significantly
                if random.random() < mutation_probability:
                    # Randomly choose a different type of mutation
                    mutation_type = random.choice(['value', 'structure'])
                    
                    if mutation_type == 'value':
                        return random.choice(choices)
                    elif mutation_type == 'structure':
                        # Mutate structure related genes
                        if gene_name.startswith('n_') or gene_name == 'conv_type' or gene_name == 'norm_type':
                            return random.choice([v for v in self.search_space[gene_name] if v != current_value])
                        elif gene_name.startswith('f_'):
                            return random.choice([v for v in self.search_space[gene_name] if v != current_value])
        return current_value
