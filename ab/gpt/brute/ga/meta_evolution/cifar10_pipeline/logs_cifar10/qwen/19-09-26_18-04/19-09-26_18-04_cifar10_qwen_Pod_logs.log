    def mutate_gene(self, gene_name, current_value, possible_values):
        if possible_values:
            choices = list(set(possible_values) - set([current_value]))
            if choices:
                mutation_probability = self.mutation_rate * 5  # Increase mutation probability significantly
                if random.random() < mutation_probability:
                    mutation_type = random.choice(['value', 'structure'])

                    if mutation_type == 'value':
                        new_value = random.choice(choices)
                        while new_value == current_value:  # Ensure new value is different
                            new_value = random.choice(choices)
                        return new_value
                    elif mutation_type == 'structure':
                        # Mutate structure related genes
                        if gene_name.startswith('n_') or gene_name.startswith('b_'):
                            # Mutate number of columns or blocks
                            new_value = random.choice([2, 3, 4])
                            while new_value == current_value:  # Ensure new value is different
                                new_value = random.choice([2, 3, 4])
                            return new_value
                        elif gene_name.startswith('c_'):
                            # Mutate convolutional settings
                            new_value = random.choice([
                                {'type': 'Depthwise', 'kernel_size': 3},
                                {'type': 'Standard', 'kernel_size': 3},
                                {'type': 'Depthwise', 'kernel_size': 5},
                                {'type': 'Standard', 'kernel_size': 5}
                            ])
                            return new_value
                        elif gene_name.startswith('f_'):
                            # Mutate fully connected dropout
                            new_value = random.choice([0.05, 0.1, 0.15, 0.2, 0.25, 0.3, 0.4, 0.5])
                            while new_value == current_value:  # Ensure new value is different
                                new_value = random.choice([0.05, 0.1, 0.15, 0.2, 0.25, 0.3, 0.4, 0.5])
                            return new_value
                        elif gene_name.startswith('l_'):
                            # Mutate learning rate
                            new_value = random.choice([0.01, 0.008, 0.006, 0.005, 0.004, 0.003, 0.002, 0.001])
                            while new_value == current_value:  # Ensure new value is different
                                new_value = random.choice([0.01, 0.008, 0.006, 0.005, 0.004, 0.003, 0.002, 0.001])
                            return new_value
                        elif gene_name.startswith('m_'):
                            # Mutate momentum
                            new_value = random.choice([0.75, 0.8, 0.85, 0.88, 0.9, 0.92, 0.95, 0.98])
                            while new_value == current_value:  # Ensure new value is different
                                new_value = random.choice([0.75, 0.8, 0.85, 0.88, 0.9, 0.92, 0.95, 0.98])
                            return new_value
        return current_value
