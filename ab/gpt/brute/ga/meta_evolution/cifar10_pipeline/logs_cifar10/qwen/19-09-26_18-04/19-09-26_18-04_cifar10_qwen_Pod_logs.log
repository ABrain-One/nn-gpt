    def mutate_gene(self, gene_name, current_value, possible_values):
        if possible_values:
            choices = list(set(possible_values) - set([current_value]))
            if choices:
                mutation_probability = self.mutation_rate * 5  # Increase mutation probability significantly
                if random.random() < mutation_probability:
                    mutation_type = random.choice(['value', 'structure'])

                    if mutation_type == 'value':
                        new_value = random.choice(choices)
                        while new_value == current_value:  # Ensure new value is different
                            new_value = random.choice(choices)
                        return new_value
                    elif mutation_type == 'structure':
                        # Mutate structure related genes
                        if gene_name.startswith('n_') or gene_name == 'base_channels' or gene_name == 'n_blocks':
                            mutation_range = 2
                            if gene_name.startswith('n_'):
                                mutation_range = 3
                            mutation_amount = random.randint(-mutation_range, mutation_range)
                            new_value = current_value + mutation_amount
                            new_value = max(1, min(new_value, max(possible_values)))
                            return new_value
                        elif gene_name == 'activation':
                            return random.choice(["ReLU", "GELU", "LeakyReLU", "SiLU"])
                        elif gene_name == 'kernel_size':
                            return random.choice([1, 3, 5, 7])
                        elif gene_name == 'pooling_type':
                            return random.choice(["Max", "Avg"])
                        elif gene_name == 'conv_type':
                            return random.choice(["Standard", "Depthwise"])
                        elif gene_name == 'norm_type':
                            return random.choice(["BatchNorm", "InstanceNorm"])
                        elif gene_name == 'optimizer_type':
                            return random.choice(["SGD", "AdamW", "RMSprop"])
                        elif gene_name == 'dropout_prob' or gene_name == 'fc_dropout':
                            mutation_range = 0.05
                            mutation_amount = random.uniform(-mutation_range, mutation_range)
                            new_value = current_value + mutation_amount
                            new_value = max(0.01, min(new_value, 0.5))
                            return new_value
                        elif gene_name == 'lr':
                            mutation_range = 0.001
                            mutation_amount = random.uniform(-mutation_range, mutation_range)
                            new_value = current_value * (1 + mutation_amount)
                            new_value = max(0.0001, min(new_value, 0.1))
                            return new_value
                        elif gene_name == 'momentum':
                            mutation_range = 0.02
                            mutation_amount = random.uniform(-mutation_range, mutation_range)
                            new_value = current_value + mutation_amount
                            new_value = max(0.6, min(new_value, 0.98))
                            return new_value
        return current_value
