                        elif gene_name == 'kernel_size':
                            new_value = random.choice([1, 3, 5, 7])
                        elif gene_name == 'pooling_type':
                            new_value = random.choice(["Max", "Avg"])
                        elif gene_name == 'conv_type':
                            new_value = random.choice(["Standard", "Depthwise"])
                        elif gene_name == 'norm_type':
                            new_value = random.choice(["BatchNorm", "InstanceNorm"])
                        elif gene_name == 'optimizer_type':
                            new_value = random.choice(["SGD", "AdamW", "RMSprop"])
                        return new_value
        return current_value
