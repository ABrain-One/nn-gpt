    def combine_genes(self, gene_name, parent1_value, parent2_value, crossover_point, gene_index, total_genes):
        if gene_name in ["n_columns", "base_channels", "n_blocks"]:
            # Choose from parents with weighted probabilities to encourage diversity
            choice = random.choices([parent1_value, parent2_value], weights=[0.7, 0.3], k=1)[0]
            return choice
        
        elif gene_name in ["dropout_prob", "fc_dropout"]:
            # Use geometric mean with random scaling to promote diversity
            avg = parent1_value ** 0.5 * parent2_value ** 0.5
            scaled_avg = avg * random.uniform(0.8, 1.2)
            return max(min(scaled_avg, max(self.search_space[gene_name])), min(self.search_space[gene_name]))
        
        elif gene_name in ["lr", "momentum"]:
            # Interpolate between parent values with random scaling to promote diversity
            interp = parent1_value + random.uniform(-0.1, 0.1) * (parent2_value - parent1_value)
            return max(min(interp, max(self.search_space[gene_name])), min(self.search_space[gene_name]))
        
        elif gene_name == "activation":
            # Cycle through activation functions
            idx = self.search_space[gene_name].index(parent1_value)
            next_idx = (idx + 1) % len(self.search_space[gene_name])
            return self.search_space[gene_name][next_idx]
        
        elif gene_name == "kernel_size":
            # Cycle through kernel sizes
            idx = self.search_space[gene_name].index(parent1_value)
            next_idx = (idx + 1) % len(self.search_space[gene_name])
            return self.search_space[gene_name][next_idx]
        
        elif gene_name == "pooling_type":
            # Toggle pooling types
            return "Max" if parent1_value == "Avg" else "Avg"
        
        elif gene_name == "conv_type":
            # Toggle convolution types
            return "Depthwise" if parent1_value == "Standard" else "Standard"
        
        elif gene_name == "norm_type":
            # Toggle normalization types
            return "InstanceNorm" if parent1_value == "BatchNorm" else "BatchNorm"
        
        elif gene_name == "optimizer_type":
            # Cycle through optimizer types
            idx = self.search_space[gene_name].index(parent1_value)
            next_idx = (idx + 1) % len(self.search_space[gene_name])
            return self.search_space[gene_name][next_idx]
