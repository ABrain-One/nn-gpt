        scaled_avg = avg * random.uniform(0.8, 1.2)
        return max(min(scaled_avg, max(self.search_space[gene_name])), min(self.search_space[gene_name]))
    
    elif gene_name in ["lr", "momentum"]:
        # Interpolate between parent values and apply exponential decay
        alpha = 0.5
        beta = 0.3
        child_value = alpha * parent1_value + beta * parent2_value
        decay_factor = random.uniform(0.7, 1.0)
        return child_value * decay_factor
    
    elif gene_name == "activation":
        # Cycle through activation functions
        activations = ["ReLU", "GELU", "LeakyReLU", "SiLU"]
        index = activations.index(parent1_value)
        next_activation = activations[(index + 1) % len(activations)]
        return next_activation
    
    elif gene_name == "kernel_size":
        # Cycle through kernel sizes
        kernels = [1, 3, 5, 7]
        index = kernels.index(parent1_value)
        next_kernel = kernels[(index + 1) % len(kernels)]
        return next_kernel
    
    elif gene_name == "pooling_type":
