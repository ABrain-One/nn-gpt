def combine_genes(self, gene_name, parent1_value, parent2_value, crossover_point, gene_index, total_genes):
    if gene_name in ["n_columns", "base_channels", "n_blocks"]:
        # Choose from parents with weighted probabilities to encourage diversity
        choice = random.choices([parent1_value, parent2_value], weights=[0.7, 0.3], k=1)[0]
        return choice
    
    elif gene_name in ["dropout_prob", "fc_dropout"]:
        # Use geometric mean with random scaling to promote diversity
        avg = parent1_value ** 0.5 * parent2_value ** 0.5
        scaled_avg = avg * random.uniform(0.8, 1.2)
        return max(min(scaled_avg, max(self.search_space[gene_name])), min(self.search_space[gene_name]))
    
    elif gene_name in ["lr", "momentum"]:
        # Interpolate linearly between parents with noise to encourage exploration
        alpha = random.uniform(0.2, 0.8)
        value = parent1_value * alpha + parent2_value * (1 - alpha)
        return value
    
    elif gene_name == "activation":
        # Randomly choose one of the two activations with some probability
        if random.random() < 0.5:
            return parent1_value
        else:
            return parent2_value
    
    elif gene_name == "kernel_size":
        # Choose from the common kernel sizes with weighted probabilities
        choices = [1, 3, 5]
        weights = [0.1, 0.7, 0.2]
        return random.choices(choices, weights=weights, k=1)[0]
    
    elif gene_name == "pooling_type":
        # Randomly select between Max and Avg pooling with equal probability
        return random.choice(["Max", "Avg"])
    
    elif gene_name == "conv_type":
        # Randomly select between Standard and Depthwise convolutions with equal probability
        return random.choice(["Standard", "Depthwise"])
    
    elif gene_name == "norm_type":
        # Randomly select between BatchNorm and InstanceNorm with equal probability
        return random.choice(["BatchNorm", "InstanceNorm"])
    
    elif gene_name == "optimizer_type":
        # Randomly select between SGD, AdamW, and RMSprop with equal probability
        return random.choice(["SGD", "AdamW", "RMSprop"])
    
    else:
        raise ValueError(f"Gene '{gene_name}' not in search space")
