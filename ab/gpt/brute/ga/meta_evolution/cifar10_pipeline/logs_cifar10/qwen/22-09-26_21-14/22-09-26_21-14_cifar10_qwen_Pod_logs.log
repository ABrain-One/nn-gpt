def combine_genes(self, gene_name, parent1_value, parent2_value, crossover_point, gene_index, total_genes):
    if gene_name == "n_columns" or gene_name == "base_channels":
        # Combine by averaging but ensuring within valid range
        avg = int((parent1_value + parent2_value) / 2)
        return max(min(avg, max(self.search_space[gene_name])), min(self.search_space[gene_name]))
    
    elif gene_name == "n_blocks" or gene_name == "dropout_prob" or gene_name == "fc_dropout":
        # Combine linearly but ensure within valid range
        combined = parent1_value + parent2_value
        if combined > sum(self.search_space[gene_name]):
            combined = sum(self.search_space[gene_name])
        return int(combined / 2)
    
    elif gene_name == "lr" or gene_name == "momentum":
        # Combine exponentially with decay factor
        alpha = 0.5
        combined = parent1_value * alpha + parent2_value * (1 - alpha)
        return float(combined)
    
    elif gene_name == "activation" or gene_name == "pooling_type" or gene_name == "conv_type" or gene_name == "norm_type" or gene_name == "optimizer_type":
        # Combine by randomly choosing one from both parents
        choices = list(set(self.search_space[gene_name]) & set([parent1_value, parent2_value]))
        return random.choice(choices)
    
    elif gene_name == "kernel_size":
        # Combine by averaging but ensuring odd numbers and within valid range
        avg = int((parent1_value + parent2_value) / 2)
        kernel_size = max(min(avg, max(self.search_space[gene_name])), min(self.search_space[gene_name]))
        return kernel_size if kernel_size % 2 == 1 else kernel_size - 1
    
    else:
        raise ValueError(f"Unknown gene name: {gene_name}")
