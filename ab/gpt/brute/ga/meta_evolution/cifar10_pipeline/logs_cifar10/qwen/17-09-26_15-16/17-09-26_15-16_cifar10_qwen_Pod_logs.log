def combine_genes(self, gene_name, parent1_value, parent2_value, crossover_point, gene_index, total_genes):
    if gene_name in ["activation", "conv_type", "norm_type", "pooling_type"]:
        # Select one value from each parent randomly
        parent1_choices = list(self.search_space[gene_name])
        parent2_choices = list(self.search_space[gene_name])
        
        # Remove the chosen value from the other parent's choices to ensure diversity
        chosen_parent = random.choice([parent1_choices, parent2_choices])
        if chosen_parent == parent1_choices:
            parent2_choices.remove(parent2_value)
        else:
            parent1_choices.remove(parent1_value)
        
        # Choose the value from the remaining options or use the original value with low probability
        if random.random() < 0.7:
            if chosen_parent == parent1_choices:
                return parent1_value
            else:
                return parent2_value
        else:
            return random.choice(chosen_parent)
    
    elif gene_name in ["base_channels", "kernel_size"]:
        # Take the mean of the two values and add some noise
        combined_value = (parent1_value + parent2_value) / 2 + random.uniform(-1, 1)
        return int(round(combined_value))
    
    elif gene_name in ["lr", "momentum", "dropout_prob", "fc_dropout"]:
        # Interpolate the values and add some noise
        combined_value = (parent1_value + parent2_value) / 2 + random.uniform(-1, 1)
        return combined_value
    
    elif gene_name == "n_columns":
        # Use a combination of both values with a higher chance of selecting the smaller number
        parent1_val = parent1_value
        parent2_val = parent2_value
        combined_value = (parent1_val * 0.5 + parent2_val * 0.5) + random.uniform(-0.5, 0.5)
        if combined_value < parent1_val and combined_value < parent2_val:
            return int(combined_value)
        elif combined_value > parent1_val and combined_value > parent2_val:
            return int((parent1_val + parent2_val) / 2)
        else:
            return random.choice([int(parent1_val), int(parent2_val)])
    
    elif gene_name == "n_blocks":
        # Combine the blocks and choose a unique set
        parent1_set = set(range(parent1_value))
        parent2_set = set(range(parent2_value))
        combined_set = parent1_set.union(parent2_set)
        return len(combined_set)
    
    elif gene_name == "optimizer_type":
        # Randomly choose between the two types
        return random.choice(["SGD", "AdamW", "RMSprop"])
