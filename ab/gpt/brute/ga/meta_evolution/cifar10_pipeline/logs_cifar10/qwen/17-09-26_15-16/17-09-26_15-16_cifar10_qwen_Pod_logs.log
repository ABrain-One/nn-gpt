                choices.append(new_choice)
            return random.choice(choices)
        elif gene_name in ["base_channels", "kernel_size"]:
            # Combine parent values using arithmetic mean and introduce randomness
            combined_value = (parent1_value + parent2_value) / 2 + random.uniform(-1, 1)
            return int(round(combined_value))
        elif gene_name in ["lr", "momentum", "dropout_prob", "fc_dropout"]:
            # Use a blend of exponential decay and linear combination
            alpha = random.random()
            beta = 1 - alpha
            combined_value = (alpha * parent1_value) + (beta * parent2_value)
            if gene_name == "lr":
                combined_value *= (random.uniform(0.9, 1.1))
            elif gene_name == "momentum":
                combined_value *= (random.uniform(0.9, 1.1))
            elif gene_name == "dropout_prob" or gene_name == "fc_dropout":
                combined_value = abs(combined_value)
            return round(combined_value, 4)
        elif gene_name in ["n_columns", "n_blocks"]:
            # Combine parent values using geometric mean and introduce randomness
            combined_value = (parent1_value ** 0.5 * parent2_value ** 0.5) + random.uniform(-1, 1)
            return int(round(combined_value))
        elif gene_name == "optimizer_type":
            # Randomly choose between parent values
            return random.choice([parent1_value, parent2_value])
