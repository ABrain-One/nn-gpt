def combine_genes(self, gene_name, parent1_value, parent2_value, crossover_point, gene_index, total_genes):
    # Combine values from both parents with a more sophisticated approach
    if gene_name in ["activation", "conv_type", "norm_type", "pooling_type"]:
        # For categorical variables, alternate between parents
        if gene_index % 2 == 0:
            return parent1_value
        else:
            return parent2_value
    elif gene_name in ["base_channels", "kernel_size"]:
        # For numeric variables, take the average and round to nearest integer
        combined_value = (parent1_value + parent2_value) / 2
        return int(round(combined_value))
    elif gene_name in ["lr", "momentum", "dropout_prob", "fc_dropout"]:
        # For continuous variables, use a weighted average
        alpha = 0.7
        combined_value = alpha * parent1_value + (1 - alpha) * parent2_value
        return combined_value
    else:
        # Default to simple crossover
        if gene_index < crossover_point:
            return parent1_value
        else:
            return parent2_value
