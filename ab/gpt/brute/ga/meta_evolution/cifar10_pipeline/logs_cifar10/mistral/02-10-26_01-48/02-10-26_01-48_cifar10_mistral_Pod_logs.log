def _create_random_chromosome(self):
    chromosome = {}
    for key, values in self.search_space.items():
        # Randomly choose a value from the search space
        chromosome[key] = random.choice(values)
        
        # Introduce randomness by slightly modifying the chosen value
        if isinstance(chromosome[key], int) or isinstance(chromosome[key], float):
            # Add a small random offset to the numeric value
            offset = random.gauss(0, 0.2 * abs(chromosome[key])) if chromosome[key] != 0 else 0.2
            chromosome[key] += offset
        
        # Ensure the modified value stays within the valid range
        if isinstance(chromosome[key], int):
            chromosome[key] = max(min(chromosome[key], max(values)), min(values))
        elif isinstance(chromosome[key], float):
            chromosome[key] = max(min(chromosome[key], max(values)), min(values))
    
    return chromosome
