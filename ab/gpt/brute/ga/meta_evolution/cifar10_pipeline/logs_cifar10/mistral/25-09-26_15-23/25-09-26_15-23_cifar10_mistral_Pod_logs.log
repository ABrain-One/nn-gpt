### mutate_gene ###
def mutate_gene(self, gene_name, current_value, possible_values):
    if possible_values:
        choices = list(set(possible_values) - set([current_value]))
        if choices:
            mutation_probability = self.mutation_rate * 3  # Further increase mutation probability
            if random.random() < mutation_probability:
                # Randomly choose a different layer type for radical innovation
                if gene_name in ['n_columns', 'base_channels', 'n_blocks']:
                    return random.choice(list(range(2, 6)))  # Explore different numbers of columns, channels, and blocks
                elif gene_name == 'activation':
                    return random.choice(['ReLU', 'GELU', 'LeakyReLU', 'SiLU'])
                elif gene_name == 'kernel_size':
                    return random.choice([1, 3, 5, 7])
                elif gene_name == 'pooling_type':
                    return random.choice(['Max', 'Avg'])
                elif gene_name == 'conv_type':
                    return random.choice(['Standard', 'Depthwise'])
                elif gene_name == 'norm_type':
                    return random.choice(['BatchNorm', 'InstanceNorm'])
                elif gene_name == 'optimizer_type':
                    return random.choice(['SGD', 'AdamW', 'RMSprop'])
    return current_value
