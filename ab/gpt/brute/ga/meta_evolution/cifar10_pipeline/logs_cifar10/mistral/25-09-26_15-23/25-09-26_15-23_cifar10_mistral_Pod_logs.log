def _create_random_chromosome(self):
    chromosome = {}
    for key, values in self.search_space.items():
        if key in ['n_columns', 'base_channels', 'n_blocks']:
            value = random.choice(list(range(2, 6)))
        elif key == 'activation':
            value = random.choice(['ReLU', 'GELU', 'LeakyReLU', 'SiLU'])
        elif key == 'kernel_size':
            value = random.choice([1, 3, 5, 7])
        elif key == 'pooling_type':
            value = random.choice(['Max', 'Avg'])
        elif key == 'conv_type':
            value = random.choice(['Standard', 'Depthwise'])
        elif key == 'norm_type':
            value = random.choice(['BatchNorm', 'InstanceNorm'])
        elif key == 'optimizer_type':
            value = random.choice(['SGD', 'AdamW', 'RMSprop'])
        else:
            value = random.choice(values)
        chromosome[key] = value
    return chromosome
