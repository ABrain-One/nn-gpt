    def combine_genes(self, gene_name, parent1_value, parent2_value, crossover_point, gene_index, total_genes):
        # Uniform crossover with inversion
        if random.random() < 0.5:
            return parent1_value
        else:
            return parent2_value

        # Inversion crossover
        if random.random() < 0.5:
            start = random.randint(0, total_genes - 1)
            end = random.randint(start, total_genes - 1)
            inverted_sequence = list(reversed(child_chromo[gene_name][start:end+1]))
            for i in range(end - start + 1):
                child_chromo[gene_name][start+i] = inverted_sequence[i]
            return child_chromo[gene_name]

        # Order crossover
        mask = [random.randint(0, 1) for _ in range(total_genes)]
        if sum(mask) > 0:
            child_sequence = [None] * total_genes
            j = 0
            for i in range(total_genes):
                if mask[i] == 1:
                    child_sequence[i] = parent1_value[j]
                    j += 1
            remaining = [val for val in parent2_value if val not in child_sequence]
            child_sequence = [val if val is not None else remaining.pop(0) for val in child_sequence]
            return child_sequence

        # Cycle crossover
        index = random.randint(0, total_genes - 1)
        cycle = [index]
        while True:
            index = child_chromo[gene_name].index(parent2_value[index])
            cycle.append(index)
            if index == child_chromo[gene_name][child_chromo[gene_name].index(parent2_value[index])]:
                break
        child_sequence = list(child_chromo[gene_name])
        for i in cycle:
            child_sequence[i] = parent2_value[i]
        return child_sequence
