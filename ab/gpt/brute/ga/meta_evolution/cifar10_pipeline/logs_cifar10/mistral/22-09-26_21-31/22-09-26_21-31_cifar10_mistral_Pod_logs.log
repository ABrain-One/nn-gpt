def combine_genes(self, gene_name, parent1_value, parent2_value, crossover_point, gene_index, total_genes):
    if gene_index < crossover_point:
        return parent1_value
    else:
        return parent2_value
    
    # Introduce additional strategies to enhance genetic diversity and exploration
    if gene_name == 'activation':
        # Cycle through activation functions with random jumps
        activations = ['ReLU', 'GELU', 'LeakyReLU', 'SiLU', 'SELU', 'ELU', 'Hardtanh']
        index1 = activations.index(parent1_value)
        index2 = activations.index(parent2_value)
        jump = random.randint(-2, 2)
        new_index = (index1 + index2 + jump) % len(activations)
        return activations[new_index]
    
    if gene_name == 'kernel_size':
        # Cycle through kernel sizes with random jumps
        kernels = [1, 3, 5, 7, 9, 11, 13, 15]
        index1 = kernels.index(parent1_value)
        index2 = kernels.index(parent2_value)
        jump = random.randint(-2, 2)
        new_index = (index1 + index2 + jump) % len(kernels)
        return kernels[new_index]
    
    if gene_name == 'dropout_prob' or gene_name == 'fc_dropout':
        # Smoothly interpolate but introduce randomness
        blend_factor = random.uniform(0.5, 1.5)
        return (parent1_value + parent2_value) * blend_factor
    
    if gene_name == 'lr':
        # Geometrically average with random scaling
        scale_factor = random.uniform(0.5, 2.0)
        return parent1_value ** 0.5 * parent2_value ** 0.5 * scale_factor
    
    if gene_name == 'momentum':
        # Geometrically average with random scaling
        scale_factor = random.uniform(0.5, 2.0)
        return parent1_value ** 0.5 * parent2_value ** 0.5 * scale_factor
    
    if gene_name == 'n_blocks':
        # Interpolate and round to nearest integer
        interpolation = random.uniform(0.5, 1.5)
        return int(round((parent1_value + parent2_value) * interpolation))
    
    if gene_name == 'base_channels':
        # Interpolate and round to nearest power of two with random scaling
        scale_factor = random.uniform(0.5, 2.0)
        base1 = 2 ** int(math.log2(parent1_value))
        base2 = 2 ** int(math.log2(parent2_value))
        avg_base = (base1 + base2) * scale_factor
        return 2 ** int(round(math.log2(avg_base)))
    
    if gene_name == 'pooling_type':
        # Toggle pooling types with random choice
        poolings = ['Max', 'Avg', 'MaxPool2d', 'AvgPool2d']
        return random.choice(poolings)
    
    if gene_name == 'conv_type':
        # Toggle convolution types with random choice
        conv_types = ['Standard', 'Depthwise', 'GroupedConv']
        return random.choice(conv_types)
    
    if gene_name == 'norm_type':
        # Toggle normalization types with random choice
        norm_types = ['BatchNorm', 'InstanceNorm', 'LayerNorm', 'GroupNorm']
        return random.choice(norm_types)
    
    if gene_name == 'optimizer_type':
        # Cycle through optimizer types with random jumps
        optimizers = ['SGD', 'AdamW', 'RMSprop', 'Adam', 'AdaGrad', 'Adadelta']
        index1 = optimizers.index(parent1_value)
        index2 = optimizers.index(parent2_value)
        jump = random.randint(-2, 2)
        new_index = (index1 + index2 + jump) % len(optimizers)
        return optimizers[new_index]
    
    return parent1_value
