    def combine_genes(self, gene_name, parent1_value, parent2_value, crossover_point, gene_index, total_genes):
        # Dynamic crossover method
        if gene_index < crossover_point:
            child_value = parent1_value
        else:
            child_value = parent2_value
        
        # Explore with high probability
        if random.random() < 0.7:
            return child_value
        
        # Maintain diversity with lower probability
        if random.random() < 0.1:
            return random.choice([parent1_value, parent2_value])
        
        # Arithmetic combination with higher weight towards one parent
        alpha = random.uniform(0.5, 1.0)  # Weight closer to 1 favors parent2
        child_value = alpha * parent2_value + (1 - alpha) * parent1_value
        
        # Adjust values within valid ranges
        if gene_name == 'dropout_prob' or gene_name == 'fc_dropout':
            child_value = max(0.05, min(child_value, 0.5))
        elif gene_name == 'lr':
            child_value = max(0.001, min(child_value, 0.01))
        elif gene_name == 'momentum':
            child_value = max(0.75, min(child_value, 0.98))
        
        return child_value
