        elif key == 'n_blocks':
            chromosome[key] = random.choice([2, 3, 4, 5, 6])
        elif key == 'dropout_prob':
            chromosome[key] = random.uniform(0.05, 0.5)
        elif key == 'fc_dropout':
            chromosome[key] = random.uniform(0.05, 0.5)
        elif key == 'lr':
            chromosome[key] = random.uniform(0.001, 0.01)
        elif key == 'momentum':
            chromosome[key] = random.uniform(0.75, 0.98)
        elif key == 'activation':
            chromosome[key] = random.choice(['ReLU', 'GELU', 'LeakyReLU', 'SiLU'])
        elif key == 'kernel_size':
            chromosome[key] = random.choice([1, 3, 5, 7, 9])
        elif key == 'pooling_type':
            chromosome[key] = random.choice(['Max', 'Avg'])
        elif key == 'conv_type':
            chromosome[key] = random.choice(['Standard', 'Depthwise'])
        elif key == 'norm_type':
            chromosome[key] = random.choice(['BatchNorm', 'InstanceNorm'])
        elif key == 'optimizer_type':
            chromosome[key] = random.choice(['SGD', 'AdamW', 'RMSprop'])
    return chromosome
