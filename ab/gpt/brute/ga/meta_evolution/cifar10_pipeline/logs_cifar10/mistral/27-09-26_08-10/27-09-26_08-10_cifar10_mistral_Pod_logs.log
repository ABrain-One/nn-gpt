### combine_genes ###
    def combine_genes(self, gene_name, parent1_value, parent2_value, crossover_point, gene_index, total_genes):
        # Combine values from both parents using a dynamic crossover method
        if gene_index < crossover_point:
            return parent1_value
        else:
            return parent2_value
    
        # Additional strategy to maintain genetic diversity and explore the search space
        if random.random() < 0.1:  # Randomly choose a value from either parent with a low probability
            return random.choice([parent1_value, parent2_value])
    
        # Alternatively, use arithmetic combination to create a new value
        alpha = random.uniform(0.25, 0.75)  # Weight between 0.25 and 0.75
        new_value = (1 - alpha) * parent1_value + alpha * parent2_value
    
        # Ensure the new value is within the valid range for the gene
        if gene_name == 'dropout_prob' or gene_name == 'fc_dropout':
            new_value = max(0.05, min(new_value, 0.5))
        elif gene_name == 'lr':
            new_value = max(0.001, min(new_value, 0.01))
        elif gene_name == 'momentum':
            new_value = max(0.75, min(new_value, 0.98))
    
        return new_value

