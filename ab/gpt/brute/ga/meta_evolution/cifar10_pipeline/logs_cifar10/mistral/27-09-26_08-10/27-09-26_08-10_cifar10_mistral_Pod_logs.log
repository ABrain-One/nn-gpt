    def mutate_gene(self, gene_name, current_value, possible_values):
        if possible_values:
            choices = list(set(possible_values) - set([current_value]))
            if choices:
                mutation_probability = self.mutation_rate * 2  # Increase mutation probability
                if random.random() < mutation_probability:
                    # Force exploration by choosing a value far from the current one
                    far_choices = [choice for choice in choices if abs(choice - current_value) > (max(possible_values) - min(possible_values)) / 2]
                    if far_choices:
                        return random.choice(far_choices)
        return current_value
