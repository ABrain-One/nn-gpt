    def combine_genes(self, gene_name, parent1_value, parent2_value, crossover_point, gene_index, total_genes):
        if gene_name == 'architecture':
            # Cross-over strategy for architecture
            if gene_index < crossover_point:
                return parent1_value[:crossover_point] + parent2_value[crossover_point:]
            else:
                return parent2_value[:crossover_point] + parent1_value[crossover_point:]
        elif gene_name in ['conv_type', 'activation']:
            # Alternate between parents' choices
            if gene_index % 2 == 0:
                return parent1_value
            else:
                return parent2_value
        else:
            # Standard single-point crossover for other parameters
            if gene_index < crossover_point:
                return parent1_value
            else:
                return parent2_value
