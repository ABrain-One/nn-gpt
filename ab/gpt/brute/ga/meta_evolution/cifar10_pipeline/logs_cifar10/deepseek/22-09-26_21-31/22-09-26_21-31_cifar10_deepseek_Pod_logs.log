def mutate_gene(self, gene_name, current_value, possible_values):
    if possible_values:
        choices = list(set(possible_values) - set([current_value]))
        if choices:
            mutation_probability = self.mutation_rate * 3  # Increase mutation probability further
            if random.random() < mutation_probability:
                if gene_name == 'n_columns' or gene_name == 'base_channels' or gene_name == 'n_blocks':
                    # Mutate to a larger value
                    return random.choice([v for v in possible_values if v > current_value])
                elif gene_name == 'dropout_prob' or gene_name == 'fc_dropout':
                    # Mutate to a higher dropout rate
                    return round(random.uniform(current_value + 0.05, 0.5), 2)
                elif gene_name == 'lr':
                    # Mutate to a lower learning rate
                    return round(random.uniform(0.001, current_value - 0.001), 5)
                elif gene_name == 'momentum':
                    # Mutate to a lower momentum value
                    return round(random.uniform(0.0, current_value - 0.1), 2)
                else:
                    return random.choice(choices)
    return current_value
