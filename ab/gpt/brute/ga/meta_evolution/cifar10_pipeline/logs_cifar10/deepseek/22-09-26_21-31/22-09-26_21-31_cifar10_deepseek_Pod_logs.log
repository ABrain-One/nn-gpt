    def combine_genes(self, gene_name, parent1_value, parent2_value, crossover_point, gene_index, total_genes):
        if gene_name == "n_columns":
            return random.choice([parent1_value, parent2_value])
        elif gene_name == "base_channels":
            return random.choice([parent1_value, parent2_value])
        elif gene_name == "n_blocks":
            return random.choice([parent1_value, parent2_value])
        elif gene_name == "dropout_prob" or gene_name == "fc_dropout":
            return (parent1_value + parent2_value) / 2
        elif gene_name == "lr":
            return random.choice([parent1_value, parent2_value])
        elif gene_name == "momentum":
            return random.choice([parent1_value, parent2_value])
        elif gene_name == "activation":
            return random.choice([parent1_value, parent2_value])
        elif gene_name == "kernel_size":
            return random.choice([parent1_value, parent2_value])
        elif gene_name == "pooling_type":
            return random.choice([parent1_value, parent2_value])
        elif gene_name == "conv_type":
            return random.choice([parent1_value, parent2_value])
        elif gene_name == "norm_type":
            return random.choice([parent1_value, parent2_value])
        elif gene_name == "optimizer_type":
            return random.choice([parent1_value, parent2_value])
        elif gene_name == "architecture":
            # Novel architecture combining elements from both parents
            combined_architecture = []
            for p1_layer, p2_layer in zip(parent1_value, parent2_value):
                combined_layer = {
                    "type": random.choice([p1_layer["type"], p2_layer["type"]]),
                    "channels": random.choice([p1_layer["channels"], p2_layer["channels"]]),
                    "kernel_size": random.choice([p1_layer["kernel_size"], p2_layer["kernel_size"]]),
                    "stride": random.choice([p1_layer["stride"], p2_layer["stride"]]),
                    "padding": random.choice([p1_layer["padding"], p2_layer["padding"]]),
                    "groups": random.choice([p1_layer["groups"], p2_layer["groups"]]),
                    "bias": random.choice([p1_layer["bias"], p2_layer["bias"]])
                }
                combined_architecture.append(combined_layer)
            return combined_architecture
        else:
            raise ValueError(f"Unknown gene name: {gene_name}")
