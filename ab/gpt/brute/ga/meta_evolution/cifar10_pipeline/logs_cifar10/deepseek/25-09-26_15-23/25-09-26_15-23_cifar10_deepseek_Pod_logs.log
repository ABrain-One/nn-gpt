    def _create_random_chromosome(self):
        chromosome = {}
        for key, values in self.search_space.items():
            if key == 'base_channels':
                base_channels = random.choice(values)
                chromosome[key] = base_channels
                n_columns = random.choice([2, 3, 4])
                base_channels_per_column = [base_channels // n_columns] * n_columns
                base_channels_per_column[-1] += base_channels % n_columns
                chromosome['base_channels_per_column'] = base_channels_per_column
            elif key == 'n_blocks':
                n_blocks = random.choice(values)
                blocks_per_column = [random.choice([1, 2, 3]) for _ in range(n_columns)]
                blocks_per_column[-1] += n_blocks - sum(blocks_per_column)
                chromosome['blocks_per_column'] = blocks_per_column
            else:
                chromosome[key] = random.choice(values)
        return chromosome
