    def combine_genes(self, gene_name, parent1_value, parent2_value, crossover_point, gene_index, total_genes):
        if gene_name == 'n_columns' or gene_name == 'n_blocks':
            # Use arithmetic mean with slight perturbation to encourage diversity
            value = int((parent1_value + parent2_value) / 2 + random.uniform(-0.25, 0.25))
            value = max(2, min(4, value))  # Clamp within search space bounds
        elif gene_name == 'base_channels' or gene_name == 'kernel_size':
            # Use geometric mean with slight perturbation
            value = int((parent1_value ** 0.5 + parent2_value ** 0.5) ** 2 + random.uniform(-0.25, 0.25))
            value = max(16, min(64, value))  # Clamp within search space bounds
        elif gene_name == 'dropout_prob' or gene_name == 'fc_dropout' or gene_name == 'lr' or gene_name == 'momentum':
            # Use harmonic mean with slight perturbation
            value = (parent1_value * parent2_value) / ((parent1_value + parent2_value) / 2 + random.uniform(-0.25, 0.25))
            value = max(0.05, min(0.5, value))  # Clamp within search space bounds
        else:
            # Simple crossover
            value = parent1_value if gene_index < crossover_point else parent2_value
        
        # Ensure the selected value is valid
        value = random.choice([v for v in self.search_space[gene_name] if v == value])
        
        return value
