def mutate_gene(self, gene_name, current_value, possible_values):
    if possible_values:
        choices = list(set(possible_values) - set([current_value]))
        if choices:
            mutation_probability = self.mutation_rate * 3  # Increase mutation probability further
            if random.random() < mutation_probability:
                new_value = random.choice(choices)
                if gene_name == 'n_columns' or gene_name == 'n_blocks':
                    new_value = max(2, min(4, new_value))
                elif gene_name == 'base_channels' or gene_name == 'kernel_size':
                    new_value = max(16, min(64, new_value))
                elif gene_name == 'dropout_prob' or gene_name == 'fc_dropout' or gene_name == 'lr' or gene_name == 'momentum':
                    new_value = max(0.05, min(0.5, new_value))
                return new_value
    return current_value
