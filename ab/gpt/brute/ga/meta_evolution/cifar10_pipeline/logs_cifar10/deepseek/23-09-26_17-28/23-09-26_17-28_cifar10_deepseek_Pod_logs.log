        elif isinstance(values[0], float):
            # Randomly choose between a narrow range and a wide range
            if random.random() < 0.5:
                chromosome[key] = random.uniform(min(values), max(values))
            else:
                chromosome[key] = random.choice(values)
        elif isinstance(values[0], str):
            # Force exploration by choosing a value that is not the most common
            most_common = max(set(values), key=values.count)
            filtered_choices = [v for v in values if v != most_common]
            if filtered_choices:
                chromosome[key] = random.choice(filtered_choices)
            else:
                chromosome[key] = random.choice(values)
        else:
            chromosome[key] = random.choice(values)
    return chromosome
