def combine_genes(self, gene_name, parent1_value, parent2_value, crossover_point, gene_index, total_genes):
    # Introduce random mutations to force exploration
    if random.random() < 0.1:
        return random.choice(self.search_space[gene_name])

    # Perform traditional crossover
    if gene_index < crossover_point:
        child_value = parent1_value
    else:
        child_value = parent2_value

    # Apply non-uniform crossover to increase diversity
    if random.random() < 0.3:
        child_value = random.choice(self.search_space[gene_name])

    # Randomly choose between parents' values with slight bias towards the first parent
    if random.random() < 0.6:
        child_value = parent1_value
    else:
        child_value = parent2_value

    # Introduce random gene swaps to further explore the search space
    if random.random() < 0.05:
        swap_genes = ['n_columns', 'base_channels', 'n_blocks', 'kernel_size', 'activation', 'conv_type', 'norm_type']
        if gene_name in swap_genes:
            swap_index = random.choice(swap_genes.index(gene_name))
            other_gene = random.choice(swap_genes)
            child_value = parent1_chromo.get(other_gene, parent2_chromo.get(other_gene))

    return child_value
