def mutate_gene(self, gene_name, current_value, possible_values):
    if possible_values:
        choices = list(set(possible_values) - set([current_value]))
        if choices:
            mutation_probability = self.mutation_rate * 3  # Increase mutation probability further
            if random.random() < mutation_probability:
                # Randomly choose a different architecture-related parameter to mutate
                mutation_target = random.choice(['n_columns', 'base_channels', 'n_blocks', 'kernel_size', 'activation', 'conv_type', 'norm_type'])
                if mutation_target == 'n_columns':
                    return random.choice([2, 3, 4])
                elif mutation_target == 'base_channels':
                    return random.choice([16, 32, 64])
                elif mutation_target == 'n_blocks':
                    return random.choice([2, 3, 4])
                elif mutation_target == 'kernel_size':
                    return random.choice([1, 3, 5, 7])
                elif mutation_target == 'activation':
                    return random.choice(['ReLU', 'GELU', 'LeakyReLU', 'SiLU'])
                elif mutation_target == 'conv_type':
                    return random.choice(['Standard', 'Depthwise'])
                elif mutation_target == 'norm_type':
                    return random.choice(['BatchNorm', 'InstanceNorm'])
    return current_value
