### combine_genes ###
    def combine_genes(self, gene_name, parent1_value, parent2_value, crossover_point, gene_index, total_genes):
        if gene_index < crossover_point:
            # Simple crossover
            return parent1_value
        else:
            # More complex crossover to introduce diversity
            if gene_name == 'activation':
                # Cycle crossover for activation functions
                activations = ['ReLU', 'GELU', 'LeakyReLU', 'SiLU']
                index1 = activations.index(parent1_value)
                index2 = activations.index(parent2_value)
                if index1 >= index2:
                    return activations[(index1 + 1) % len(activations)]
                else:
                    return activations[(index2 + 1) % len(activations)]
            elif gene_name == 'pooling_type':
                # Bit-flip crossover for pooling types
                if parent1_value == 'Max':
                    return 'Avg'
                else:
                    return 'Max'
            elif gene_name == 'conv_type':
                # Bit-flip crossover for convolution types
                if parent1_value == 'Standard':
                    return 'Depthwise'
                else:
                    return 'Standard'
            elif gene_name == 'norm_type':
                # Bit-flip crossover for normalization types
                if parent1_value == 'BatchNorm':
                    return 'InstanceNorm'
                else:
                    return 'BatchNorm'
            elif gene_name == 'optimizer_type':
                # Bit-flip crossover for optimizer types
                optimizers = ['SGD', 'AdamW', 'RMSprop']
                index1 = optimizers.index(parent1_value)
                index2 = optimizers.index(parent2_value)
                if index1 >= index2:
                    return optimizers[(index1 + 1) % len(optimizers)]
                else:
                    return optimizers[(index2 + 1) % len(optimizers)]
            else:
                # Use simple crossover for other parameters
                return parent2_value

