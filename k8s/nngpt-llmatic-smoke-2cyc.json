{
  "apiVersion": "batch/v1",
  "kind": "Job",
  "metadata": {
    "name": "nngpt-llmatic-smoke-2cyc",
    "namespace": "b-s-mulukuledu"
  },
  "spec": {
    "parallelism": 1,
    "backoffLimit": 0,
    "ttlSecondsAfterFinished": 86400,
    "template": {
      "spec": {
        "restartPolicy": "Never",
        "tolerations": [
          {
            "key": "dgx",
            "operator": "Equal",
            "value": "access"
          }
        ],
        "containers": [
          {
            "name": "ml",
            "image": "ws.ab/shared/ai-linux-nngpt:v1",
            "imagePullPolicy": "Always",
            "command": [
              "/bin/bash",
              "-c"
            ],
            "args": [
              "export PYTHONPATH=/a/mm/patches:/a/mm\nexport NNGPT_DB_LOCAL=1\nexport NNGPT_OUT_ROOT=/a/mm/out/smoke_llmatic_pr\nexport NNGPT_DIR_OVERRIDE=/a/mm/out/smoke_llmatic_pr/nngpt\npython3 -u /a/mm/run.py ab.gpt.act.tune.Tune --llm_conf ds_coder_7b_instruct.json --run_iterative_pipeline --cycles 2 --models_per_cycle 10 --nn_prefixes ga- --llmatic --llmatic_crossover_every 3 --num_train_epochs 1\n"
            ],
            "securityContext": {
              "allowPrivilegeEscalation": false,
              "runAsUser": 1025,
              "runAsGroup": 1376
            },
            "volumeMounts": [
              {
                "mountPath": "/dev/shm",
                "name": "shm"
              },
              {
                "mountPath": "/a/mm",
                "name": "v0"
              }
            ],
            "resources": {
              "requests": {
                "cpu": 2,
                "memory": "16Gi"
              },
              "limits": {
                "nvidia.com/gpu": 1,
                "cpu": 16,
                "memory": "60Gi"
              }
            }
          }
        ],
        "volumes": [
          {
            "name": "shm",
            "emptyDir": {
              "medium": "Memory",
              "sizeLimit": "16Gi"
            }
          },
          {
            "name": "v0",
            "hostPath": {
              "path": "/shared/ssd/home/b-s-mulukuledu/exp",
              "type": "DirectoryOrCreate"
            }
          }
        ]
      }
    }
  }
}
